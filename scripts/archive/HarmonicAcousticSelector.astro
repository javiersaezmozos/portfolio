---
interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;

const partials = [
  {
    partial: 2,
    volume: 1,
    metal: 'copper',
    hex: '#E89758',
    baseMidi: 46, // Bb2
    baseFreq440: 116.54,
    vowel: 'Oh / Ah',
    centsInfo: '0 cents · Base estable',
    notesByPos: ['Sib₂', 'La₂', 'Lab₂', 'Sol₂', 'Solb₂', 'Fa₂', 'Mi₂'],
    pedagogyEs: 'Sonido amplio, garganta abierta («El bostezo») y embocadura centrada sin rigidez en las comisuras.',
    pedagogyEn: 'Broad tone, open throat ("The yawn") and centered embouchure without corner tension.',
  },
  {
    partial: 3,
    volume: 1,
    metal: 'copper',
    hex: '#E89758',
    baseMidi: 53, // F3
    baseFreq440: 174.61,
    vowel: 'Ah',
    centsInfo: '+2 cents · Quinta justa pura',
    notesByPos: ['Fa₃', 'Mi₃', 'Mib₃', 'Re₃', 'Reb₃', 'Do₃', 'Si₂'],
    pedagogyEs: 'Primer salto de flexibilidad. Mantén la columna de aire continua sin cortar con la lengua al subir desde el 2.º parcial.',
    pedagogyEn: 'First flexibility interval. Keep a continuous air column without tongue interruption when slurring from the 2nd partial.',
  },
  {
    partial: 4,
    volume: 1,
    metal: 'copper',
    hex: '#E89758',
    baseMidi: 58, // Bb3
    baseFreq440: 233.08,
    vowel: 'Ah → Eh',
    centsInfo: '0 cents · Octava de referencia',
    notesByPos: ['Sib₃', 'La₃', 'Lab₃', 'Sol₃', 'Solb₃', 'Fa₃', 'Mi₃'],
    pedagogyEs: 'Eje del Nivel 1. El paso de Ah a Eh eleva suavemente el dorso de la lengua, acelerando el aire por efecto Venturi.',
    pedagogyEn: 'Core of Level 1. Shifting from Ah to Eh gently raises the tongue arch, accelerating the air stream via the Venturi effect.',
  },
  {
    partial: 5,
    volume: 1,
    metal: 'copper',
    hex: '#E89758',
    baseMidi: 62, // D4
    baseFreq440: 293.66,
    vowel: 'Eh',
    centsInfo: '−14 cents (Serie armónica natural)',
    notesByPos: ['Re₄', 'Do♯₄', 'Do₄', 'Si₃', 'Sib₃', 'La₃', 'Lab₃'],
    pedagogyEs: 'Techo del Nivel 2. Acústicamente el 5.º parcial natural queda bajo (−14 cents); requiere oído activo y ligero ajuste de vara.',
    pedagogyEn: 'Ceiling of Level 2. Acoustically the natural 5th partial sits flat (−14 cents); requires active ear and slight slide adjustment.',
  },
  {
    partial: 6,
    volume: 1,
    metal: 'copper',
    hex: '#E89758',
    baseMidi: 65, // F4
    baseFreq440: 349.23,
    vowel: 'Ee',
    centsInfo: '+2 cents (Teórico) · Vigilar tendencia alta',
    notesByPos: ['Fa₄', 'Mi₄', 'Mib₄', 'Re₄', 'Reb₄', 'Do₄', 'Si₃'],
    pedagogyEs: 'Techo del Volumen 1 (Nivel 3). Cero presión contra la boquilla: pronuncia «Ee» interiormente y proyecta aire rápido y focalizado.',
    pedagogyEn: 'Volume 1 Ceiling (Level 3). Zero mouthpiece pressure: shape an inner "Ee" vowel and project a fast, focused air column.',
  },
  {
    partial: 8,
    volume: 2,
    metal: 'silver',
    hex: '#F1F2F4',
    baseMidi: 70, // Bb4
    baseFreq440: 466.16,
    vowel: 'Ee+',
    centsInfo: '0 cents · Registro Intermedio (Vol. 2)',
    notesByPos: ['Sib₄', 'La₄', 'Lab₄', 'Sol₄', 'Solb₄', 'Fa₄', 'Mi₄'],
    pedagogyEs: 'Volumen 2 (Plata): agilidad en semicorcheas, intervalos quebrados y consolidación del registro agudo con brillo tímbrico.',
    pedagogyEn: 'Volume 2 (Silver): sixteenth-note agility, broken intervals, and bright upper-register consolidation.',
  },
  {
    partial: 12,
    volume: 2,
    metal: 'silver',
    hex: '#F1F2F4',
    baseMidi: 82, // Bb5
    baseFreq440: 932.33,
    vowel: 'Ee (Focal)',
    centsInfo: 'Techo del Volumen 2 · Hasta Sib₅',
    notesByPos: ['Sib₅', 'La₅', 'Lab₅', 'Sol₅', 'Solb₅', 'Fa₅', 'Mi₅'],
    pedagogyEs: 'Frontera del Volumen 2 Intermedio. Dominio muscular elástico y control micro-milimétrico de la abertura labial.',
    pedagogyEn: 'Volume 2 Intermediate boundary. Elastic muscular mastery and micro-millimetric aperture control.',
  },
  {
    partial: 16,
    volume: 3,
    metal: 'gold',
    hex: '#F9D658',
    baseMidi: 89, // F6
    baseFreq440: 1396.91,
    vowel: 'Í (Láser)',
    centsInfo: 'Techo del Volumen 3 · Hasta Fa₆',
    notesByPos: ['Fa₆', 'Mi₆', 'Mib₆', 'Re₆', 'Reb₆', 'Do₆', 'Si₅'],
    pedagogyEs: 'Volumen 3 (Oro Regio): virtuosismo solista y registro sobreagudo de concierto con máxima eficiencia acústica.',
    pedagogyEn: 'Volume 3 (Regal Gold): solo virtuosity and concert extreme high register with maximum acoustic efficiency.',
  },
];

const slidePositions = [
  { pos: 1, fund: 'Sib', semitones: 0 },
  { pos: 2, fund: 'La', semitones: -1 },
  { pos: 3, fund: 'Lab', semitones: -2 },
  { pos: 4, fund: 'Sol', semitones: -3 },
  { pos: 5, fund: 'Solb', semitones: -4 },
  { pos: 6, fund: 'Fa', semitones: -5 },
  { pos: 7, fund: 'Mi', semitones: -6 },
];
---

<section
  class="harmonic-acoustic-lab relative w-full py-12"
  data-harmonic-root
  data-locale={locale}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="rounded-2xl bg-graphite-surface/95 border border-graphite-border p-6 sm:p-8 shadow-2xl">
      
      <!-- CABECERA DEL LABORATORIO ACÚSTICO -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-white/10 pb-6">
        <div>
          <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-copper">
            <span class="h-2 w-2 rounded-full bg-copper"></span>
            {locale === 'es' ? 'Laboratorio Acústico Interactivo · Web Audio API' : 'Interactive Acoustic Lab · Web Audio API'}
          </span>
          <h2 class="mt-2 font-serif text-2xl sm:text-3xl font-bold text-white">
            {locale === 'es'
              ? 'La Serie Armónica de la Trilogía (Sib₂ → Fa₆)'
              : 'The Trilogy Harmonic Series (B♭₂ → F₆)'}
          </h2>
          <p class="mt-1.5 max-w-2xl text-sm text-slate-300">
            {locale === 'es'
              ? 'Pulsa cualquier parcial armónico para escuchar su altura real sintetizada con timbre de metal cálido y observa cómo la posición de vara y las vocales interiores (Ah, Eh, Ee) gobiernan la flexibilidad.'
              : 'Click any harmonic partial to hear its real pitch synthesized with warm brass timbre and observe how slide position and inner vowels (Ah, Eh, Ee) govern flexibility.'}
          </p>
        </div>

        <!-- Controles Globales de Audio: Arpegio Ligado, Afinación 440/442 Hz y Silencio -->
        <div class="flex flex-wrap items-center gap-2.5">
          <button
            type="button"
            data-play-slur-btn
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-copper px-4 py-2.5 text-xs font-bold text-dark-950 shadow-metal-copper transition-transform hover:scale-[1.02] active:scale-95 focus:outline-none focus:ring-2 focus:ring-gold-400"
            style="translate: 0px; rotate: 0deg; scale: 1;"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <span data-slur-btn-text>
              {locale === 'es' ? 'Tocar Ligado Vol. 1 (Ah → Ee)' : 'Play Vol. 1 Lip Slur (Ah → Ee)'}
            </span>
          </button>

          <button
            type="button"
            data-pitch-standard-btn
            aria-pressed="true"
            class="rounded-xl bg-graphite-deep border border-graphite-border px-3 py-2.5 text-xs font-mono text-slate-200 hover:border-copper/50 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
          >
            La₄ = <span data-pitch-hz>442</span> Hz
          </button>

          <button
            type="button"
            data-mute-btn
            aria-pressed="false"
            class="rounded-xl bg-graphite-deep border border-graphite-border px-3 py-2.5 text-xs font-medium text-slate-300 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
          >
            <span data-mute-label>{locale === 'es' ? 'Audio Activo' : 'Audio On'}</span>
          </button>
        </div>
      </div>

      <!-- SELECTOR DE LAS 7 POSICIONES DE VARA + TROMBÓN VECTORIAL ANIMADO -->
      <div class="mt-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center bg-graphite-deep/90 rounded-xl p-4 border border-white/5">
        <div class="lg:col-span-5">
          <p id="slide-pos-group-label" class="text-xs font-mono uppercase tracking-wider text-slate-400 mb-2">
            {locale === 'es' ? 'Posición de la Vara Corredera (1.ª a 7.ª):' : 'Trombone Slide Position (1st to 7th):'}
          </p>
          <div
            role="group"
            aria-labelledby="slide-pos-group-label"
            class="grid grid-cols-7 gap-1.5"
          >
            {slidePositions.map((sp) => (
              <button
                type="button"
                data-slide-pos-btn={sp.pos}
                data-semitones={sp.semitones}
                data-fund={sp.fund}
                aria-pressed={sp.pos === 1 ? 'true' : 'false'}
                class={`slide-pos-btn flex flex-col items-center justify-center rounded-lg py-2 px-1 border text-xs transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400 ${
                  sp.pos === 1
                    ? 'border-copper bg-copper/20 text-white font-bold'
                    : 'border-graphite-border bg-graphite-surface/60 text-slate-300 hover:bg-graphite-surface'
