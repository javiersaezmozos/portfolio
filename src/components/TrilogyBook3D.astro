---
import type { SupportedLocale } from '../utils/i18n-routes';

interface Props {
  initialVolume?: 1 | 2;
  locale?: SupportedLocale;
  showControls?: boolean;
}

const {
  initialVolume = 1,
  locale = 'es',
  showControls = true,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const volumes = [
  {
    id: 1,
    code: 'copper',
    badge: {
      es: 'VOLUMEN 1 · ELEMENTAL',
      en: 'VOLUME 1 · ELEMENTARY',
      de: 'BAND 1 · ELEMENTARSTUFE',
      it: 'VOLUME 1 · ELEMENTARE',
    },
    subtitle: {
      es: 'Desarrollo de la flexibilidad labial hasta Fa₄',
      en: 'Lip flexibility development up to F₄',
      de: 'Entwicklung der Lippenflexibilität bis F₄',
      it: 'Sviluppo della flessibilità labiale fino a Fa₄',
    },
    course: {
      es: '2.º a 4.º EE.EE. · 12 Lecciones + Estudios',
      en: 'Elementary Grade · 12 Lessons + Etudes',
      de: 'Elementarstufe · 12 Lektionen + Etüden',
      it: 'Corsi Elementari · 12 Lezioni + Studi',
    },
    spineLabel: 'FLEXIBILIDAD · TROMBÓN 1 · JAVIER SÁEZ MOZOS',
    metalName: {
      es: 'Serie Cobre',
      en: 'Copper Series',
      de: 'Kupfer-Serie',
      it: 'Serie Rame',
    },
    hexPrimary: '#E89758',
    hexSecondary: '#D98A5B',
    hexShadow: '#9E472A',
    status: {
      es: 'Edición Activa · Lanzamiento',
      en: 'Active Edition · Available',
      de: 'Aktive Ausgabe · Erhältlich',
      it: 'Edizione Attiva · Disponibile',
    },
  },
  {
    id: 2,
    code: 'silver',
    badge: {
      es: 'VOLUMEN 2 · INTERMEDIO',
      en: 'VOLUME 2 · INTERMEDIATE',
      de: 'BAND 2 · MITTELSTUFE',
      it: 'VOLUME 2 · INTERMEDIO',
    },
    subtitle: {
      es: 'Desarrollo de la flexibilidad labial hasta Sib₅',
      en: 'Lip flexibility development up to B♭₅',
      de: 'Entwicklung der Lippenflexibilität bis B♭₅',
      it: 'Sviluppo della flessibilità labiale fino a Sib₅',
    },
    course: {
      es: 'Enseñanzas Profesionales · Agilidad y Semicorcheas',
      en: 'Intermediate Grade · Agility & Sixteenth Notes',
      de: 'Mittelstufe · Geläufigkeit & Sechzehntel',
      it: 'Corsi Professionali · Agilità e Sedicesimi',
    },
    spineLabel: 'FLEXIBILIDAD · TROMBÓN 2 · JAVIER SÁEZ MOZOS',
    metalName: {
      es: 'Serie Plata',
      en: 'Silver Series',
      de: 'Silber-Serie',
      it: 'Serie Argento',
    },
    hexPrimary: '#F1F2F4',
    hexSecondary: '#D6DBDF',
    hexShadow: '#8E959D',
    status: {
      es: 'En preparación · Reserva de aviso',
      en: 'In preparation · Waitlist open',
      de: 'In Vorbereitung · Vormerkung möglich',
      it: 'In preparazione · Lista d\'attesa',
    },
  },
];

const initialVolData = volumes.find((v) => v.id === initialVolume) || volumes[0];

const coverFootMap: Record<SupportedLocale, string> = {
  es: 'COLECCIÓN METODOLOGÍA DE FLEXIBILIDAD · QR + TromBot',
  en: 'FLEXIBILITY METHODOLOGY COLLECTION · QR + TromBot',
  de: 'KOLLEKTION FLEXIBILITÄTSMETHODIK · QR + TromBot',
  it: 'COLLEZIONE METODOLOGIA DI FLESSIBILITÀ · QR + TromBot',
};

const rightHeaderMap: Record<SupportedLocale, { eyebrow: string; title: string; desc: string }> = {
  es: {
    eyebrow: 'Vista previa 3D · Ediciones',
    title: 'Método de Flexibilidad · Volúmenes 1 y 2',
    desc: 'Selecciona cada volumen para inspeccionar su acabado visual y comprobar el lomo de la edición impresa en Amazon KDP o la lectura en atril y Amazon Kindle.',
  },
  en: {
    eyebrow: '3D Preview · Editions',
    title: 'Flexibility Method · Volumes 1 & 2',
    desc: 'Select each volume to inspect its visual finish and check the Amazon KDP paperback spine or music-stand and Amazon Kindle reading.',
  },
  de: {
    eyebrow: '3D-Vorschau · Ausgaben',
    title: 'Flexibilitätsmethode · Bände 1 & 2',
    desc: 'Wählen Sie einen Band aus, um das visuelle Design zu begutachten und den Buchrücken der Amazon KDP-Ausgabe sowie die Lesbarkeit auf dem Notenständer und Kindle zu prüfen.',
  },
  it: {
    eyebrow: 'Anteprima 3D · Edizioni',
    title: 'Metodo di Flessibilità · Volumi 1 e 2',
    desc: 'Seleziona ciascun volume per ispezionare il design e verificare il dorso dell\'edizione cartacea Amazon KDP o la lettura sul leggio e su Kindle.',
  },
};

const volSelectLabelMap: Record<SupportedLocale, string> = {
  es: '1. Seleccionar Volumen del Método:',
  en: '1. Select Method Volume:',
  de: '1. Band der Methode auswählen:',
  it: '1. Seleziona il Volume del Metodo:',
};

const rangeVol1Map: Record<SupportedLocale, string> = {
  es: 'Hasta Fa₄',
  en: 'Up to F₄',
  de: 'Bis F₄',
  it: 'Fino a Fa₄',
};

const rangeVol2Map: Record<SupportedLocale, string> = {
  es: 'Hasta Sib₅',
  en: 'Up to B♭₅',
  de: 'Bis B♭₅',
  it: 'Fino a Sib₅',
};

const panelLabelsMap: Record<SupportedLocale, { targetRange: string; recStage: string }> = {
  es: { targetRange: 'Tesitura objetivo', recStage: 'Etapa recomendada' },
  en: { targetRange: 'Target Range', recStage: 'Recommended Stage' },
  de: { targetRange: 'Ziel-Tonumfang', recStage: 'Empfohlene Stufe' },
  it: { targetRange: 'Estensione obiettivo', recStage: 'Livello consigliato' },
};

const bindingSectionMap: Record<SupportedLocale, {
  label: string;
  kdpTitle: string;
  kdpDesc: string;
  kindleTitle: string;
  kindleDesc: string;
}> = {
  es: {
    label: '2. Simulador de Edición y Atril:',
    kdpTitle: 'Amazon KDP (Tapa Blanda)',
    kdpDesc: 'Edición impresa oficial con lomo de colección.',
    kindleTitle: 'Amazon Kindle / Lectura en atril',
    kindleDesc: 'Edición digital de diseño fijo y margen interior para lectura limpia en atril.',
  },
  en: {
    label: '2. Edition & Music-Stand Simulator:',
    kdpTitle: 'Amazon KDP (Paperback)',
    kdpDesc: 'Official print edition with signature collection spine.',
    kindleTitle: 'Amazon Kindle / Music-stand reading',
    kindleDesc: 'Fixed-layout digital edition & inner reserve for clean music-stand reading.',
  },
  de: {
    label: '2. Ausgaben- und Notenständer-Simulator:',
    kdpTitle: 'Amazon KDP (Taschenbuch)',
    kdpDesc: 'Offizielle Druckausgabe mit Sammlungsrücken.',
    kindleTitle: 'Amazon Kindle / Notenständer',
    kindleDesc: 'Digitale Ausgabe mit festem Layout und breitem Innenrand für optimale Lesbarkeit.',
  },
  it: {
    label: '2. Simulatore di Edizione e Leggio:',
    kdpTitle: 'Amazon KDP (Copertina Flessibile)',
    kdpDesc: 'Edizione cartacea ufficiale con dorso da collezione.',
    kindleTitle: 'Amazon Kindle / Lettura sul leggio',
    kindleDesc: 'Edizione digitale a layout fisso con ampio margine interno per una lettura chiara sul leggio.',
  },
};

const rightContent = rightHeaderMap[locale] || rightHeaderMap.es;
const panelLabels = panelLabelsMap[locale] || panelLabelsMap.es;
const bindingContent = bindingSectionMap[locale] || bindingSectionMap.es;
---

<section
  class="trilogy-book-showcase relative w-full py-8 select-none"
  data-book-3d-root
  data-initial-volume={initialVolume}
  data-locale={locale}
  style={`--active-metal: ${initialVolData.hexPrimary}; --active-metal-secondary: ${initialVolData.hexSecondary}; --active-metal-shadow: ${initialVolData.hexShadow}; --pointer-x: 0.5; --pointer-y: 0.35; --sheen-pos: 50%;`}
>
  <!-- Luz volumétrica de auditorio reactiva al volumen activo -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center overflow-hidden"
    aria-hidden="true"
  >
    <div
      data-book-aura
      class="h-[420px] w-[420px] rounded-full opacity-25 blur-[110px] transition-colors duration-700"
      style={`background: radial-gradient(circle, ${initialVolData.hexPrimary} 0%, transparent 70%);`}
    ></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- COLUMNA IZQUIERDA: Escenario 3D Interactivo -->
      <div class="lg:col-span-7 flex flex-col items-center justify-center">
        
        <!-- Escena con perspectiva física de 1400px -->
        <div
          class="book-stage relative flex items-center justify-center py-6 px-4 sm:px-10 cursor-grab active:cursor-grabbing"
          data-book-stage
        >
          <!-- Sombra de contacto sobre el suelo del escenario -->
          <div
            class="book-floor-shadow pointer-events-none absolute bottom-2 h-8 w-64 sm:w-72 rounded-full bg-black/80 blur-xl transition-transform duration-300"
            aria-hidden="true"
          ></div>

          <!-- Cuerpo 3D del Libro (US Letter proporción 215.9 x 279.4 mm -> ~1 : 1.294) -->
          <div
            class="book-3d-object relative w-[270px] h-[350px] sm:w-[320px] sm:h-[414px]"
            data-book-object
            data-binding="kdp"
            data-metal={initialVolData.code}
          >
            <!-- 1. CUBIERTA FRONTAL (Cara Z+) -->
            <div class="book-face book-front rounded-r-[4px] overflow-hidden bg-graphite-base border border-white/15">
              
              <!-- Textura analógica de grano de imprenta -->
              <div class="book-grain pointer-events-none absolute inset-0 z-20 opacity-[0.04] mix-blend-overlay" aria-hidden="true"></div>

              <!-- Haz de luz especular dinámico (Foil Sheen) -->
              <div
                class="book-specular-sheen pointer-events-none absolute inset-0 z-30 opacity-0 transition-opacity duration-300"
                data-book-sheen
                aria-hidden="true"
              ></div>

              <!-- Hendidura de bisagra de encuadernación KDP (a 10mm del lomo) -->
              <div
                data-kdp-crease
                class="pointer-events-none absolute inset-y-0 left-[11px] z-25 w-[2px] bg-gradient-to-r from-black/60 via-white/10 to-transparent"
                aria-hidden="true"
              ></div>

              <!-- Perforaciones y anillas Wire-O (visibles en modo Espiral España) -->
              <div
                data-spiral-rings
                class="pointer-events-none absolute inset-y-3 left-0 z-40 hidden w-5 flex-col justify-between py-1"
                aria-hidden="true"
              >
                {Array.from({ length: 18 }).map(() => (
                  <div class="relative flex items-center">
                    <span class=" -ml-2.5 h-[6px] w-5 rounded-full bg-gradient-to-b from-slate-200 via-slate-400 to-slate-800 shadow-md border border-white/30"></span>
                    <span class="h-[5px] w-[5px] rounded-full bg-black/90 border border-white/20"></span>
                  </div>
                ))}
              </div>

              <!-- Portada definitiva real del Volumen 1 -->
              <img
                data-vol1-front-img
                src={`${base}/images/metodos/vol1-portada.jpg`}
                alt="Portada oficial de Flexibilidad, Método de Trombón Volumen 1 Elemental"
                class={`pointer-events-none absolute inset-0 h-full w-full object-cover z-30 ${initialVolume === 1 ? '' : 'hidden'}`}
                loading="eager"
                decoding="async"
              />

              <!-- Ilustración canónica de fondo: Estudiante + TromBot -->
              <div class="relative h-full w-full flex flex-col justify-between p-5 sm:p-6 z-10">
                <img
                  src={`${base}/images/metodos/portada-duo-trombot.jpg`}
                  alt="Cubierta oficial de Trombón Flexibilidad: estudiante de trombón junto al asistente pedagógico TromBot IA"
                  class="pointer-events-none absolute inset-0 h-full w-full object-cover object-bottom brightness-95 contrast-105"
                  loading="eager"
                  decoding="async"
                />

                <!-- Gradiente superior e inferior para garantizar contraste editorial de la tipografía metálica -->
                <div
                  class="pointer-events-none absolute inset-x-0 top-0 h-52 bg-gradient-to-b from-[#08090B] via-[#08090B]/92 to-transparent"
                  aria-hidden="true"
                ></div>
                <div
                  class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#08090B]/90 to-transparent"
                  aria-hidden="true"
                ></div>

                <!-- Marco de filete fino metálico interior -->
                <div
                  data-metal-frame
                  class="pointer-events-none absolute inset-2.5 rounded-[2px] border opacity-35 transition-colors duration-500"
                  style={`border-color: ${initialVolData.hexPrimary};`}
                  aria-hidden="true"
                ></div>

                <!-- BLOQUE SUPERIOR -->
                <div class="relative z-20 text-center pt-1">
                  <p class="font-serif text-[10.5px] sm:text-xs font-medium tracking-[0.12em] text-white/95 mb-1.5">
                    Javier Sáez Mozos
                  </p>

                  <!-- Título principal con efecto Foil Metálico 3 paradas + Brillo Especular -->
                  <p
                    data-book-main-title
                    class="book-metallic-title font-serif text-2xl sm:text-[27px] font-bold tracking-[0.18em] uppercase leading-tight drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)]"
                    data-metal-variant={initialVolData.code}
                  >
                    FLEXIBILIDAD
                  </p>

                  <p class="mt-0.5 font-serif text-[9px] sm:text-[10px] font-semibold tracking-[0.28em] text-slate-100 uppercase">
                    {locale === 'es' ? 'MÉTODO DE TROMBÓN' : locale === 'de' ? 'POSAUNENMETHODE' : locale === 'it' ? 'METODO PER TROMBONE' : 'TROMBONE METHOD'}
                  </p>

                  <!-- Cartela de Volumen y Nivel -->
                  <div class="mt-2 flex items-center justify-center">
                    <span
                      data-book-badge
                      class="inline-block font-serif text-[10px] sm:text-[11px] font-bold tracking-[0.2em] uppercase transition-colors duration-500"
                      style={`color: ${initialVolData.hexPrimary};`}
                    >
                      {initialVolData.badge[locale] || initialVolData.badge.es}
                    </span>
                  </div>

                  <!-- Descriptor curricular de tesitura -->
                  <p
                    data-book-subtitle
                    class="mt-1 font-serif italic text-[9px] sm:text-[10px] text-slate-200 tracking-wide transition-colors duration-500"
                  >
                    {initialVolData.subtitle[locale] || initialVolData.subtitle.es}
                  </p>
                </div>

                <!-- PIE DISCRETO SOBRE EL ESCENARIO DE PORTADA -->
                <div class="relative z-20 text-center pb-0.5">
                  <span class="inline-block rounded-full border border-white/15 bg-black/55 px-2.5 py-0.5 font-sans text-[8px] uppercase tracking-[0.18em] text-slate-300/90 backdrop-blur-sm">
                    {coverFootMap[locale] || coverFootMap.es}
                  </span>
                </div>
              </div>
            </div>

            <!-- 2. LOMO FÍSICO (Cara X-) -->
            <div
              class="book-face book-spine flex flex-col items-center justify-between py-4 bg-[#141518] border-y border-l border-white/15"
              aria-hidden="true"
            >
              <!-- Pastilla geométrica metálica superior -->
              <div
                data-spine-pill
                class="w-2.5 h-6 rounded-[1px] shadow-sm transition-colors duration-500"
                style={`background: linear-gradient(180deg, ${initialVolData.hexShadow} 0%, ${initialVolData.hexPrimary} 50%, ${initialVolData.hexSecondary} 100%);`}
              ></div>

              <!-- Texto vertical del lomo girado 90° -->
              <div class="book-spine-text font-sans text-[7.5px] font-medium tracking-[0.2em] text-slate-200/90 uppercase whitespace-nowrap">
                <span data-spine-label>{initialVolData.spineLabel}</span>
              </div>

              <!-- Sello editorial inferior -->
              <div class="text-[7px] font-serif font-bold text-slate-400 tracking-widest">
                JSM
              </div>
            </div>

            <!-- 3. CORTE DERECHO DE HOJAS -->
            <div class="book-face book-pages-right" aria-hidden="true"></div>

            <!-- 4. CORTE SUPERIOR E INFERIOR DE HOJAS -->
            <div class="book-face book-pages-top" aria-hidden="true"></div>
            <div class="book-face book-pages-bottom" aria-hidden="true"></div>

            <!-- 5. CONTRACUBIERTA (Cara Z-) -->
            <div
              class="book-face book-back rounded-l-[4px] bg-[#0B0C0E] border border-white/10 p-5 flex flex-col justify-between overflow-hidden"
              aria-hidden="true"
            >
              <!-- Contraportada definitiva real del Volumen 1 -->
              <img
                data-vol1-back-img
                src={`${base}/images/metodos/vol1-contraportada.jpg`}
                alt="Contraportada oficial de Flexibilidad, Método de Trombón Volumen 1 Elemental"
                class={`pointer-events-none absolute inset-0 h-full w-full object-cover z-30 ${initialVolume === 1 ? '' : 'hidden'}`}
                loading="lazy"
                decoding="async"
              />
              <div class="text-center border-b border-white/10 pb-2.5">
                <p class="font-serif text-sm font-bold tracking-[0.18em] text-gold-400 uppercase">
                  FLEXIBILIDAD
                </p>
                <p class="mt-0.5 font-serif text-[7.5px] tracking-[0.2em] text-white uppercase">
                  {locale === 'es' ? 'MÉTODO DE TROMBÓN · VOLUMEN 1 (ELEMENTAL)' : locale === 'de' ? 'POSAUNENMETHODE · BAND 1 (ELEMENTARSTUFE)' : locale === 'it' ? 'METODO PER TROMBONE · VOLUME 1 (ELEMENTARE)' : 'TROMBONE METHOD · VOLUME 1 (ELEMENTARY)'}
                </p>
                <p class="mt-1 font-serif text-[8px] text-gold-300 leading-snug">
                  {locale === 'es'
                    ? 'La guía estructurada para iniciar y desarrollar tu flexibilidad labial hasta Fa₄'
                    : locale === 'de'
                      ? 'Der strukturierte Leitfaden für Ihre Lippenflexibilität bis F₄'
                      : locale === 'it'
                        ? 'La guida strutturata per iniziare e sviluppare la flessibilità labiale fino a Fa₄'
                        : 'The structured guide to build and develop your lip flexibility up to F₄'}
                </p>
              </div>

              <div class="space-y-2 my-auto py-2 text-[8.2px] leading-relaxed text-slate-200 font-serif">
                <p>
                  {locale === 'es'
                    ? 'Moverse ágilmente entre armónicos sin forzar la embocadura es posible cuando el aire se convierte en el motor y los labios responden con elasticidad.'
                    : locale === 'de'
                      ? 'Fließende Übergänge zwischen Naturtönen ohne Verkrampfung gelingen, wenn die Luftsäule die Führung übernimmt und die Lippen elastisch reagieren.'
                      : locale === 'it'
                        ? 'Muoversi fluidamente tra gli armonici senza forzare l\'imboccatura è naturale quando l\'aria diventa il motore e le labbra rispondono con elasticità.'
                        : 'Moving fluidly across harmonics without forcing the embouchure becomes natural when airflow drives the sound and the lips respond with elasticity.'}
                </p>
                <ul class="space-y-1 text-[7.8px] text-slate-300 font-sans">
                  <li>
                    <span class="text-gold-400">✦</span>{' '}
                    <strong class="text-white">{locale === 'es' ? 'Grabaciones y práctica interactiva:' : locale === 'de' ? 'Aufnahmen & Üben:' : locale === 'it' ? 'Registrazioni e pratica:' : 'Recordings & practice:'}</strong>{' '}
                    {locale === 'es' ? '15 códigos QR con videopartituras.' : locale === 'de' ? '15 QR-Codes mit Videopartituren.' : locale === 'it' ? '15 codici QR con videopartiture.' : '15 QR codes linking to video scores.'}
                  </li>
                  <li>
                    <span class="text-gold-400">✦</span>{' '}
                    <strong class="text-white">{locale === 'es' ? 'Progresión Curricular en 3 Niveles:' : locale === 'de' ? '3-Stufen-Lehrplan:' : locale === 'it' ? 'Curriculum in 3 Livelli:' : '3-Level Curriculum:'}</strong>{' '}
                    {locale === 'es' ? 'Sib₂–Fa₃–Sib₃ · +Re₄ · +Fa₄.' : locale === 'de' ? 'B♭₂–F₃–B♭₃ · +D₄ · +F₄.' : locale === 'it' ? 'Sib₂–Fa₃–Sib₃ · +Re₄ · +Fa₄.' : 'Bb₂–F₃–Bb₃ · +D₄ · +F₄.'}
                  </li>
                  <li>
                    <span class="text-gold-400">✦</span>{' '}
                    <strong class="text-white">{locale === 'es' ? 'Asistente pedagógico TromBot:' : locale === 'de' ? 'Pädagogischer Assistent TromBot:' : locale === 'it' ? 'Assistente TromBot:' : 'TromBot Pedagogue:'}</strong>{' '}
                    {locale === 'es' ? 'Pautas visuales para el estudio en casa.' : locale === 'de' ? 'Visuelle Leitlinien für das Heimstudium.' : locale === 'it' ? 'Linee guida visive per lo studio.' : 'Visual guidance for home practice.'}
                  </li>
                </ul>
              </div>

              <div class="flex items-end justify-between border-t border-white/10 pt-2">
                <div class="text-[7px] font-mono text-slate-400 space-y-0.5">
                  <p>AMAZON KDP &amp; KINDLE</p>
                  <p>US LETTER · MARGEN 20 MM</p>
                  <p>WWW.JAVISAEZ.COM</p>
                </div>
                <div class="h-9 w-14 rounded-[2px] bg-white p-1 flex flex-col justify-between items-center">
                  <div class="w-full h-5 bg-[repeating-linear-gradient(90deg,#111_0px,#111_1px,transparent_1px,transparent_3px)]"></div>
                  <span class="text-[5.5px] font-mono text-black leading-none">ISBN KDP</span>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Barra de estado de interacción 3D + Botón accesible de Pausa -->
        <div class="mt-3 flex flex-wrap items-center justify-center gap-3 text-xs text-slate-400">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-dark-900/80 border border-dark-700/60 px-3 py-1">
            <span class="h-2 w-2 rounded-full bg-gold-400 animate-pulse" data-status-dot></span>
            <span data-interaction-hint>
              {locale === 'es'
                ? 'Mueve el cursor o inclina para ver el reflejo metálico y el lomo'
                : locale === 'de'
                  ? 'Maus bewegen oder neigen für Glanzeffekt und Buchrücken'
                  : locale === 'it'
                    ? 'Muovi il cursore o inclina per vedere il riflesso metallico e il dorso'
                    : 'Move pointer or tilt to inspect metallic foil reflection & spine'}
            </span>
          </span>

          <button
            type="button"
            data-toggle-flip
            aria-pressed="false"
            class="rounded-full bg-dark-900 hover:bg-dark-800 border border-dark-700 px-3 py-1 text-slate-200 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
          >
            {locale === 'es' ? 'Girar contraportada (180°)' : locale === 'de' ? 'Rückseite drehen (180°)' : locale === 'it' ? 'Ruota retro (180°)' : 'Flip back cover (180°)'}
          </button>

          <button
            type="button"
            data-toggle-motion
            class="rounded-full bg-dark-900 hover:bg-dark-800 border border-dark-700 px-3 py-1 text-slate-300 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
          >
            {locale === 'es' ? 'Pausar giro 3D' : locale === 'de' ? '3D-Drehung anhalten' : locale === 'it' ? 'Pausa rotazione 3D' : 'Pause 3D motion'}
          </button>
        </div>
      </div>

      <!-- COLUMNA DERECHA: Selector de Volumen (Vol. 1, 2) y Comparador KDP vs Espiral -->
      {showControls && (
        <div class="lg:col-span-5 flex flex-col justify-center space-y-6">
          
          <div>
            <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-gold-400">
              {rightContent.eyebrow}
            </span>
            <h2 class="mt-2 font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight">
              {rightContent.title}
            </h2>
            <p class="mt-2 text-sm text-slate-300 leading-relaxed">
              {rightContent.desc}
            </p>
          </div>

          <!-- Selector de Volumen (Solo Vol. 1 y Vol. 2) -->
          <div>
            <p id="method-vol-tabs-label" class="text-xs font-mono uppercase tracking-wider text-slate-400 mb-2">
              {volSelectLabelMap[locale] || volSelectLabelMap.es}
            </p>
            <div
              role="tablist"
              aria-labelledby="method-vol-tabs-label"
              class="grid grid-cols-2 gap-2 rounded-xl bg-dark-950 p-1.5 border border-dark-700/60"
            >
              {volumes.map((vol) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-vol-${vol.id}`}
                  aria-selected={vol.id === initialVolume ? 'true' : 'false'}
                  data-vol-tab={vol.id}
                  data-vol-code={vol.code}
                  data-vol-badge={vol.badge[locale] || vol.badge.es}
                  data-vol-subtitle={vol.subtitle[locale] || vol.subtitle.es}
                  data-vol-course={vol.course[locale] || vol.course.es}
                  data-vol-metal-name={vol.metalName[locale] || vol.metalName.es}
                  data-vol-status={vol.status[locale] || vol.status.es}
                  data-vol-spine={vol.spineLabel}
                  data-vol-hex={vol.hexPrimary}
                  data-vol-hex-sec={vol.hexSecondary}
                  data-vol-hex-shadow={vol.hexShadow}
                  class="vol-tab-btn relative flex flex-col items-start rounded-lg px-3 py-2.5 text-left transition-colors hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-gold-400"
                  style={`--tab-accent: ${vol.hexPrimary};`}
                >
                  <span class="flex items-center gap-1.5 text-xs font-bold text-white">
                    <span
                      class="h-2.5 w-2.5 rounded-full border border-white/30"
                      style={`background: ${vol.hexPrimary};`}
                    ></span>
                    <span>Vol. {vol.id}</span>
                  </span>
                  <span class="mt-0.5 text-[11px] text-slate-400">
                    {vol.id === 1 ? (rangeVol1Map[locale] || rangeVol1Map.es) : (rangeVol2Map[locale] || rangeVol2Map.es)}
                  </span>
                </button>
              ))}
            </div>
          </div>

          <!-- Panel de especificaciones dinámicas del volumen activo -->
          <div
            role="tabpanel"
            aria-labelledby={`tab-vol-${initialVolume}`}
            data-vol-tabpanel
            class="rounded-xl bg-dark-900/60 border border-dark-700/60 p-4 space-y-3 shadow-lg backdrop-blur-sm"
          >
            <div class="flex items-center justify-between border-b border-dark-700/60 pb-2.5">
              <div>
                <span
                  data-panel-metal-label
                  class="text-xs font-mono uppercase tracking-wider"
                  style={`color: ${initialVolData.hexPrimary};`}
                >
                  {initialVolData.metalName[locale] || initialVolData.metalName.es}
                </span>
                <h3 data-panel-title class="font-serif text-lg font-bold text-white">
                  {initialVolData.badge[locale] || initialVolData.badge.es}
                </h3>
              </div>
              <span
                data-panel-status
                class="rounded-full bg-dark-800 border border-dark-700 px-2.5 py-1 text-[11px] font-medium text-slate-200"
              >
                {initialVolData.status[locale] || initialVolData.status.es}
              </span>
            </div>

            <dl class="grid grid-cols-2 gap-3 text-xs">
              <div>
                <dt class="text-slate-400">{panelLabels.targetRange}</dt>
                <dd data-panel-subtitle class="mt-0.5 font-medium text-slate-100">
                  {initialVolData.subtitle[locale] || initialVolData.subtitle.es}
                </dd>
              </div>
              <div>
                <dt class="text-slate-400">{panelLabels.recStage}</dt>
                <dd data-panel-course class="mt-0.5 font-medium text-slate-100">
                  {initialVolData.course[locale] || initialVolData.course.es}
                </dd>
              </div>
            </dl>
          </div>

          <!-- Comparador táctil: Encuadernación KDP vs Vista de Atril (Margen 20 mm) -->
          <div>
            <p class="text-xs font-mono uppercase tracking-wider text-slate-400 mb-2">
              {bindingContent.label}
            </p>
            <div class="grid grid-cols-2 gap-2.5">
              <button
                type="button"
                data-binding-btn="kdp"
                aria-pressed="true"
                class="binding-btn flex flex-col items-start rounded-xl border border-gold-500/50 bg-gold-500/10 p-3 text-left transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
              >
                <span class="text-xs font-bold text-white">
                  {bindingContent.kdpTitle}
                </span>
                <span class="mt-1 text-[11px] text-slate-300 leading-snug">
                  {bindingContent.kdpDesc}
                </span>
              </button>

              <button
                type="button"
                data-binding-btn="spiral"
                aria-pressed="false"
                class="binding-btn flex flex-col items-start rounded-xl border border-dark-700 bg-dark-900/60 hover:bg-dark-850 p-3 text-left transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
              >
                <span class="text-xs font-bold text-white">
                  {bindingContent.kindleTitle}
                </span>
                <span class="mt-1 text-[11px] text-slate-300 leading-snug">
                  {bindingContent.kindleDesc}
                </span>
              </button>
            </div>
          </div>

        </div>
      )}
    </div>
  </div>
</section>

<style>
  .book-stage {
    perspective: 1400px;
  }

  .book-3d-object {
    transform-style: preserve-3d;
    translate: 0px 0px;
    rotate: 0deg;
    scale: 1;
    transform: rotateX(4deg) rotateY(-18deg);
    transition: transform 0.18s ease-out, scale 0.3s ease;
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .book-3d-object:not([data-motion-paused="true"]):not([data-pointer-active="true"]) {
      animation: bookFloat 6s ease-in-out infinite;
    }
  }

  @keyframes bookFloat {
    0%, 100% {
      translate: 0px 0px;
    }
    50% {
      translate: 0px -8px;
    }
  }

  .book-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }

  .book-front {
    transform: translateZ(14px);
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.85),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .book-back {
    transform: rotateY(180deg) translateZ(14px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85);
  }

  .book-spine {
    width: 28px;
    left: -14px;
    transform: rotateY(-90deg);
  }

  .book-spine-text {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .book-pages-right {
    width: 26px;
    right: -13px;
    left: auto;
    top: 3px;
    bottom: 3px;
    transform: rotateY(90deg);
    background:
      repeating-linear-gradient(
        90deg,
        #f5f2eb 0px,
        #f5f2eb 1.5px,
        #ded9ce 1.5px,
        #ded9ce 2.5px
      );
    box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.35);
  }

  .book-pages-top {
    height: 26px;
    top: -13px;
    bottom: auto;
    left: 2px;
    right: 3px;
    transform: rotateX(90deg);
    background:
      repeating-linear-gradient(
        0deg,
        #f5f2eb 0px,
        #f5f2eb 1.5px,
        #ded9ce 1.5px,
        #ded9ce 2.5px
      );
  }

  .book-pages-bottom {
    height: 26px;
    bottom: -13px;
    top: auto;
    left: 2px;
    right: 3px;
    transform: rotateX(-90deg);
    background:
      repeating-linear-gradient(
        0deg,
        #e8e3d8 0px,
        #e8e3d8 1.5px,
        #cdc7ba 1.5px,
        #cdc7ba 2.5px
      );
  }

  .book-metallic-title {
    background-size: 200% 200%;
    background-position: var(--sheen-pos, 50%) 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .book-metallic-title[data-metal-variant="copper"] {
    background-image: linear-gradient(
      115deg,
      #9E472A 0%,
      #D98A5B 30%,
      #FFF3E6 48%,
      #E89758 55%,
      #B85D32 85%,
      #9E472A 100%
    );
  }

  .book-metallic-title[data-metal-variant="silver"] {
    background-image: linear-gradient(
      115deg,
      #8E959D 0%,
      #D6DBDF 30%,
      #FFFFFF 49%,
      #F1F2F4 56%,
      #B8BFC6 85%,
      #8E959D 100%
    );
  }

  .book-specular-sheen {
    background: radial-gradient(
      380px circle at calc(var(--pointer-x, 0.5) * 100%) calc(var(--pointer-y, 0.35) * 100%),
      rgba(255, 255, 255, 0.28) 0%,
      rgba(232, 151, 88, 0.12) 32%,
      transparent 70%
    );
    mix-blend-mode: soft-light;
  }

  .vol-tab-btn[aria-selected="true"] {
    background-color: rgba(255, 255, 255, 0.07);
  }

  .vol-tab-btn[aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset: auto 8px 0 8px;
    border-block-end: 3px solid var(--tab-accent, #E89758);
  }
</style>

<script>
  function initTrilogyBook3D() {
    try {
      const roots = document.querySelectorAll<HTMLElement>('[data-book-3d-root]');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      roots.forEach((root) => {
        if (root.dataset.initialized === 'true') return;
        root.dataset.initialized = 'true';

        const locale = root.dataset.locale || 'es';
        const stage = root.querySelector<HTMLElement>('[data-book-stage]');
        const bookObject = root.querySelector<HTMLElement>('[data-book-object]');
        const sheen = root.querySelector<HTMLElement>('[data-book-sheen]');
        const aura = root.querySelector<HTMLElement>('[data-book-aura]');
        const mainTitle = root.querySelector<HTMLElement>('[data-book-main-title]');
        const badge = root.querySelector<HTMLElement>('[data-book-badge]');
        const subtitle = root.querySelector<HTMLElement>('[data-book-subtitle]');
        const metalFrame = root.querySelector<HTMLElement>('[data-metal-frame]');
        const spinePill = root.querySelector<HTMLElement>('[data-spine-pill]');
        const spineLabel = root.querySelector<HTMLElement>('[data-spine-label]');
        const kdpCrease = root.querySelector<HTMLElement>('[data-kdp-crease]');
        const spiralRings = root.querySelector<HTMLElement>('[data-spiral-rings]');

        const flipBtn = root.querySelector<HTMLButtonElement>('[data-toggle-flip]');
        const motionBtn = root.querySelector<HTMLButtonElement>('[data-toggle-motion]');
        const volTabs = root.querySelectorAll<HTMLButtonElement>('[data-vol-tab]');
        const tabPanel = root.querySelector<HTMLElement>('[data-vol-tabpanel]');
        const bindingBtns = root.querySelectorAll<HTMLButtonElement>('[data-binding-btn]');

        const panelMetalLabel = root.querySelector<HTMLElement>('[data-panel-metal-label]');
        const panelTitle = root.querySelector<HTMLElement>('[data-panel-title]');
        const panelStatus = root.querySelector<HTMLElement>('[data-panel-status]');
        const panelSubtitle = root.querySelector<HTMLElement>('[data-panel-subtitle]');
        const panelCourse = root.querySelector<HTMLElement>('[data-panel-course]');

        if (!stage || !bookObject) return;

        let isFlipped = false;
        let isMotionPaused = prefersReducedMotion;

        const resumeText = locale === 'es' ? 'Reanudar giro 3D' : locale === 'de' ? '3D-Drehung fortsetzen' : locale === 'it' ? 'Riprendi rotazione 3D' : 'Resume 3D motion';
        const pauseText = locale === 'es' ? 'Pausar giro 3D' : locale === 'de' ? '3D-Drehung anhalten' : locale === 'it' ? 'Pausa rotazione 3D' : 'Pause 3D motion';

        if (isMotionPaused) {
          bookObject.dataset.motionPaused = 'true';
          if (motionBtn) {
            motionBtn.textContent = resumeText;
          }
        }

        const updateBookTransform = (rotX: number, rotY: number) => {
          try {
            const baseFlip = isFlipped ? 180 : 0;
            bookObject.style.transform = `rotateX(${rotX.toFixed(2)}deg) rotateY(${(rotY + baseFlip).toFixed(2)}deg)`;
          } catch (err) {
            console.warn('[TrilogyBook3D] Error aplicando transformación 3D:', err);
          }
        };

        stage.addEventListener('pointermove', (e: PointerEvent) => {
          if (isMotionPaused) return;
          try {
            const rect = stage.getBoundingClientRect();
            const relX = Math.min(Math.max((e.clientX - rect.left) / rect.width, 0), 1);
            const relY = Math.min(Math.max((e.clientY - rect.top) / rect.height, 0), 1);

            const rotY = (relX - 0.5) * 38;
            const rotX = (0.5 - relY) * 24;

            bookObject.dataset.pointerActive = 'true';
            root.style.setProperty('--pointer-x', relX.toFixed(3));
            root.style.setProperty('--pointer-y', relY.toFixed(3));
            root.style.setProperty('--sheen-pos', `${(relX * 100).toFixed(1)}%`);

            if (sheen) sheen.style.opacity = '1';
            updateBookTransform(rotX, rotY);
          } catch (err) {
            console.warn('[TrilogyBook3D] Error procesando puntero:', err);
          }
        });

        stage.addEventListener('pointerleave', () => {
          try {
            delete bookObject.dataset.pointerActive;
            if (sheen) sheen.style.opacity = '0';
            root.style.setProperty('--sheen-pos', '50%');
            updateBookTransform(4, -18);
          } catch (err) {
            console.warn('[TrilogyBook3D] Error al restaurar postura 3D:', err);
          }
        });

        flipBtn?.addEventListener('click', () => {
          try {
            isFlipped = !isFlipped;
            flipBtn.setAttribute('aria-pressed', String(isFlipped));
            updateBookTransform(4, isFlipped ? 18 : -18);
          } catch (err) {
            console.error('[TrilogyBook3D] Error al girar cubierta:', err);
          }
        });

        motionBtn?.addEventListener('click', () => {
          try {
            isMotionPaused = !isMotionPaused;
            if (isMotionPaused) {
              bookObject.dataset.motionPaused = 'true';
              if (sheen) sheen.style.opacity = '0';
              updateBookTransform(0, 0);
              motionBtn.textContent = resumeText;
            } else {
              delete bookObject.dataset.motionPaused;
              updateBookTransform(4, -18);
              motionBtn.textContent = pauseText;
            }
          } catch (err) {
            console.error('[TrilogyBook3D] Error al alternar movimiento:', err);
          }
        });

        const selectVolumeTab = (selectedBtn: HTMLButtonElement) => {
          try {
            volTabs.forEach((btn) => {
              const isSelected = btn === selectedBtn;
              btn.setAttribute('aria-selected', String(isSelected));
            });

            const code = selectedBtn.dataset.volCode || 'copper';
            const isVol1 = code === 'copper';
            root.querySelector('[data-vol1-front-img]')?.classList.toggle('hidden', !isVol1);
            root.querySelector('[data-vol1-back-img]')?.classList.toggle('hidden', !isVol1);
            const hex = selectedBtn.dataset.volHex || '#E89758';
            const hexSec = selectedBtn.dataset.volHexSec || '#D98A5B';
            const hexShadow = selectedBtn.dataset.volHexShadow || '#9E472A';

            bookObject.dataset.metal = code;
            if (mainTitle) mainTitle.dataset.metalVariant = code;

            root.style.setProperty('--active-metal', hex);
            root.style.setProperty('--active-metal-secondary', hexSec);
            root.style.setProperty('--active-metal-shadow', hexShadow);

            if (aura) {
              aura.style.background = `radial-gradient(circle, ${hex} 0%, transparent 70%)`;
            }
            if (badge) {
              badge.textContent = selectedBtn.dataset.volBadge || '';
              badge.style.color = hex;
              badge.style.borderColor = `${hex}66`;
            }
            if (subtitle) {
              subtitle.textContent = selectedBtn.dataset.volSubtitle || '';
              subtitle.style.color = hexSec;
            }
            if (metalFrame) {
              metalFrame.style.borderColor = hex;
            }
            if (spinePill) {
              spinePill.style.background = `linear-gradient(180deg, ${hexShadow} 0%, ${hex} 50%, ${hexSec} 100%)`;
            }
            if (spineLabel) {
              spineLabel.textContent = selectedBtn.dataset.volSpine || '';
            }
            if (tabPanel && selectedBtn.id) {
              tabPanel.setAttribute('aria-labelledby', selectedBtn.id);
            }
            if (panelMetalLabel) {
              panelMetalLabel.textContent = selectedBtn.dataset.volMetalName || '';
              panelMetalLabel.style.color = hex;
            }
            if (panelTitle) {
              panelTitle.textContent = selectedBtn.dataset.volBadge || '';
            }
            if (panelStatus) {
              panelStatus.textContent = selectedBtn.dataset.volStatus || '';
            }
            if (panelSubtitle) {
              panelSubtitle.textContent = selectedBtn.dataset.volSubtitle || '';
            }
            if (panelCourse) {
              panelCourse.textContent = selectedBtn.dataset.volCourse || '';
            }
          } catch (err) {
            console.error('[TrilogyBook3D] Error cambiando volumen:', err);
          }
        };

        volTabs.forEach((btn, idx) => {
          btn.addEventListener('click', () => selectVolumeTab(btn));
          btn.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
              e.preventDefault();
              const dir = e.key === 'ArrowRight' ? 1 : -1;
              const nextIdx = (idx + dir + volTabs.length) % volTabs.length;
              const nextBtn = volTabs[nextIdx];
              if (nextBtn) {
                nextBtn.focus();
                selectVolumeTab(nextBtn);
              }
            }
          });
        });

        bindingBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            try {
              const mode = btn.dataset.bindingBtn || 'kdp';
              bindingBtns.forEach((b) => {
                const active = b === btn;
                b.setAttribute('aria-pressed', String(active));
                b.classList.toggle('border-gold-500/50', active);
                b.classList.toggle('bg-gold-500/10', active);
                b.classList.toggle('border-dark-700', !active);
                b.classList.toggle('bg-dark-900/60', !active);
              });

              bookObject.dataset.binding = mode;
              if (mode === 'spiral') {
                spiralRings?.classList.remove('hidden');
                spiralRings?.classList.add('flex');
                kdpCrease?.classList.add('hidden');
              } else {
                spiralRings?.classList.add('hidden');
                spiralRings?.classList.remove('flex');
                kdpCrease?.classList.remove('hidden');
              }
            } catch (err) {
              console.error('[TrilogyBook3D] Error cambiando encuadernación:', err);
            }
          });
        });
      });
    } catch (err) {
      console.error('[TrilogyBook3D] Fallo crítico de inicialización:', err);
    }
  }

  initTrilogyBook3D();
  document.addEventListener('astro:page-load', initTrilogyBook3D);
</script>
