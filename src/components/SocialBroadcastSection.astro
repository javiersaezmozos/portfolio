---
import SocialIcons from './SocialIcons.astro';
import type { SupportedLocale } from '../utils/i18n-routes';

interface Props {
  social: {
    title: string;
    subtitle: string;
    description: string;
    handle: string;
    channels: Array<{
      platform: string;
      handle: string;
      url: string;
      description: string;
      actionText: string;
    }>;
  };
  currentLocale: SupportedLocale;
}

const { social, currentLocale } = Astro.props;

const copyMap: Record<SupportedLocale, {
  ytTag: string;
  ytTitle: string;
  ytDesc: string;
  igTag: string;
  igDesc: string;
}> = {
  es: {
    ytTag: 'Vídeos & Recitales',
    ytTitle: 'Canal Oficial de Javier Sáez',
    ytDesc: 'Interpretaciones, metales y repertorio solista',
    igTag: 'Comunidad & Docencia',
    igDesc: 'Consejos técnicos, directos y actualidad musical',
  },
  en: {
    ytTag: 'Videos & Recitals',
    ytTitle: 'Official Channel of Javier Sáez',
    ytDesc: 'Solo brass repertoire, concerts & pieces',
    igTag: 'Community & Pedagogy',
    igDesc: 'Technical advice, live sessions & news',
  },
  de: {
    ytTag: 'Videos & Recitals',
    ytTitle: 'Offizieller Kanal von Javier Sáez',
    ytDesc: 'Blechbläserrepertoire, Konzerte & Solowerke',
    igTag: 'Community & Pädagogik',
    igDesc: 'Technische Tipps, Livestreams & Neuigkeiten',
  },
  it: {
    ytTag: 'Video & Recital',
    ytTitle: 'Canale Ufficiale di Javier Sáez',
    ytDesc: 'Repertorio per ottoni, concerti e brani solistici',
    igTag: 'Community & Didattica',
    igDesc: 'Consigli tecnici, dirette e novità musicali',
  },
};

const copy = copyMap[currentLocale] || copyMap.es;
---

<section id="redes" class="py-20 lg:py-28 relative overflow-hidden">
  
  <!-- Ambient noble metal background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-6xl h-96 bg-gradient-radial from-gold-500/10 via-copper/5 to-transparent blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-300 text-xs font-semibold mb-3">
        <SocialIcons name="video" class="w-4 h-4 text-gold-400" />
        <span>{social.subtitle}</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-4 text-balance">
        {social.title}
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {social.description}
      </p>
    </div>

    <!-- Interactive Channels Grid (Noble Metals Palette + Lite Facade) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- YouTube Card with On-Demand Lite Facade -->
      <div class="rounded-3xl bg-gradient-to-b from-dark-900 via-dark-850 to-dark-950 border border-gold-500/30 hover:border-gold-400/60 p-8 sm:p-10 flex flex-col justify-between shadow-2xl relative group overflow-hidden transition-colors">
        <div class="absolute top-0 right-0 w-48 h-48 bg-gold-500/10 rounded-full blur-2xl pointer-events-none"></div>
        
        <div>
          <div class="flex items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-2xl bg-gold-500/15 border border-gold-500/30 flex items-center justify-center text-gold-400 shadow-lg shadow-gold-500/10">
                <SocialIcons name="youtube" class="w-7 h-7" />
              </div>
              <div>
                <h3 class="font-serif text-2xl font-bold text-white">YouTube</h3>
                <span class="text-xs font-mono text-slate-400">@javi_trombone</span>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full bg-gold-500/15 border border-gold-500/30 text-gold-300 text-xs font-semibold">
              {copy.ytTag}
            </span>
          </div>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
            {social.channels[0].description}
          </p>

          <!-- Lite YouTube Facade (0 KB third-party JS until user clicks) -->
          <div
            data-yt-facade
            data-yt-embed="https://www.youtube-nocookie.com/embed?listType=user_uploads&list=javi_trombone&autoplay=1&rel=0"
            class="relative rounded-2xl bg-dark-950 border border-dark-750 overflow-hidden mb-8 aspect-video flex flex-col items-center justify-center p-6 text-center group/yt cursor-pointer"
            role="button"
            tabindex="0"
            aria-label={`${copy.ytTitle} — YouTube`}
          >
            <div class="absolute inset-0 bg-gradient-to-tr from-dark-950 via-dark-900/90 to-gold-500/10 pointer-events-none"></div>
            <div class="relative z-10 flex flex-col items-center gap-3">
              <div class="w-14 h-14 rounded-full bg-gold-500 text-dark-950 flex items-center justify-center shadow-xl shadow-gold-500/25 group-hover/yt:scale-105 transition-transform duration-200">
                <SocialIcons name="video" class="w-6 h-6" />
              </div>
              <div>
                <p class="text-sm font-serif font-bold text-white">
                  {copy.ytTitle}
                </p>
                <p class="text-xs text-slate-300 mt-0.5">
                  {copy.ytDesc}
                </p>
              </div>
            </div>
          </div>
        </div>

        <a
          href="https://youtube.com/@javi_trombone"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl bg-gradient-to-r from-gold-500 to-amber-500 hover:from-gold-400 hover:to-amber-400 text-dark-950 font-bold text-sm sm:text-base shadow-xl shadow-gold-500/20 transition-colors"
        >
          <SocialIcons name="youtube" class="w-5 h-5" />
          <span>{social.channels[0].actionText}</span>
          <SocialIcons name="external" class="w-4 h-4 opacity-80" />
        </a>
      </div>

      <!-- Instagram Card (Copper Editorial Palette) -->
      <div class="rounded-3xl bg-gradient-to-b from-dark-900 via-dark-850 to-dark-950 border border-copper/35 hover:border-copper/70 p-8 sm:p-10 flex flex-col justify-between shadow-2xl relative group overflow-hidden transition-colors">
        <div class="absolute top-0 right-0 w-48 h-48 bg-copper/10 rounded-full blur-2xl pointer-events-none"></div>
        
        <div>
          <div class="flex items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-2xl bg-copper/15 border border-copper/40 flex items-center justify-center text-copper-light shadow-lg shadow-copper/10">
                <SocialIcons name="instagram" class="w-6 h-6" />
              </div>
              <div>
                <h3 class="font-serif text-2xl font-bold text-white">Instagram</h3>
                <span class="text-xs font-mono text-slate-400">@javi_trombone</span>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full bg-copper/15 border border-copper/40 text-copper-light text-xs font-semibold">
              {copy.igTag}
            </span>
          </div>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
            {social.channels[1].description}
          </p>

          <!-- Editorial Community Showcase Box -->
          <div class="relative rounded-2xl bg-dark-950 border border-dark-750 overflow-hidden mb-8 aspect-video flex flex-col items-center justify-center p-6 text-center">
            <div class="absolute inset-0 bg-gradient-to-tr from-dark-950 via-dark-900/90 to-copper/10 pointer-events-none"></div>
            <div class="relative z-10 flex flex-col items-center gap-3">
              <div class="w-14 h-14 rounded-full bg-copper/20 border border-copper/50 text-copper-light flex items-center justify-center shadow-lg">
                <SocialIcons name="instagram" class="w-6 h-6" />
              </div>
              <div>
                <p class="text-sm font-serif font-bold text-white">@javi_trombone</p>
                <p class="text-xs text-slate-300 mt-0.5">
                  {copy.igDesc}
                </p>
              </div>
            </div>
          </div>
        </div>

        <a
          href="https://instagram.com/javi_trombone"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl border border-copper/60 bg-copper/20 hover:bg-copper/30 text-white font-bold text-sm sm:text-base shadow-xl transition-colors"
        >
          <SocialIcons name="instagram" class="w-5 h-5 text-copper-light" />
          <span>{social.channels[1].actionText}</span>
          <SocialIcons name="external" class="w-4 h-4 opacity-80" />
        </a>
      </div>

    </div>

  </div>
</section>

<script>
  function initLiteYouTubeFacade() {
    try {
      document.querySelectorAll<HTMLElement>('[data-yt-facade]').forEach((facade) => {
        if (facade.dataset.initialized === 'true') return;
        facade.dataset.initialized = 'true';

        const activateEmbed = () => {
          const embedUrl = facade.dataset.ytEmbed;
          if (!embedUrl || facade.dataset.loaded === 'true') return;
          facade.dataset.loaded = 'true';

          const iframe = document.createElement('iframe');
          iframe.src = embedUrl;
          iframe.title = 'Javier Sáez YouTube Official Channel';
          iframe.className = 'absolute inset-0 w-full h-full border-0';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          facade.innerHTML = '';
          facade.appendChild(iframe);
        };

        facade.addEventListener('click', activateEmbed);
        facade.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activateEmbed();
          }
        });
      });
    } catch (err) {
      console.error('[SocialBroadcastSection] Error initializing YouTube facade:', err);
    }
  }

  initLiteYouTubeFacade();
  document.addEventListener('astro:page-load', initLiteYouTubeFacade);
</script>
