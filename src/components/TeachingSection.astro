---
import SocialIcons from './SocialIcons.astro';

interface Props {
  teaching: {
    title: string;
    subtitle: string;
    description: string;
    positions: Array<{
      period: string;
      role: string;
      institution: string;
      description: string;
    }>;
  };
  currentLocale: 'es' | 'en';
}

const { teaching, currentLocale } = Astro.props;
---

<section id="trayectoria-docente" class="py-20 lg:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-300 text-xs font-semibold mb-3">
        <SocialIcons name="teaching" class="w-4 h-4 text-gold-400" />
        <span>{teaching.subtitle}</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-4">
        {teaching.title}
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {teaching.description}
      </p>
    </div>

    <!-- Teaching Positions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {teaching.positions.map((pos) => (
        <div class="p-6 sm:p-8 rounded-2xl bg-dark-900/80 border border-dark-800 hover:border-gold-500/40 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-2.5 py-1 rounded bg-gold-500/10 text-gold-400 border border-gold-500/20 text-xs font-bold font-mono">
                {pos.period}
              </span>
              <span class="text-xs text-slate-400 font-semibold">{pos.role}</span>
            </div>
            <h3 class="font-serif text-lg sm:text-xl font-bold text-white group-hover:text-gold-200 transition-colors mb-2">
              {pos.institution}
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mt-4 pt-3 border-t border-dark-800">
            {pos.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
