import { getVol1Faqs, getVol1Syllabus } from '../../data/methods-flexibility';
import { getMethodsPaths, type SupportedLocale } from '../../utils/i18n-routes';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dataMap = { es: esData, en: enData, de: deData, it: itData };
const siteData = dataMap[locale] || esData;
const paths = getMethodsPaths(locale, base);
const syllabusLevels = getVol1Syllabus(locale);
const faqs = getVol1Faqs(locale);

