---

<Layout
  meta={vol1Meta}
  nav={siteData.nav}
  footer={siteData.footer}
  currentLocale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(bookSchema)} />

  <main id="main-vol1-content" class="bg-dark-950 min-h-screen pt-6 pb-24 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <nav aria-label="Breadcrumbs" class="py-3 text-xs text-slate-400">
        <ol class="breadcrumb-list flex flex-wrap items-center">
          <li>
            <a href={paths.home} class="hover:text-gold-400 transition-colors focus:outline-none focus:underline">
              {copy.home}
            </a>
          </li>
          <li>
            <a href={paths.catalog} class="hover:text-gold-400 transition-colors focus:outline-none focus:underline">
              {copy.methods}
            </a>
          </li>
          <li>
            <a href={paths.trilogy} class="hover:text-gold-400 transition-colors focus:outline-none focus:underline">
              {copy.trilogy}
            </a>
          </li>
          <li>
            <a href={paths.vol1} aria-current="page" class="font-medium text-slate-200">
              {copy.current}
            </a>
          </li>
        </ol>
      </nav>

      <section aria-labelledby="vol1-hero-heading" class="mt-4 rounded-3xl border border-dark-700/60 bg-dark-900/60 p-6 sm:p-10 shadow-2xl backdrop-blur-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-7 space-y-5">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="inline-flex items-center gap-2 rounded-full border border-gold-500/50 bg-gold-500/15 px-3.5 py-1 text-xs font-mono uppercase tracking-widest text-gold-400">
                <span class="h-2 w-2 rounded-full bg-gold-400"></span>
                {copy.metalPill}
              </span>
              <span class="inline-flex items-center rounded-full border border-emerald-500/40 bg-emerald-500/10 px-3 py-1 text-xs font-mono text-emerald-300">
                {copy.launchPill}
              </span>
            </div>

            <h1 id="vol1-hero-heading" class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-white">
              {copy.titleLine1}<span class="block text-gold-400 mt-1">{copy.titleLine2}</span>
            </h1>

            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              {copy.lead1}<strong class="text-white">{copy.leadStrong1}</strong>{copy.lead2}<strong class="text-gold-400">{copy.leadStrong2}</strong>{copy.lead3}<strong class="text-white">{copy.leadStrong3}</strong>{copy.lead4}<strong class="text-white">{copy.leadStrong4}</strong>{copy.lead5}
            </p>

            <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
              {copy.specs.map((item) => (
                <div class="rounded-xl border border-dark-700/60 bg-dark-950/80 p-3">
                  <dt class="text-[11px] font-mono uppercase text-slate-400">{item.k}</dt>
                  <dd class={`mt-1 text-sm font-bold ${item.accent ? 'text-gold-400' : 'text-white'}`}>{item.v}</dd>
                </div>
              ))}
            </dl>

            <div class="rounded-2xl border border-dark-700/60 bg-dark-950/60 p-4 text-xs text-slate-300 leading-relaxed">
              <strong class="text-white font-semibold">{copy.standTitle}</strong>
              {copy.standBodyPrefix}
              <strong class="text-gold-400">{copy.standBodyHighlight}</strong>
              {copy.standBodySuffix}
            </div>
          </div>

          <div class="lg:col-span-5 rounded-2xl border border-gold-500/50 bg-dark-950/95 p-6 shadow-2xl space-y-5">
            <div class="border-b border-dark-700/60 pb-4">
              <span class="text-[11px] font-mono uppercase tracking-widest text-gold-400">
                {copy.boxEyebrow}
              </span>
              <h2 class="mt-1 font-serif text-xl font-bold text-white">
                {copy.boxTitle}
              </h2>
              <p class="mt-1 text-xs text-slate-400">
                {copy.boxSub}
              </p>
            </div>

            <article class="rounded-xl border border-gold-500/40 bg-gold-500/10 p-4 space-y-3">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class="inline-block rounded bg-gold-500 px-2 py-0.5 text-[10px] font-mono font-bold uppercase text-dark-950">
                    {copy.kdpBadge}
                  </span>
                  <h3 class="mt-1.5 font-serif text-base font-bold text-white">
                    {copy.kdpTitle}
                  </h3>
                </div>
                <span class="text-xs font-mono text-gold-400">US Letter</span>
              </div>
              <ul class="space-y-1.5 text-xs text-slate-300">
                {copy.kdpBullets.map((b) => <li>{b}</li>)}
              </ul>
              <div class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-xs font-mono font-semibold text-emerald-300">
                <span>🗓️ {copy.kdpBtn}</span>
              </div>
            </article>

            <article class="rounded-xl border border-dark-700/60 bg-dark-900/90 p-4 space-y-3">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class="inline-block rounded border border-gold-500/40 bg-gold-500/15 px-2 py-0.5 text-[10px] font-mono font-semibold uppercase text-gold-400">
                    {copy.kindleBadge}
                  </span>
                  <h3 class="mt-1.5 font-serif text-base font-bold text-white">
                    {copy.kindleTitle}
                  </h3>
                </div>
                <span class="text-xs font-mono text-slate-400">Print Replica</span>
              </div>
              <ul class="space-y-1.5 text-xs text-slate-300">
                {copy.kindleBullets.map((b) => <li>{b}</li>)}
              </ul>
              <div class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-xs font-mono font-semibold text-emerald-300">
                <span>🗓️ {copy.kindleBtn}</span>
              </div>
            </article>

            <div class="pt-2 border-t border-dark-700/60 flex items-center justify-between gap-3 text-xs">
              <span class="text-slate-400">{copy.alreadyBought}</span>
              <a
                href={paths.register}
                class="font-mono font-semibold text-gold-400 hover:underline"
              >
                {copy.registerLink}
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>

    <TrilogyBook3D initialVolume={1} locale={locale} showControls={true} />

    <SheetMusicViewer locale={locale} />

    <section aria-labelledby="vol1-syllabus-heading" class="mx-auto max-w-6xl px-4 sm:px-6 mt-12">
      <div class="rounded-3xl border border-dark-700/60 bg-dark-900/60 p-6 sm:p-10 backdrop-blur-sm">
        <div class="max-w-3xl">
          <span class="text-xs font-mono uppercase tracking-widest text-gold-400">
            {copy.syllabusEyebrow}
          </span>
          <h2 id="vol1-syllabus-heading" class="mt-1 font-serif text-2xl sm:text-3xl font-bold text-white">
            {copy.syllabusTitle}
          </h2>
          <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed">
            {copy.syllabusDesc1}<strong class="text-white">{copy.syllabusDescStrong1}</strong>{copy.syllabusDesc2}<strong class="text-white">{copy.syllabusDescStrong2}</strong>{copy.syllabusDesc3}
          </p>
        </div>

        <div class="mt-8 space-y-4">
          {syllabusLevels.map((lvl, idx) => (
            <details
              open={idx === 0}
              class="group rounded-2xl border border-dark-700/60 bg-dark-950/85 p-5 transition-colors open:border-gold-500/45"
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-base sm:text-lg font-bold text-white focus:outline-none">
                <span>
                  {lvl.level}
                  <span class="block font-sans text-xs font-normal text-gold-400 mt-0.5">
                    {lvl.range}
                  </span>
                </span>
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-dark-700 bg-dark-850 text-xs text-gold-400 transition-transform group-open:rotate-180">
                  ▼
                </span>
              </summary>

              <div class="mt-4 border-t border-dark-700/60 pt-4 space-y-4">
                <p class="text-xs text-slate-300 leading-relaxed">
                  {lvl.summary}
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {lvl.blocks.map((b) => (
                    <article class="rounded-xl border border-dark-700/60 bg-dark-900/70 p-4 flex flex-col justify-between gap-2">
                      <div>
                        <div class="flex items-center justify-between gap-2">
                          <span class="font-mono text-[11px] text-gold-400">
                            QR: /e/{b.code}
                          </span>
                          <a
                            href={`${base}/e/${b.code}`}
                            class="text-[11px] font-mono text-slate-300 hover:text-gold-400 underline"
                          >
                            {copy.testQr}
                          </a>
                        </div>
                        <h3 class="mt-1 font-serif text-sm font-bold text-white">
                          {b.title}
                        </h3>
                        <p class="mt-1 text-xs text-slate-300">
                          {b.detail}
                        </p>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section aria-labelledby="vol1-faq-heading" class="mx-auto max-w-6xl px-4 sm:px-6 mt-12">
      <div class="rounded-3xl border border-dark-700/60 bg-dark-900/60 p-6 sm:p-10 backdrop-blur-sm">
        <span class="text-xs font-mono uppercase tracking-widest text-gold-400">
          {copy.faqEyebrow}
        </span>
        <h2 id="vol1-faq-heading" class="mt-1 font-serif text-2xl sm:text-3xl font-bold text-white">
          {copy.faqTitle}
        </h2>

        <div class="mt-6 space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-2xl border border-dark-700/60 bg-dark-950/80 p-5 open:border-gold-500/40">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm sm:text-base font-bold text-white focus:outline-none">
                <span>{faq.question}</span>
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-dark-700 bg-dark-850 text-xs text-gold-400 transition-transform group-open:rotate-180">
                  ▼
                </span>
              </summary>
              <p class="mt-3 border-t border-dark-700/60 pt-3 text-xs sm:text-sm text-slate-300 leading-relaxed">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .breadcrumb-list li:not(:first-child)::before {
    content: "/" / "";
    padding-inline: 0.6rem;
    color: #64748b;
  }
</style>
