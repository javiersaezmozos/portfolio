---
import Layout from '../../layouts/Layout.astro';
import TrilogyBook3D from '../TrilogyBook3D.astro';
import SheetMusicViewer from '../SheetMusicViewer.astro';
import esData from '../../data/es.json';
import enData from '../../data/en.json';
import deData from '../../data/de.json';
import itData from '../../data/it.json';
import { getTrilogyVolumes } from '../../data/methods-flexibility';
import { getMethodsPaths, type SupportedLocale } from '../../utils/i18n-routes';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dataMap = { es: esData, en: enData, de: deData, it: itData };
const siteData = dataMap[locale] || esData;
const paths = getMethodsPaths(locale, base);
const trilogyCards = getTrilogyVolumes(locale, base);

const trilogyMetaMap: Record<SupportedLocale, { title: string; description: string; ogImage: string; locale: string }> = {
  es: {
    title: 'Método de Flexibilidad para Trombón · Colección Metodología de Flexibilidad | Javier Sáez',
    description:
      'Método progresivo e interactivo de flexibilidad para trombón de Javier Sáez Mozos. Volumen 1 Elemental (Cobre, hasta Fa4) con lanzamiento oficial en Amazon KDP y Kindle previsto para mayo–junio de 2027, y Volumen 2 Intermedio (Plata, hasta Sib5).',
    ogImage: '/images/metodos/vol1-portada.png',
    locale: 'es',
  },
  en: {
    title: 'Trombone Flexibility Method · Flexibility Methodology Collection | Javier Sáez',
    description:
      'Progressive and interactive trombone flexibility method by Javier Sáez Mozos. Volume 1 Elementary (Copper, up to F4) with official launch on Amazon KDP & Kindle scheduled for May–June 2027, and Volume 2 Intermediate (Silver, up to Bb5).',
    ogImage: '/images/metodos/vol1-portada.png',
    locale: 'en',
  },
  de: {
    title: 'Posaunen-Flexibilitätsmethode · Kollektion Flexibilitätsmethodik | Javier Sáez',
    description:
      'Progressive und interaktive Flexibilitätsmethode für Posaune von Javier Sáez Mozos. Band 1 Elementarstufe (Kupfer, bis F4) mit offiziellem Verkaufsstart auf Amazon KDP & Kindle geplant für Mai–Juni 2027 und Band 2 Mittelstufe (Silber, bis B5).',
    ogImage: '/images/metodos/vol1-portada.png',
    locale: 'de',
  },
  it: {
    title: 'Metodo di Flessibilità per Trombone · Collezione Metodologia di Flessibilità | Javier Sáez',
    description:
      'Metodo progressivo e interattivo di flessibilità per trombone di Javier Sáez Mozos. Volume 1 Elementare (Rame, fino a Fa4) con lancio ufficiale su Amazon KDP e Kindle previsto per maggio–giugno 2027, e Volume 2 Intermedio (Argento, fino a Sib5).',
    ogImage: '/images/metodos/vol1-portada.png',
    locale: 'it',
  },
};

interface MethodPillar {
  title: string;
  desc: string;
}

interface CopyEntry {
  home: string;
  methods: string;
  current: string;
  eyebrow: string;
  h1: string;
  subtitle: string;
  ctaVol1: string;
  ctaRegister: string;
  compEyebrow: string;
  compTitle: string;
  compCatalogLink: string;
  pillars: MethodPillar[];
  teachersEyebrow: string;
  teachersTitle: string;
  teachersSubtitle: string;
  teachersVol1Badge: string;
  teachersVol1Title: string;
  teachersVol1Points: string[];
  teachersVol2Badge: string;
  teachersVol2Title: string;
  teachersVol2Points: string[];
  teachersContactTag: string;
  teachersContactText: string;
  teachersContactBtn: string;
  teachersMailto: string;
}

