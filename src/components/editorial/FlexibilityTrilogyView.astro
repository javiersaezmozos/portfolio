    ogImage: '/images/metodos/vol1-portada.png',
    locale: 'de',
  },
  it: {
    title: 'Metodo di Flessibilità per Trombone · Collezione Metodologia di Flessibilità | Javier Sáez',
    description:
      'Metodo progressivo e interattivo di flessibilità per trombone di Javier Sáez Mozos. Volume 1 Elementare (Rame, fino a Fa4) con lancio ufficiale su Amazon KDP e Kindle previsto per maggio–giugno 2027, e Volume 2 Intermedio (Argento, fino a Sib5).',
    ogImage: '/images/metodos/vol1-portada.png',
    locale: 'it',
