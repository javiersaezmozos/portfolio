const trilogyMeta = trilogyMetaMap[locale] || trilogyMetaMap.es;
const copy = copyMap[locale] || copyMap.es;
const siteUrl = Astro.site || 'https://www.javisaez.com';

const trilogySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BookSeries',
      name: copy.h1Main,
      description: trilogyMeta.description,
      url: new URL(paths.trilogy, siteUrl).href,
      inLanguage: locale,
      author: {
        '@type': 'Person',
        name: 'Javier Sáez Mozos',
        url: new URL(paths.home, siteUrl).href,
      },
      hasPart: [
        {
          '@type': 'Book',
          name: trilogyCards[0]?.title || 'Volumen 1 · Elemental',
          position: 1,
          url: new URL(paths.vol1, siteUrl).href,
          image: new URL('/images/metodos/vol1-portada.png', siteUrl).href,
          bookFormat: ['https://schema.org/Paperback', 'https://schema.org/EBook'],
        },
        {
          '@type': 'Book',
          name: trilogyCards[1]?.title || 'Volumen 2 · Intermedio',
          position: 2,
          image: new URL('/images/metodos/vol2-portada.jpg', siteUrl).href,
          bookFormat: ['https://schema.org/Paperback', 'https://schema.org/EBook'],
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: copy.home,
          item: new URL(paths.home, siteUrl).href,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: copy.methods,
          item: new URL(paths.catalog, siteUrl).href,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: copy.current,
          item: new URL(paths.trilogy, siteUrl).href,
        },
      ],
    },
  ],
};
---

<Layout
  meta={trilogyMeta}
  nav={siteData.nav}
  footer={siteData.footer}
  currentLocale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(trilogySchema)} />

  <div id="main-trilogy-content" class="bg-dark-950 min-h-screen pt-6 pb-24 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <nav aria-label="Breadcrumbs" class="py-3 text-xs text-slate-400">
        <ol class="breadcrumb-list flex flex-wrap items-center">
          <li>
            <a href={paths.home} class="hover:text-gold-400 transition-colors focus:outline-none focus:underline">
              {copy.home}
            </a>
          </li>
          <li>
            <a href={paths.catalog} class="hover:text-gold-400 transition-colors focus:outline-none focus:underline">
              {copy.methods}
            </a>
          </li>
          <li>
            <a href={paths.trilogy} aria-current="page" class="font-medium text-slate-200">
              {copy.current}
            </a>
          </li>
        </ol>
      </nav>
    </div>

    <!-- HERO SECTION -->
    <header class="mx-auto max-w-6xl px-4 sm:px-6 pt-4 pb-4 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.28em] text-gold-400">
        {copy.eyebrow}
      </p>
      <h1 class="mt-2 font-serif text-3xl sm:text-5xl font-bold tracking-wider text-white uppercase">
        {copy.h1}
      </h1>
      <p class="mx-auto mt-3 max-w-2xl text-sm sm:text-base text-slate-300 font-serif italic">
        {copy.subtitle}
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href={paths.vol1}
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-gold-600 to-amber-500 px-5 py-2.5 text-xs sm:text-sm font-bold text-dark-950 shadow-lg hover:from-gold-500 hover:to-amber-400 transition-all focus:outline-none focus:ring-2 focus:ring-gold-400"
        >
          <span>{copy.ctaVol1}</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={paths.register}
          class="inline-flex items-center gap-2 rounded-xl border border-dark-700 bg-dark-850/80 px-5 py-2.5 text-xs sm:text-sm font-medium text-white hover:bg-dark-800 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
        >
          <span>{copy.ctaRegister}</span>
        </a>
      </div>

      <!-- 4 PILARES: QUÉ RESUELVE EL MÉTODO -->
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-left">
        {copy.pillars.map((pillar) => (
          <div class="rounded-2xl border border-dark-700/60 bg-dark-900/60 p-5 shadow-lg backdrop-blur-sm hover:border-gold-500/40 transition-colors">
            <div class="flex items-center gap-2 text-gold-400 mb-2">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-gold-400" aria-hidden="true"></span>
              <h2 class="text-xs font-mono uppercase tracking-wider font-semibold text-white">
                {pillar.title}
              </h2>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {pillar.desc}
            </p>
          </div>
        ))}
      </div>
    </header>

    <!-- VISOR 3D INTERACTIVO -->
    <TrilogyBook3D initialVolume={1} locale={locale} showControls={true} />

    <!-- VISOR DE MAQUETACIÓN Y PARTITURA VECTORIAL -->
    <SheetMusicViewer locale={locale} />

    <!-- COMPARATIVA DE VOLÚMENES -->
    <section
      id="comparativa-metodo"
      aria-labelledby="comparativa-metodo-heading"
      class="mx-auto max-w-6xl px-4 sm:px-6 pt-12"
    >
      <div class="rounded-3xl border border-dark-700/60 bg-dark-900/60 p-6 sm:p-10 shadow-2xl backdrop-blur-sm">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-gold-400">
              {copy.compEyebrow}
            </span>
            <h2 id="comparativa-metodo-heading" class="mt-1 font-serif text-2xl sm:text-3xl font-bold text-white">
              {copy.compTitle}
            </h2>
          </div>
          <a
            href={paths.catalog}
            class="text-xs font-mono uppercase tracking-wider text-gold-400 hover:text-gold-300 hover:underline"
          >
            {copy.compCatalogLink}
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {trilogyCards.map((card) => (
            <article class="flex flex-col justify-between rounded-2xl border border-dark-700/60 bg-dark-950/80 hover:border-gold-500/50 p-6 shadow-lg transition-all">
              <div>
                <h3 class="font-serif text-2xl sm:text-3xl font-bold" style={`color: ${card.hex};`}>
                  {card.title}
                </h3>
                <p class="mt-1 text-xs font-semibold text-white">
                  {card.range}
                </p>
                <p class="mt-1 text-xs text-slate-400">
                  {card.courses}
                </p>

                <ul class="mt-4 space-y-2 border-t border-dark-700/60 pt-4 text-xs text-slate-300">
                  {card.trilogyHighlights.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-gold-400" aria-hidden="true">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-6 pt-4 border-t border-dark-700/60">
                <a
                  href={card.slug}
                  class={`inline-flex w-full items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400 ${
                    card.available
                      ? 'bg-gradient-to-r from-gold-600 to-amber-500 text-dark-950 hover:from-gold-500 hover:to-amber-400'
                      : 'border border-dark-700 bg-dark-850/80 text-slate-200 hover:bg-dark-800'
                  }`}
                >
                  <span>{card.ctaTrilogy}</span>
                  <span aria-hidden="true">{card.available ? '→' : '✉'}</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- BLOQUE PROFESORES Y CONSERVATORIOS -->
    <section
      id="profesores-conservatorios"
      aria-labelledby="profesores-heading"
      class="mx-auto max-w-6xl px-4 sm:px-6 pt-16"
    >
      <div class="rounded-3xl border border-dark-700/60 bg-dark-900/60 p-6 sm:p-10 shadow-2xl backdrop-blur-sm">
        <div class="max-w-3xl mb-8">
          <span class="text-xs font-mono uppercase tracking-widest text-gold-400">
            {copy.teachersEyebrow}
          </span>
          <h2 id="profesores-heading" class="mt-1 font-serif text-2xl sm:text-3xl font-bold text-white">
            {copy.teachersTitle}
          </h2>
          <p class="mt-2 text-sm sm:text-base text-slate-300">
            {copy.teachersSubtitle}
          </p>
        </div>

        <!-- 2 Columnas de aplicación curricular (EE.EE. y EE.PP.) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Columna 1: EE.EE. -->
          <div class="rounded-2xl border border-copper/35 bg-dark-950/80 p-6 shadow-lg">
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-copper-light">
              {copy.teachersVol1Badge}
            </h3>
            <p class="mt-1 text-xs font-semibold text-white">
              {copy.teachersVol1Title}
            </p>
            <ul class="mt-4 space-y-2.5 text-xs text-slate-300">
              {copy.teachersVol1Points.map((point) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-copper-light mt-0.5 text-sm" aria-hidden="true">✓</span>
                  <span class="leading-relaxed">{point}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Columna 2: EE.PP. -->
          <div class="rounded-2xl border border-silver/35 bg-dark-950/80 p-6 shadow-lg">
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#B8C0CC]">
              {copy.teachersVol2Badge}
            </h3>
            <p class="mt-1 text-xs font-semibold text-white">
              {copy.teachersVol2Title}
            </p>
            <ul class="mt-4 space-y-2.5 text-xs text-slate-300">
              {copy.teachersVol2Points.map((point) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-silver mt-0.5 text-sm" aria-hidden="true">✓</span>
                  <span class="leading-relaxed">{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Bloque de contacto directo y pedidos de aula -->
        <div class="mt-8 rounded-2xl border border-gold-500/30 bg-gradient-to-r from-dark-950 via-dark-900 to-dark-850 p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <span class="inline-block text-[11px] font-mono uppercase tracking-wider text-gold-400 font-semibold mb-1">
              {copy.teachersContactTag}
            </span>
            <p class="text-sm text-slate-200 leading-relaxed">
              {copy.teachersContactText}
            </p>
          </div>
          <a
            href={copy.teachersMailto}
            class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-gradient-to-r from-gold-600 to-amber-500 px-5 py-3 text-xs sm:text-sm font-bold text-dark-950 shadow-lg hover:from-gold-500 hover:to-amber-400 transition-all focus:outline-none focus:ring-2 focus:ring-gold-400"
          >
            <span aria-hidden="true">✉</span>
            <span>{copy.teachersContactBtn}</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .breadcrumb-list li:not(:first-child)::before {
    content: "/" / "";
    padding-inline: 0.6rem;
    color: #64748b;
  }
</style>
