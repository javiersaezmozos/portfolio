---
import Layout from '../../layouts/Layout.astro';
import TrilogyBook3D from '../TrilogyBook3D.astro';
import HarmonicAcousticSelector from '../HarmonicAcousticSelector.astro';
import SheetMusicViewer from '../SheetMusicViewer.astro';
import esData from '../../data/es.json';
import enData from '../../data/en.json';
import { getTrilogyVolumes } from '../../data/methods-flexibility';
import { getMethodsPaths, type SupportedLocale } from '../../utils/i18n-routes';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isEs = locale === 'es';
const siteData = isEs ? esData : enData;
const paths = getMethodsPaths(locale, base);
const trilogyCards = getTrilogyVolumes(locale, base);

const trilogyMeta = isEs
  ? {
      title: 'Trilogía Trombón Flexibilidad · Colección Metales Nobles | Javier Sáez',
      description:
        'Método progresivo e interactivo de flexibilidad para trombón de Javier Sáez Mozos. Volumen 1 Elemental (Cobre, hasta Fa4) disponible en Amazon KDP y Amazon Kindle, Volumen 2 Intermedio (Plata, hasta Sib5) y Volumen 3 Avanzado (Oro, hasta Fa6).',
      ogImage: '/images/metodos/portada-duo-trombot.jpg',
      locale: 'es',
    }
  : {
      title: 'Trombone Flexibility Trilogy · Noble Metals Collection | Javier Sáez',
      description:
        'Progressive and interactive trombone flexibility method by Javier Sáez Mozos. Volume 1 Elementary (Copper, up to F4) on Amazon KDP & Kindle, Volume 2 Intermediate (Silver, up to Bb5) and Volume 3 Advanced (Gold, up to F6).',
      ogImage: '/images/metodos/portada-duo-trombot.jpg',
      locale: 'en',
    };

const copy = isEs
  ? {
      home: 'Inicio',
      methods: 'Métodos',
      current: 'Trilogía Flexibilidad',
      eyebrow: 'Colección Editorial Metales Nobles · Javier Sáez Mozos',
      h1: 'Trombón · Flexibilidad',
      subtitle:
        'Un método progresivo y didáctico con videopartituras interactivas integradas y asistencia pedagógica de TromBot IA. Lanzamiento del Volumen 1 exclusivo en Amazon KDP (Tapa Blanda) y Amazon Kindle.',
      ctaVol1: 'Ficha y Compra del Volumen 1 (Amazon KDP / Kindle)',
      ctaRegister: 'Activar Ejemplar (/registro)',
      compEyebrow: 'Hoja de Ruta de la Colección Metales Nobles',
      compTitle: 'Arquitectura de los Tres Volúmenes',
      compCatalogLink: 'Ver catálogo completo de publicaciones →',
    }
  : {
      home: 'Home',
      methods: 'Methods',
      current: 'Flexibility Trilogy',
      eyebrow: 'Noble Metals Editorial Collection · Javier Sáez Mozos',
      h1: 'Trombone · Flexibility',
      subtitle:
        'A progressive didactic method with integrated interactive video scores and TromBot AI pedagogical guidance. Exclusive Volume 1 launch on Amazon KDP (Paperback) and Amazon Kindle.',
      ctaVol1: 'Volume 1 Sheet & Buy on Amazon (KDP / Kindle)',
      ctaRegister: 'Activate Copy (/registro)',
      compEyebrow: 'Noble Metals Collection Roadmap',
      compTitle: 'Architecture of the Three Volumes',
      compCatalogLink: 'View full publications catalog →',
    };
---

<Layout
  meta={trilogyMeta}
  nav={siteData.nav}
  footer={siteData.footer}
  currentLocale={locale}
>
  <main id="main-trilogy-content" class="bg-gradient-auditorium min-h-screen pt-6 pb-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <nav aria-label="Breadcrumbs" class="py-3 text-xs text-slate-400">
        <ol class="breadcrumb-list flex flex-wrap items-center">
          <li>
            <a href={paths.home} class="hover:text-copper-light transition-colors focus:outline-none focus:underline">
              {copy.home}
            </a>
          </li>
          <li>
            <a href={paths.catalog} class="hover:text-copper-light transition-colors focus:outline-none focus:underline">
              {copy.methods}
            </a>
          </li>
          <li>
            <a href={paths.trilogy} aria-current="page" class="font-medium text-slate-200">
              {copy.current}
            </a>
          </li>
        </ol>
      </nav>
    </div>

    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-4 pb-2 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.28em] text-copper">
        {copy.eyebrow}
      </p>
      <h1 class="mt-2 font-serif text-3xl sm:text-5xl font-bold tracking-wider text-white uppercase">
        {copy.h1}
      </h1>
      <p class="mx-auto mt-3 max-w-2xl text-sm sm:text-base text-slate-300 font-serif italic">
        {copy.subtitle}
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href={paths.vol1}
          class="inline-flex items-center gap-2 rounded-xl bg-copper px-5 py-2.5 text-xs sm:text-sm font-bold text-graphite-deep shadow-lg hover:bg-copper-light transition-colors focus:outline-none focus:ring-2 focus:ring-gold-regal"
        >
          <span>{copy.ctaVol1}</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={paths.register}
          class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-5 py-2.5 text-xs sm:text-sm font-medium text-white hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-regal"
        >
          <span>{copy.ctaRegister}</span>
        </a>
      </div>
    </div>

    <TrilogyBook3D initialVolume={1} locale={locale} showControls={true} />

    <HarmonicAcousticSelector locale={locale} />

    <SheetMusicViewer locale={locale} />

    <section
      id="comparativa-trilogia"
      aria-labelledby="comparativa-trilogia-heading"
      class="mx-auto max-w-6xl px-4 sm:px-6 pt-12"
    >
      <div class="rounded-3xl border border-graphite-border bg-graphite-surface/80 p-6 sm:p-10 shadow-2xl">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-copper-light">
              {copy.compEyebrow}
            </span>
            <h2 id="comparativa-trilogia-heading" class="mt-1 font-serif text-2xl sm:text-3xl font-bold text-white">
              {copy.compTitle}
            </h2>
          </div>
          <a
            href={paths.catalog}
            class="text-xs font-mono uppercase tracking-wider text-copper-light hover:underline"
          >
            {copy.compCatalogLink}
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {trilogyCards.map((card) => (
            <article class="flex flex-col justify-between rounded-2xl border border-white/10 bg-graphite-deep/90 p-6 shadow-lg">
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-white">
                    <span
                      class="h-2.5 w-2.5 rounded-full"
                      style={`background-color: ${card.hex};`}
                    ></span>
                    {card.metal}
                  </span>
                  <span class="rounded-full bg-white/10 px-2.5 py-0.5 text-[11px] font-mono text-slate-300">
                    {card.status}
                  </span>
                </div>

                <h3 class="mt-4 font-serif text-xl font-bold text-white">
                  {card.title}
                </h3>
                <p class="mt-1 text-xs font-semibold" style={`color: ${card.hex};`}>
                  {card.range}
                </p>
                <p class="mt-1 text-xs text-slate-400">
                  {card.courses}
                </p>

                <ul class="mt-4 space-y-2 border-t border-white/10 pt-4 text-xs text-slate-300">
                  {card.trilogyHighlights.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-copper-light" aria-hidden="true">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-6 pt-4 border-t border-white/10">
                <a
                  href={card.slug}
                  class={`inline-flex w-full items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold transition-colors focus:outline-none focus:ring-2 focus:ring-gold-regal ${
                    card.available
                      ? 'bg-copper text-graphite-deep hover:bg-copper-light'
                      : 'border border-white/15 bg-white/5 text-slate-200 hover:bg-white/10'
                  }`}
                >
                  <span>{card.ctaTrilogy}</span>
                  <span aria-hidden="true">{card.available ? '→' : '✉'}</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .breadcrumb-list li:not(:first-child)::before {
    content: "/" / "";
    padding-inline: 0.6rem;
    color: #64748b;
  }
</style>
