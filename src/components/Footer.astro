---
import SocialIcons from './SocialIcons.astro';

interface Props {
  footer: {
    rights: string;
    tagline: string;
    quickLinks: string;
    connect: string;
    languages: string;
    spanish: string;
    english: string;
  };
  nav: any;
  currentLocale: 'es' | 'en';
}

const { footer, nav, currentLocale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = 2026;
---

<footer class="bg-dark-950 border-t border-dark-800/80 pt-16 pb-12 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-dark-850">
      
      <!-- Brand column -->
      <div class="lg:col-span-2 space-y-4">
        <a href={`${base}/${currentLocale}`} class="flex items-center gap-3 w-fit">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-600 via-gold-500 to-amber-200 p-[1.5px]">
            <div class="w-full h-full bg-dark-950 rounded-full flex items-center justify-center">
              <span class="font-serif font-bold text-gold-400 text-lg">JS</span>
            </div>
          </div>
          <span class="font-serif text-xl font-bold text-white">Javier Sáez</span>
        </a>
        
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          {footer.tagline}
        </p>

        <!-- Social Icons -->
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://instagram.com/javi_trombone"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-xl bg-dark-900 text-slate-300 hover:text-pink-400 hover:bg-dark-850 border border-dark-800 transition-all"
            aria-label="Instagram @javi_trombone"
          >
            <SocialIcons name="instagram" class="w-5 h-5" />
          </a>
          <a
            href="https://youtube.com/@javi_trombone"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-xl bg-dark-900 text-slate-300 hover:text-red-500 hover:bg-dark-850 border border-dark-800 transition-all"
            aria-label="YouTube @javi_trombone"
          >
            <SocialIcons name="youtube" class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div class="space-y-3">
        <h4 class="font-serif font-bold text-sm text-slate-200 uppercase tracking-wider">{footer.quickLinks}</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="#presentacion" class="hover:text-gold-400 transition-colors">{nav.presentation}</a></li>
          <li><a href="#formacion-academica" class="hover:text-gold-400 transition-colors">{nav.academic}</a></li>
          <li><a href="#masterclasses" class="hover:text-gold-400 transition-colors">{nav.masterclasses}</a></li>
          <li><a href="#experiencia-interpretativa" class="hover:text-gold-400 transition-colors">{nav.performance}</a></li>
        </ul>
      </div>

      <!-- More Links -->
      <div class="space-y-3">
        <h4 class="font-serif font-bold text-sm text-slate-200 uppercase tracking-wider">{currentLocale === 'es' ? 'Trayectoria' : 'Career'}</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="#trayectoria-docente" class="hover:text-gold-400 transition-colors">{nav.teaching}</a></li>
          <li><a href="#premios" class="hover:text-gold-400 transition-colors">{nav.awards}</a></li>
          <li><a href="#redes" class="hover:text-gold-400 transition-colors">{nav.social}</a></li>
        </ul>
      </div>

      <!-- Language & Connect -->
      <div class="space-y-3">
        <h4 class="font-serif font-bold text-sm text-slate-200 uppercase tracking-wider">{footer.languages}</h4>
        <div class="flex flex-col space-y-2 text-sm">
          <a
            href={`${base}/en`}
            class={`flex items-center gap-2 ${currentLocale === 'en' ? 'text-gold-400 font-bold' : 'text-slate-400 hover:text-slate-200'}`}
          >
            <span>🇬🇧</span>
            <span>{footer.english}</span>
          </a>
          <a
            href={`${base}/es`}
            class={`flex items-center gap-2 ${currentLocale === 'es' ? 'text-gold-400 font-bold' : 'text-slate-400 hover:text-slate-200'}`}
          >
            <span>🇪🇸</span>
            <span>{footer.spanish}</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} Javier Sáez. {footer.rights}</p>
      <p class="flex items-center gap-2">
        <span>Canal Oficial:</span>
        <a href="https://youtube.com/@javi_trombone" class="text-gold-400/90 hover:underline">@javi_trombone</a>
      </p>
    </div>

  </div>
</footer>
