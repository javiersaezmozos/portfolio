---
import SocialIcons from './SocialIcons.astro';

interface Props {
  hero: {
    badge: string;
    name: string;
    tagline: string;
    ctaPrimary: string;
    ctaSecondary: string;
    ctaSocial: string;
    highlights: Array<{ label: string; value: string }>;
  };
  presentation: {
    title: string;
    subtitle: string;
    paragraphs: string[];
    quote: string;
  };
  currentLocale: 'es' | 'en';
}

const { hero, presentation, currentLocale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="presentacion" class="relative pt-12 pb-24 lg:pt-20 lg:pb-32 overflow-hidden">
  
  <!-- Subtle ambient glow in background -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-amber-500/10 via-gold-500/5 to-transparent blur-3xl -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Top Grid: Portrait + Main Bio Intro -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Artistic Portrait Image -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative group w-full max-w-md">
          
          <!-- Outer decorative glowing border -->
          <div class="absolute -inset-1 bg-gradient-to-tr from-amber-600 via-gold-400 to-amber-300 rounded-3xl blur-md opacity-40 group-hover:opacity-75 transition duration-700"></div>
          
          <!-- Image container -->
          <div class="relative rounded-2xl overflow-hidden bg-dark-900 border border-gold-500/30 shadow-2xl">
            <img
              src={`${base}/images/javier-saez.jpg`}
              alt="Javier Sáez - Trombonista y Pedagogo Musical"
              class="w-full h-auto object-cover object-center aspect-[4/5] transform group-hover:scale-[1.02] transition-transform duration-700 ease-out"
              loading="eager"
              width="600"
              height="750"
            />
            
            <!-- Gradient overlay for text readability at bottom -->
            <div class="absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/20 to-transparent opacity-80"></div>
            
            <!-- Quick badge on portrait -->
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-dark-900/85 backdrop-blur-md border border-gold-500/30 flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-wider text-gold-400 font-semibold">{hero.badge}</p>
                <p class="text-sm font-serif font-bold text-slate-100">Javier Sáez</p>
              </div>
              <div class="flex items-center gap-2">
                <a
                  href="https://youtube.com/@javi_trombone"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-dark-800 text-slate-300 hover:text-red-500 transition-colors"
                  aria-label="YouTube @javi_trombone"
                >
                  <SocialIcons name="youtube" class="w-4 h-4" />
                </a>
                <a
                  href="https://instagram.com/javi_trombone"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-dark-800 text-slate-300 hover:text-pink-400 transition-colors"
                  aria-label="Instagram @javi_trombone"
                >
                  <SocialIcons name="instagram" class="w-4 h-4" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Heading, Bio & CTAs -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        
        <!-- Super-badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-300 text-xs font-semibold w-fit mb-6 shadow-sm">
          <SocialIcons name="sparkles" class="w-4 h-4 text-gold-400" />
          <span>{hero.badge}</span>
        </div>

        <!-- Name & Tagline -->
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-6 leading-[1.1]">
          {hero.name}
        </h1>
        
        <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed mb-8">
          {hero.tagline}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 mb-10">
          <!-- Primary Explore Career -->
          <a
            href="#experiencia-interpretativa"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-gradient-to-r from-gold-600 via-amber-500 to-gold-400 text-dark-950 font-bold text-sm sm:text-base shadow-xl shadow-gold-500/20 hover:shadow-gold-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all"
          >
            <SocialIcons name="music" class="w-5 h-5 text-dark-950" />
            <span>{hero.ctaPrimary}</span>
          </a>

          <!-- Secondary Social / Channels Button -->
          <a
            href="#redes"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-dark-850 hover:bg-dark-800 text-slate-200 hover:text-gold-300 border border-dark-700 hover:border-gold-500/40 font-semibold text-sm sm:text-base transition-all"
          >
            <SocialIcons name="video" class="w-5 h-5 text-gold-400" />
            <span>{hero.ctaSocial}</span>
          </a>
        </div>

        <!-- Highlight Key Metrics Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-dark-800/80">
          {hero.highlights.map((item) => (
            <div class="p-3.5 rounded-xl bg-dark-900/60 border border-dark-800">
              <span class="block font-serif font-bold text-base sm:text-lg text-gold-300 mb-0.5">
                {item.value}
              </span>
              <span class="text-xs text-slate-400 font-medium">
                {item.label}
              </span>
            </div>
          ))}
        </div>

      </div>

    </div>

    <!-- Presentation Narrative Detail Section -->
    <div class="mt-20 pt-16 border-t border-dark-800/60">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-[2px] bg-gold-400"></div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">{presentation.subtitle}</span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-8">
          {presentation.title}
        </h2>

        <div class="space-y-6 text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          {presentation.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <!-- Quote Callout -->
        <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-dark-900 via-dark-850 to-dark-900 border-l-4 border-gold-500 shadow-xl relative overflow-hidden">
          <div class="text-gold-200/90 font-serif italic text-base sm:text-lg leading-relaxed">
            {presentation.quote}
          </div>
          <div class="mt-3 flex items-center gap-2 text-xs font-semibold text-gold-400">
            <span>— Javier Sáez</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
