---
import SocialIcons from './SocialIcons.astro';
import { getMethodsPaths, getSectionPaths, type SupportedLocale } from '../utils/i18n-routes';

interface Props {
  hero: {
    badge: string;
    name: string;
    tagline?: string;
    description?: string;
    ctaPrimary?: string;
    ctaSecondary?: string;
    ctaSocial?: string;
    highlights: Array<{ label: string; value: string }>;
  };
  presentation: {
    title: string;
    subtitle: string;
    paragraphs: string[];
    quote: string;
  };
  currentLocale: SupportedLocale;
}

const { hero, presentation, currentLocale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const methodsPaths = getMethodsPaths(currentLocale, base);
const sectionPaths = getSectionPaths(currentLocale, base);
---

<section id="presentacion" class="relative pt-12 pb-24 lg:pt-20 lg:pb-32 overflow-hidden">
  
  <!-- Subtle ambient glow in background -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-amber-500/10 via-gold-500/5 to-transparent blur-3xl -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Top Grid: Portrait + Main Bio Intro -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Artistic Portrait Image -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative group w-full max-w-md">
          
          <!-- Subtle sculptural frame -->
          <div class="absolute -inset-2 rounded-3xl bg-gradient-to-tr from-gold-500/20 via-amber-400/10 to-transparent blur-xl opacity-50 group-hover:opacity-80 transition-opacity duration-500"></div>
          
          <!-- Image container -->
          <div class="relative rounded-2xl overflow-hidden bg-dark-900 border border-gold-400/30 shadow-2xl">
            <img
              src={`${base}/images/javier-saez.jpg`}
              alt="Javier Sáez - Trombonista y Pedagogo Musical"
              class="w-full h-auto object-cover object-[50%_75%] aspect-[3/4] transform group-hover:scale-[1.015] transition-transform duration-500 ease-out"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1200"
              height="900"
            />
          </div>
        </div>
      </div>

      <!-- Right Column: Heading, Bio, Dual CTAs & Authority Ribbon -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        
        <!-- Super-badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/25 text-gold-300 text-xs font-semibold tracking-wide w-fit mb-6 shadow-sm">
          <SocialIcons name="sparkles" class="w-4 h-4 text-gold-400" />
          <span>{hero.badge}</span>
        </div>

        <!-- Fluid Name & Tagline -->
        <h1 class="font-serif text-[clamp(2.5rem,5vw,4.75rem)] font-bold tracking-[-0.02em] text-white mb-6 leading-[1.04] text-balance">
          {hero.name}
        </h1>
        
        <p class="text-base sm:text-lg lg:text-xl text-slate-300 font-normal leading-relaxed mb-8 max-w-[62ch] text-pretty">
          {hero.description || hero.tagline}
        </p>

        <!-- Dual Action Bar: Primary (Methods) & Secondary (Symphonic Career) -->
        <div class="flex flex-wrap items-center gap-3.5 mb-10">
          {hero.ctaPrimary && (
            <a
              href={methodsPaths.trilogy}
              class="inline-flex items-center justify-center gap-2.5 rounded-full bg-gradient-to-r from-gold-500 to-amber-500 hover:from-gold-400 hover:to-amber-400 text-dark-950 font-bold text-xs sm:text-sm px-6 py-3.5 shadow-lg shadow-gold-500/20 hover:-translate-y-0.5 transition-[transform,box-shadow,background-color] duration-200 focus:outline-none focus:ring-2 focus:ring-gold-400"
            >
              <span>{hero.ctaPrimary}</span>
              <span aria-hidden="true">→</span>
            </a>
          )}
          {hero.ctaSecondary && (
            <a
              href={sectionPaths.career}
              class="inline-flex items-center justify-center gap-2 rounded-full border border-gold-400/40 bg-dark-900/80 hover:bg-dark-850 hover:border-gold-400/80 text-slate-100 hover:text-gold-300 font-semibold text-xs sm:text-sm px-6 py-3.5 transition-[border-color,background-color,color] duration-200 focus:outline-none focus:ring-2 focus:ring-gold-400"
            >
              <span>{hero.ctaSecondary}</span>
            </a>
          )}
        </div>

        <!-- Editorial Authority Ribbon -->
        <div class="grid grid-cols-2 sm:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-dark-800 border-y border-dark-800/90 bg-dark-900/40 rounded-2xl overflow-hidden">
          {hero.highlights.map((item) => (
            <div class="p-4 flex flex-col justify-center">
              <span class="block font-serif font-bold text-base sm:text-lg text-gold-300 mb-0.5 leading-snug">
                {item.value}
              </span>
              <span class="text-xs text-slate-300/90 font-medium">
                {item.label}
              </span>
            </div>
          ))}
        </div>

      </div>

    </div>

    <!-- Presentation Narrative Detail Section -->
    <div class="mt-20 pt-16 border-t border-dark-800/60">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-[2px] bg-gold-400"></div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">{presentation.subtitle}</span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-8 text-balance">
          {presentation.title}
        </h2>

        <div class="space-y-6 text-base sm:text-lg text-slate-300 leading-relaxed font-normal max-w-[68ch] text-pretty">
          {presentation.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <!-- Quote Callout -->
        <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-dark-900 via-dark-850 to-dark-900 border-l-4 border-gold-500 shadow-xl relative overflow-hidden max-w-[68ch]">
          <div class="text-gold-200/90 font-serif italic text-base sm:text-lg leading-relaxed">
            {presentation.quote}
          </div>
          <div class="mt-3 flex items-center gap-2 text-xs font-semibold text-gold-400">
            <span>— Javier Sáez</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
