---
import SocialIcons from './SocialIcons.astro';
import { getAlternateLocalePath, getMethodsPaths, SUPPORTED_LOCALES, type SupportedLocale } from '../utils/i18n-routes';

interface Props {
  nav: {
    presentation: string;
    academic: string;
    masterclasses: string;
    performance: string;
    teaching: string;
    awards: string;
    methods?: string;
    social: string;
    contact?: string;
    langSwitch: string;
  };
  currentLocale: SupportedLocale;
}

const { nav, currentLocale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localeHome = `${base}/${currentLocale}`;
const methodsHref = getMethodsPaths(currentLocale, base).trilogy;

const methodsLabelMap: Record<SupportedLocale, string> = {
  es: 'Métodos',
  en: 'Methods',
  de: 'Methoden',
  it: 'Metodi',
};

const shortNavMap: Record<SupportedLocale, {
  presentation: string;
  academic: string;
  masterclasses: string;
  performance: string;
  teaching: string;
  awards: string;
}> = {
  es: {
    presentation: 'Inicio',
    academic: 'Formación',
    masterclasses: 'Masterclasses',
    performance: 'Interpretación',
    teaching: 'Docencia',
    awards: 'Premios',
  },
  en: {
    presentation: 'Home',
    academic: 'Education',
    masterclasses: 'Masterclasses',
    performance: 'Performance',
    teaching: 'Teaching',
    awards: 'Awards',
  },
  de: {
    presentation: 'Start',
    academic: 'Ausbildung',
    masterclasses: 'Meisterkurse',
    performance: 'Bühne',
    teaching: 'Lehre',
    awards: 'Preise',
  },
  it: {
    presentation: 'Home',
    academic: 'Formazione',
    masterclasses: 'Masterclass',
    performance: 'Concerti',
    teaching: 'Docenza',
    awards: 'Premi',
  },
};

const shortNav = shortNavMap[currentLocale] || shortNavMap.es;

const mobileMethodsSuffixMap: Record<SupportedLocale, string> = {
  es: 'Trombón Flexibilidad',
  en: 'Trombone Flexibility',
  de: 'Posaune Flexibilität',
  it: 'Trombone Flessibilità',
};
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-dark-950/80 border-b border-dark-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand / Logo -->
      <a href={`${base}/${currentLocale}`} class="group flex items-center gap-3 shrink-0 focus:outline-none focus:ring-2 focus:ring-gold-500 rounded-lg p-1">
        <div class="w-9 h-9 rounded-xl border border-gold-500/35 bg-dark-900/80 flex items-center justify-center text-gold-400 group-hover:border-gold-400/70 group-hover:text-gold-300 transition-colors">
          <!-- Clave de Fa en cuarta línea (proporción tipográfica musical clásica) -->
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M8.5 6.5C11.2 4.5 15.2 5.4 16 8.4C16.7 11.2 14.3 15.3 8.2 18.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            <circle cx="8.2" cy="8.5" r="1.7" fill="currentColor" />
            <circle cx="18.2" cy="7.5" r="1.15" fill="currentColor" />
            <circle cx="18.2" cy="11.5" r="1.15" fill="currentColor" />
          </svg>
        </div>
        <span class="font-serif text-lg font-bold tracking-tight text-slate-100 group-hover:text-gold-300 transition-colors whitespace-nowrap">
          Javier Sáez
        </span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden xl:flex items-center gap-5 text-sm font-medium text-slate-300 whitespace-nowrap" aria-label="Main Navigation">
        <a href={`${localeHome}/#presentacion`} class="hover:text-gold-400 transition-colors py-2">{shortNav.presentation}</a>
        <a href={`${localeHome}/#formacion-academica`} class="hover:text-gold-400 transition-colors py-2">{shortNav.academic}</a>
        <a href={`${localeHome}/#masterclasses`} class="hover:text-gold-400 transition-colors py-2">{shortNav.masterclasses}</a>
        <a href={`${localeHome}/#experiencia-interpretativa`} class="hover:text-gold-400 transition-colors py-2">{shortNav.performance}</a>
        <a href={`${localeHome}/#trayectoria-docente`} class="hover:text-gold-400 transition-colors py-2">{shortNav.teaching}</a>
        <a href={`${localeHome}/#premios`} class="hover:text-gold-400 transition-colors py-2">{shortNav.awards}</a>
        <a
          href={methodsHref}
          class="inline-flex items-center gap-1.5 rounded-full border border-gold-500/40 bg-gold-500/10 px-3.5 py-1 text-gold-400 hover:bg-gold-500/20 hover:text-white transition-colors"
        >
          <span>{nav.methods || methodsLabelMap[currentLocale] || 'Methods'}</span>
        </a>
      </nav>

      <!-- Right Action Bar -->
      <div class="hidden lg:flex items-center gap-4">
        
        <!-- Social Icons (@javi_trombone) -->
        <div class="flex items-center gap-2 pr-3 border-r border-dark-800">
          <a
            href="https://instagram.com/javi_trombone"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-slate-400 hover:text-pink-400 hover:bg-dark-850 rounded-lg transition-all focus:outline-none focus:ring-2 focus:ring-gold-500"
            title="Instagram @javi_trombone"
            aria-label="Instagram @javi_trombone"
          >
            <SocialIcons name="instagram" class="w-5 h-5" />
          </a>
          <a
            href="https://youtube.com/@javi_trombone"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-slate-400 hover:text-red-500 hover:bg-dark-850 rounded-lg transition-all focus:outline-none focus:ring-2 focus:ring-gold-500"
            title="YouTube @javi_trombone"
            aria-label="YouTube @javi_trombone"
          >
            <SocialIcons name="youtube" class="w-5 h-5" />
          </a>
        </div>

        <!-- Language Switcher -->
        <div class="flex items-center bg-dark-900 border border-dark-700/80 rounded-full p-1 text-xs font-semibold gap-1">
          {SUPPORTED_LOCALES.map((loc) => {
            const isCurrent = currentLocale === loc;
            const href = getAlternateLocalePath(Astro.url.pathname, loc, base);
            return (
              <a
                href={href}
                class={`px-2.5 py-1 rounded-full transition-all ${
                  isCurrent
                    ? 'bg-gradient-to-r from-gold-600 to-amber-500 text-dark-950 font-bold shadow-sm'
                    : 'text-slate-400 hover:text-slate-200'
                }`}
                aria-label={`Cambiar idioma a ${loc.toUpperCase()}`}
              >
                {loc.toUpperCase()}
              </a>
            );
          })}
        </div>

      </div>

      <!-- Mobile Menu Button and Controls -->
      <div class="flex items-center gap-3 lg:hidden">
        <!-- Mobile Language Switcher -->
        <div class="flex items-center bg-dark-900 border border-dark-700 rounded-full p-0.5 text-xs font-semibold gap-0.5">
          {SUPPORTED_LOCALES.map((loc) => {
            const isCurrent = currentLocale === loc;
            const href = getAlternateLocalePath(Astro.url.pathname, loc, base);
            return (
              <a
                href={href}
                class={`px-2 py-0.5 rounded-full ${
                  isCurrent ? 'bg-gold-500 text-dark-950 font-bold' : 'text-slate-400'
                }`}
              >
                {loc.toUpperCase()}
              </a>
            );
          })}
        </div>

        <!-- Mobile Hamburger Toggle -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2.5 rounded-lg text-slate-300 hover:text-white bg-dark-900 border border-dark-800 focus:outline-none focus:ring-2 focus:ring-gold-500"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú de navegación"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-dark-800 bg-dark-950/95 backdrop-blur-2xl px-4 pt-4 pb-6 space-y-4">
    <div class="flex flex-col space-y-3 text-base font-medium">
      <a href={`${localeHome}/#presentacion`} class="mobile-nav-link text-slate-300 hover:text-gold-400 py-2 border-b border-dark-900">{nav.presentation}</a>
      <a href={`${localeHome}/#formacion-academica`} class="mobile-nav-link text-slate-300 hover:text-gold-400 py-2 border-b border-dark-900">{nav.academic}</a>
      <a href={`${localeHome}/#masterclasses`} class="mobile-nav-link text-slate-300 hover:text-gold-400 py-2 border-b border-dark-900">{nav.masterclasses}</a>
      <a href={`${localeHome}/#experiencia-interpretativa`} class="mobile-nav-link text-slate-300 hover:text-gold-400 py-2 border-b border-dark-900">{nav.performance}</a>
      <a href={`${localeHome}/#trayectoria-docente`} class="mobile-nav-link text-slate-300 hover:text-gold-400 py-2 border-b border-dark-900">{nav.teaching}</a>
      <a href={`${localeHome}/#premios`} class="mobile-nav-link text-slate-300 hover:text-gold-400 py-2 border-b border-dark-900">{nav.awards}</a>
      <a href={methodsHref} class="mobile-nav-link text-gold-400 hover:text-white py-2 border-b border-dark-900 font-semibold">
        {nav.methods || methodsLabelMap[currentLocale] || 'Methods'} · {mobileMethodsSuffixMap[currentLocale] || 'Trombone Flexibility'}
      </a>
      <a href={`${localeHome}/#redes`} class="mobile-nav-link text-gold-400 py-2 flex items-center gap-2 border-b border-dark-900 font-semibold">
        <SocialIcons name="video" class="w-5 h-5 text-gold-400" />
        <span>{nav.social}</span>
      </a>
    </div>

    <!-- Mobile Social Actions -->
    <div class="pt-2 flex items-center justify-around border-t border-dark-900">
      <a
        href="https://instagram.com/javi_trombone"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-sm text-slate-400 hover:text-pink-400 py-2"
      >
        <SocialIcons name="instagram" class="w-5 h-5" />
        <span>Instagram</span>
      </a>
      <a
        href="https://youtube.com/@javi_trombone"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-sm text-slate-400 hover:text-red-500 py-2"
      >
        <SocialIcons name="youtube" class="w-5 h-5" />
        <span>YouTube</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && menu && openIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
