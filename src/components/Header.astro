---
import SocialIcons from './SocialIcons.astro';
import {
  getAlternateLocalePath,
  getMethodsPaths,
  getSectionPaths,
  SUPPORTED_LOCALES,
  type SupportedLocale,
} from '../utils/i18n-routes';

interface Props {
  nav: {
    presentation: string;
    academic: string;
    masterclasses: string;
    performance: string;
    teaching: string;
    awards: string;
    methods?: string;
    news?: string;
    social: string;
    contact?: string;
    langSwitch: string;
  };
  currentLocale: SupportedLocale;
}

const { nav, currentLocale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localeHome = `${base}/${currentLocale}`;
const sectionPaths = getSectionPaths(currentLocale, base);
const careerHref = sectionPaths.career;
const contactHref = sectionPaths.contact;
const methodsHref = getMethodsPaths(currentLocale, base).trilogy;
const methodsCatalogHref = getMethodsPaths(currentLocale, base).catalog;
const newsHref = `${localeHome}/#novedades`;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const cleanHome = localeHome.replace(/\/$/, '') || '/';
const isHomeActive = currentPath === cleanHome;
const isCareerActive = currentPath.startsWith(careerHref.replace(/\/$/, ''));
const isMethodsActive = currentPath.startsWith(methodsCatalogHref.replace(/\/$/, ''));
const isContactActive = currentPath.startsWith(contactHref.replace(/\/$/, ''));

const desktopPillBase = 'inline-flex items-center gap-1.5 rounded-full border px-4 py-1.5 text-xs sm:text-sm font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-gold-500 whitespace-nowrap';
const desktopPillActive = 'border-gold-400/60 bg-gradient-to-r from-gold-500/20 via-amber-500/15 to-gold-500/20 text-gold-300 hover:text-white hover:border-gold-300 hover:bg-gold-500/30 shadow-sm shadow-gold-500/10';
const desktopPillInactive = 'border-dark-700/80 bg-dark-900/60 text-slate-300 hover:text-gold-300 hover:border-gold-400/50 hover:bg-dark-850';

const mobilePillBase = 'mobile-nav-link flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border font-semibold text-center w-full transition-all';
const mobilePillActive = 'border-gold-400/60 bg-gradient-to-r from-gold-500/20 via-amber-500/15 to-gold-500/20 text-gold-300 hover:text-white hover:bg-gold-500/30 shadow-sm';
const mobilePillInactive = 'border-dark-800 bg-dark-900/60 text-slate-300 hover:text-gold-300 hover:border-gold-400/50';

const homeLabelMap: Record<SupportedLocale, string> = {
  es: 'Inicio',
  en: 'Home',
  de: 'Start',
  it: 'Home',
};

const newsLabelMap: Record<SupportedLocale, string> = {
  es: 'Novedades',
  en: 'News',
  de: 'Aktuelles',
  it: 'Novità',
};

const careerLabelMap: Record<SupportedLocale, string> = {
  es: 'Trayectoria',
  en: 'Career',
  de: 'Werdegang',
  it: 'Carriera',
};

const methodsLabelMap: Record<SupportedLocale, string> = {
  es: 'Métodos',
  en: 'Methods',
  de: 'Methoden',
  it: 'Metodi',
};

const contactLabelMap: Record<SupportedLocale, string> = {
  es: 'Contacto',
  en: 'Contact',
  de: 'Kontakt',
  it: 'Contatti',
};

const homeLabel = homeLabelMap[currentLocale] || 'Inicio';
const newsLabel = nav.news || newsLabelMap[currentLocale] || 'Novedades';
const careerLabel = careerLabelMap[currentLocale] || 'Trayectoria';
const methodsLabel = nav.methods || methodsLabelMap[currentLocale] || 'Métodos';
const contactLabel = contactLabelMap[currentLocale] || nav.contact || 'Contacto';

const careerLinks = [
  { href: `${careerHref}#formacion-academica`, label: nav.academic },
  { href: `${careerHref}#masterclasses`, label: nav.masterclasses },
  { href: `${careerHref}#experiencia-interpretativa`, label: nav.performance },
  { href: `${careerHref}#trayectoria-docente`, label: nav.teaching },
  { href: `${careerHref}#premios`, label: nav.awards },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-dark-950/80 border-b border-dark-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand / Logo (Limpie tipografía serif, sin iconos SVG/JS) -->
      <a
        href={localeHome}
        class="group flex items-center shrink-0 focus:outline-none focus:ring-2 focus:ring-gold-500 rounded-lg py-1 px-1.5"
        aria-label="Javier Sáez - Inicio"
      >
        <span class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-slate-100 group-hover:text-gold-300 transition-colors whitespace-nowrap">
          Javier Sáez
        </span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center gap-3 xl:gap-4 text-sm font-medium text-slate-300" aria-label="Main Navigation">
        <!-- 1) Inicio -->
        <a
          href={localeHome}
          data-nav-home="desktop"
          aria-current={isHomeActive ? 'page' : undefined}
          class={`${desktopPillBase} ${isHomeActive ? desktopPillActive : desktopPillInactive}`}
        >
          {homeLabel}
        </a>

        <!-- 2) Novedades -->
        <a
          href={newsHref}
          data-nav-news="desktop"
          class={`${desktopPillBase} ${desktopPillInactive}`}
        >
          {newsLabel}
        </a>

        <!-- 3) Trayectoria (Menú desplegable accesible) -->
        <div
          class={`relative group/dropdown inline-flex items-center rounded-full border transition-all ${
            isCareerActive
              ? 'border-gold-400/60 bg-gradient-to-r from-gold-500/20 via-amber-500/15 to-gold-500/20 text-gold-300 shadow-sm shadow-gold-500/10'
              : 'border-dark-700/80 bg-dark-900/60 text-slate-300 hover:border-gold-400/50 hover:bg-dark-850'
          }`}
          id="desktop-career-container"
        >
          <a
            href={careerHref}
            aria-current={isCareerActive ? 'page' : undefined}
            class={`inline-flex items-center pl-4 pr-1 py-1.5 text-xs sm:text-sm font-semibold transition-colors focus:outline-none whitespace-nowrap ${
              isCareerActive ? 'text-gold-300 hover:text-white' : 'text-slate-300 hover:text-gold-300'
            }`}
          >
            <span>{careerLabel}</span>
          </a>
          <button
            id="desktop-career-trigger"
            type="button"
            class={`inline-flex items-center py-1.5 pr-3 pl-1 transition-colors focus:outline-none cursor-pointer ${
              isCareerActive ? 'text-gold-300 hover:text-white' : 'text-slate-400 group-hover/dropdown:text-gold-300 hover:text-gold-300'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="desktop-career-menu"
            aria-label={`Desplegar submenú de ${careerLabel}`}
          >
            <svg
              class="w-4 h-4 text-slate-400 group-hover/dropdown:text-gold-400 group-hover/dropdown:rotate-180 group-focus-within/dropdown:rotate-180 transition-transform duration-200"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                clip-rule="evenodd"
              />
            </svg>
          </button>

          <!-- Dropdown panel -->
          <div
            id="desktop-career-menu"
            class="absolute top-full left-0 mt-2 w-72 rounded-xl bg-dark-950/95 backdrop-blur-2xl border border-dark-800 shadow-2xl p-2 opacity-0 invisible pointer-events-none group-hover/dropdown:opacity-100 group-hover/dropdown:visible group-hover/dropdown:pointer-events-auto group-focus-within/dropdown:opacity-100 group-focus-within/dropdown:visible group-focus-within/dropdown:pointer-events-auto transition-all duration-200 z-50 focus-within:opacity-100 focus-within:visible focus-within:pointer-events-auto"
            role="menu"
            aria-label={careerLabel}
          >
            {careerLinks.map((item) => (
              <a
                href={item.href}
                class="desktop-dropdown-link block px-3.5 py-2.5 rounded-lg text-sm text-slate-300 hover:text-gold-300 hover:bg-dark-900/90 focus:bg-dark-900/90 focus:text-gold-300 transition-colors focus:outline-none"
                role="menuitem"
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>

        <!-- 4) Métodos -->
        <a
          href={methodsHref}
          aria-current={isMethodsActive ? 'page' : undefined}
          class={`${desktopPillBase} ${isMethodsActive ? desktopPillActive : desktopPillInactive}`}
        >
          <span>{methodsLabel}</span>
        </a>

        <!-- 5) Contacto -->
        <a
          href={contactHref}
          aria-current={isContactActive ? 'page' : undefined}
          class={`${desktopPillBase} ${isContactActive ? desktopPillActive : desktopPillInactive}`}
        >
          {contactLabel}
        </a>
      </nav>

      <!-- Right Action Bar (Instagram/YouTube y selector ES · EN · DE · IT) -->
      <div class="hidden lg:flex items-center gap-4">
        
        <!-- Social Icons (@javi_trombone) -->
        <div class="flex items-center gap-2 pr-3 border-r border-dark-800">
          <a
            href="https://instagram.com/javi_trombone"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-slate-400 hover:text-pink-400 hover:bg-dark-850 rounded-lg transition-all focus:outline-none focus:ring-2 focus:ring-gold-500"
            title="Instagram @javi_trombone"
            aria-label="Instagram @javi_trombone"
          >
            <SocialIcons name="instagram" class="w-5 h-5" />
          </a>
          <a
            href="https://youtube.com/@javi_trombone"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-slate-400 hover:text-red-500 hover:bg-dark-850 rounded-lg transition-all focus:outline-none focus:ring-2 focus:ring-gold-500"
            title="YouTube @javi_trombone"
            aria-label="YouTube @javi_trombone"
          >
            <SocialIcons name="youtube" class="w-5 h-5" />
          </a>
        </div>

        <!-- Language Switcher -->
        <div class="flex items-center bg-dark-900 border border-dark-700/80 rounded-full p-1 text-xs font-semibold gap-1">
          {SUPPORTED_LOCALES.map((loc) => {
            const isCurrent = currentLocale === loc;
            const href = getAlternateLocalePath(Astro.url.pathname, loc, base);
            return (
              <a
                href={href}
                class={`px-2.5 py-1 rounded-full transition-all ${
                  isCurrent
                    ? 'bg-gradient-to-r from-gold-600 to-amber-500 text-dark-950 font-bold shadow-sm'
                    : 'text-slate-400 hover:text-slate-200'
                }`}
                aria-label={`Cambiar idioma a ${loc.toUpperCase()}`}
              >
                {loc.toUpperCase()}
              </a>
            );
          })}
        </div>

      </div>

      <!-- Mobile Menu Button and Controls -->
      <div class="flex items-center gap-3 lg:hidden">
        <!-- Mobile Language Switcher -->
        <div class="flex items-center bg-dark-900 border border-dark-700 rounded-full p-0.5 text-xs font-semibold gap-0.5">
          {SUPPORTED_LOCALES.map((loc) => {
            const isCurrent = currentLocale === loc;
            const href = getAlternateLocalePath(Astro.url.pathname, loc, base);
            return (
              <a
                href={href}
                class={`px-2 py-0.5 rounded-full ${
                  isCurrent ? 'bg-gold-500 text-dark-950 font-bold' : 'text-slate-400'
                }`}
              >
                {loc.toUpperCase()}
              </a>
            );
          })}
        </div>

        <!-- Mobile Hamburger Toggle -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2.5 rounded-lg text-slate-300 hover:text-white bg-dark-900 border border-dark-800 focus:outline-none focus:ring-2 focus:ring-gold-500"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú de navegación"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-dark-800 bg-dark-950/95 backdrop-blur-2xl px-4 pt-4 pb-6 space-y-4">
    <div class="flex flex-col space-y-3 text-base font-medium">
      
      <!-- 1) Inicio -->
      <a
        href={localeHome}
        data-nav-home="mobile"
        aria-current={isHomeActive ? 'page' : undefined}
        class={`${mobilePillBase} ${isHomeActive ? mobilePillActive : mobilePillInactive}`}
      >
        {homeLabel}
      </a>

      <!-- 2) Novedades -->
      <a
        href={newsHref}
        data-nav-news="mobile"
        class={`${mobilePillBase} ${mobilePillInactive}`}
      >
        {newsLabel}
      </a>

      <!-- 3) Trayectoria (Lista expandible con los 5 enlaces) -->
      <div>
        <div
          class={`flex items-center justify-between w-full rounded-xl border px-4 py-2 transition-all ${
            isCareerActive
              ? 'border-gold-400/60 bg-gradient-to-r from-gold-500/20 via-amber-500/15 to-gold-500/20 text-gold-300 shadow-sm'
              : 'border-dark-800 bg-dark-900/60 text-slate-300 hover:border-gold-400/50'
          }`}
        >
          <a
            href={careerHref}
            aria-current={isCareerActive ? 'page' : undefined}
            class={`mobile-nav-link font-semibold ${isCareerActive ? 'text-gold-300' : 'text-slate-300 hover:text-gold-300'}`}
          >
            {careerLabel}
          </a>
          <a
            href={careerHref}
            class="mobile-nav-link text-slate-300 hover:text-gold-400 font-medium"
          >
            {careerLabel}
          </a>
          <button
            id="mobile-career-toggle"
            type="button"
            class="p-1.5 text-slate-400 hover:text-gold-400 focus:outline-none cursor-pointer"
            aria-expanded="false"
            aria-controls="mobile-career-menu"
            aria-label={`Desplegar submenú de ${careerLabel}`}
          >
            <svg
              id="mobile-career-chevron"
              class="w-4 h-4 text-slate-400 transition-transform duration-200"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        </div>
        <div
          id="mobile-career-menu"
          class="hidden pl-3 py-1 space-y-1 bg-dark-900/50 rounded-lg mt-1 border border-dark-800/60"
        >
          {careerLinks.map((item) => (
            <a
              href={item.href}
              class="mobile-nav-link block text-sm text-slate-300 hover:text-gold-300 py-2 px-2 rounded-md hover:bg-dark-850 transition-colors"
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <!-- 4) Métodos -->
      <div>
        <a
          href={methodsHref}
          aria-current={isMethodsActive ? 'page' : undefined}
          class={`${mobilePillBase} ${isMethodsActive ? mobilePillActive : mobilePillInactive}`}
        >
          <span>{methodsLabel}</span>
        </a>
      </div>

      <!-- 5) Contacto -->
      <a
        href={contactHref}
        aria-current={isContactActive ? 'page' : undefined}
        class={`${mobilePillBase} ${isContactActive ? mobilePillActive : mobilePillInactive}`}
      >
        {contactLabel}
      </a>

    </div>

    <!-- Mobile Social Actions -->
    <div class="pt-2 flex items-center justify-around border-t border-dark-900">
      <a
        href="https://instagram.com/javi_trombone"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-sm text-slate-400 hover:text-pink-400 py-2"
      >
        <SocialIcons name="instagram" class="w-5 h-5" />
        <span>Instagram</span>
      </a>
      <a
        href="https://youtube.com/@javi_trombone"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-sm text-slate-400 hover:text-red-500 py-2"
      >
        <SocialIcons name="youtube" class="w-5 h-5" />
        <span>YouTube</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Control del menú móvil (hamburguesa)
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && menu && openIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Acordeón expandible para Trayectoria en móvil
  const careerToggleBtn = document.getElementById('mobile-career-toggle');
  const careerMenu = document.getElementById('mobile-career-menu');
  const careerChevron = document.getElementById('mobile-career-chevron');

  if (careerToggleBtn && careerMenu && careerChevron) {
    careerToggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = careerToggleBtn.getAttribute('aria-expanded') === 'true';
      careerToggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      careerMenu.classList.toggle('hidden');
      careerChevron.classList.toggle('rotate-180');
    });
  }

  // Accesibilidad de teclado para el menú desplegable de escritorio
  const desktopCareerTrigger = document.getElementById('desktop-career-trigger');
  const desktopCareerMenu = document.getElementById('desktop-career-menu');
  const desktopContainer = document.getElementById('desktop-career-container');
  const desktopLinks = document.querySelectorAll('.desktop-dropdown-link');

  if (desktopCareerTrigger && desktopCareerMenu && desktopContainer) {
    desktopCareerTrigger.addEventListener('click', () => {
      const isExpanded = desktopCareerTrigger.getAttribute('aria-expanded') === 'true';
      desktopCareerTrigger.setAttribute('aria-expanded', (!isExpanded).toString());
    });

    // Cerrar al pulsar Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        desktopCareerTrigger.setAttribute('aria-expanded', 'false');
        if (careerToggleBtn && careerMenu && !careerMenu.classList.contains('hidden')) {
          careerMenu.classList.add('hidden');
          careerToggleBtn.setAttribute('aria-expanded', 'false');
          careerChevron?.classList.remove('rotate-180');
        }
      }
    });

    // Cerrar al hacer clic en un enlace del dropdown
    desktopLinks.forEach((link) => {
      link.addEventListener('click', () => {
        desktopCareerTrigger.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Sincronizar estado activo entre Inicio y Novedades (#novedades)
  const syncNewsHashState = () => {
    const isNewsHash = window.location.hash === '#novedades';
    const homeDesktop = document.querySelector('[data-nav-home="desktop"]');
    const newsDesktop = document.querySelector('[data-nav-news="desktop"]');
    const homeMobile = document.querySelector('[data-nav-home="mobile"]');
    const newsMobile = document.querySelector('[data-nav-news="mobile"]');

    const activeDesktop = ['border-gold-400/60', 'bg-gradient-to-r', 'from-gold-500/20', 'via-amber-500/15', 'to-gold-500/20', 'text-gold-300', 'shadow-sm', 'shadow-gold-500/10'];
    const inactiveDesktop = ['border-dark-700/80', 'bg-dark-900/60', 'text-slate-300'];
    const activeMobile = ['border-gold-400/60', 'bg-gradient-to-r', 'from-gold-500/20', 'via-amber-500/15', 'to-gold-500/20', 'text-gold-300', 'shadow-sm'];
    const inactiveMobile = ['border-dark-800', 'bg-dark-900/60', 'text-slate-300'];

    if (homeDesktop && newsDesktop && (homeDesktop.getAttribute('aria-current') === 'page' || isNewsHash)) {
      if (isNewsHash) {
        homeDesktop.classList.remove(...activeDesktop);
        homeDesktop.classList.add(...inactiveDesktop);
        newsDesktop.classList.remove(...inactiveDesktop);
        newsDesktop.classList.add(...activeDesktop);
      } else if (homeDesktop.getAttribute('aria-current') === 'page') {
        newsDesktop.classList.remove(...activeDesktop);
        newsDesktop.classList.add(...inactiveDesktop);
        homeDesktop.classList.remove(...inactiveDesktop);
        homeDesktop.classList.add(...activeDesktop);
      }
    }

    if (homeMobile && newsMobile && (homeMobile.getAttribute('aria-current') === 'page' || isNewsHash)) {
      if (isNewsHash) {
        homeMobile.classList.remove(...activeMobile);
        homeMobile.classList.add(...inactiveMobile);
        newsMobile.classList.remove(...inactiveMobile);
        newsMobile.classList.add(...activeMobile);
      } else if (homeMobile.getAttribute('aria-current') === 'page') {
        newsMobile.classList.remove(...activeMobile);
        newsMobile.classList.add(...inactiveMobile);
        homeMobile.classList.remove(...inactiveMobile);
        homeMobile.classList.add(...activeMobile);
      }
    }
  };

  syncNewsHashState();
  window.addEventListener('hashchange', syncNewsHashState);
</script>
