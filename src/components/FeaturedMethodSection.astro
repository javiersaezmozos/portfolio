---
import SocialIcons from './SocialIcons.astro';
import { getMethodsPaths, type SupportedLocale } from '../utils/i18n-routes';

interface Props {
  currentLocale: SupportedLocale;
}

const { currentLocale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paths = getMethodsPaths(currentLocale, base);

const vol1Url = paths.vol1;
const trilogyUrl = paths.trilogy;
const catalogUrl = paths.catalog;
const registerUrl = paths.register;

const copyMap: Record<SupportedLocale, {
  eyebrow: string;
  heading: string;
  subheading: string;
  badge: string;
  highlights: string[];
  editionsLabel: string;
  editionKdp: string;
  editionKindle: string;
  ctaPrimary: string;
  ctaSecondary: string;
  ctaRegister: string;
  coverAuthor: string;
  coverTitle: string;
  coverSubtitle: string;
  coverVol: string;
  coverDesc: string;
  imgAlt: string;
}> = {
  es: {
    eyebrow: 'Nueva Publicación Pedagógica · COLECCIÓN METODOLOGÍA DE FLEXIBILIDAD',
    heading: 'Trombón · Flexibilidad — Volumen 1 (Elemental)',
    subheading:
      'Un método progresivo diseñado para Enseñanzas Elementales (2.º a 4.º curso, hasta Fa₄) con videopartituras interactivas y el asistente pedagógico TromBot.',
    badge: 'Lanzamiento Oficial en Amazon KDP y Amazon Kindle',
    highlights: [
      '3 Niveles y 12 Bloques: 120 ejercicios dobles en espejo (1.ª–7.ª posición) + 12 estudios melódicos.',
      'Grabado musical SMuFL Leland de 7,0 mm y tipografía Baskerville con margen interior de 20 mm para atril.',
      '15 Códigos QR interactivos hacia videopartituras en alta definición sin anuncios (subtítulos ES/EN/DE/IT).',
    ],
    editionsLabel: 'Ediciones disponibles en el lanzamiento:',
    editionKdp: 'Amazon KDP · Tapa Blanda',
    editionKindle: 'Amazon Kindle · Digital Print Replica',
    ctaPrimary: 'Ver Ficha y Comprar en Amazon',
    ctaSecondary: 'Probar Visor 3D y Audio',
    ctaRegister: 'Activar Ejemplar (/registro)',
    coverAuthor: 'Javier Sáez Mozos',
    coverTitle: 'FLEXIBILIDAD',
    coverSubtitle: 'MÉTODO DE TROMBÓN',
    coverVol: 'VOLUMEN 1 · ELEMENTAL',
    coverDesc: 'Desarrollo progresivo de la flexibilidad labial hasta Fa₄',
    imgAlt:
      'Portada de Flexibilidad Método de Trombón Volumen 1 Elemental: joven trombonista junto a TromBot IA',
  },
  en: {
    eyebrow: 'New Pedagogical Publication · FLEXIBILITY METHODOLOGY COLLECTION',
    heading: 'Trombone · Flexibility — Volume 1 (Elementary)',
    subheading:
      'A progressive method designed for elementary conservatory studies (up to F₄) featuring interactive video scores and the pedagogical assistant TromBot.',
    badge: 'Official Launch on Amazon KDP & Amazon Kindle',
    highlights: [
      '3 Levels & 12 Blocks: 120 double mirror exercises (1st–7th slide position) + 12 melodic etudes.',
      '7.0 mm SMuFL Leland engraving and Baskerville typography with a 20 mm inner music-stand safety margin.',
      '15 interactive QR codes linking to ad-free HD video scores with subtitles in ES, EN, DE, and IT.',
    ],
    editionsLabel: 'Available launch editions:',
    editionKdp: 'Amazon KDP · Paperback',
    editionKindle: 'Amazon Kindle · Print Replica Digital',
    ctaPrimary: 'View Edition & Buy on Amazon',
    ctaSecondary: 'Try 3D Book & Audio Lab',
    ctaRegister: 'Activate Copy (/registro)',
    coverAuthor: 'Javier Sáez Mozos',
    coverTitle: 'FLEXIBILIDAD',
    coverSubtitle: 'TROMBONE METHOD',
    coverVol: 'VOLUME 1 · ELEMENTARY',
    coverDesc: 'Progressive development of lip flexibility up to F₄',
    imgAlt:
      'Cover of Flexibility Trombone Method Volume 1 Elementary featuring a young trombonist with TromBot AI',
  },
  de: {
    eyebrow: 'Neue Pädagogische Publikation · KOLLEKTION FLEXIBILITÄTSMETHODIK',
    heading: 'Posaune · Flexibilität — Band 1 (Elementarstufe)',
    subheading:
      'Eine progressive Methode für die Elementarstufe (bis F₄) mit interaktiven Videopartituren und dem pädagogischen Assistenten TromBot.',
    badge: 'Offizieller Verkaufsstart auf Amazon KDP & Amazon Kindle',
    highlights: [
      '3 Niveaus & 12 Blöcke: 120 doppelte Spiegelübungen (1.–7. Zugposition) + 12 melodische Etüden.',
      '7,0-mm-Notenstich (SMuFL Leland & Baskerville) mit 20 mm atrilsicherem Bundsteg.',
      '15 interaktive QR-Codes zu werbefreien HD-Videopartituren (Untertitel ES/EN/DE/IT).',
    ],
    editionsLabel: 'Verfügbare Ausgaben zum Verkaufsstart:',
    editionKdp: 'Amazon KDP · Taschenbuch',
    editionKindle: 'Amazon Kindle · Digital Print Replica',
    ctaPrimary: 'Ausgabe ansehen & auf Amazon kaufen',
    ctaSecondary: '3D-Buch & Audio ausprobieren',
    ctaRegister: 'Exemplar aktivieren (/registro)',
    coverAuthor: 'Javier Sáez Mozos',
    coverTitle: 'FLEXIBILIDAD',
    coverSubtitle: 'POSAUNENMETHODE',
    coverVol: 'BAND 1 · ELEMENTARSTUFE',
    coverDesc: 'Progressive Entwicklung der Lippenflexibilität bis F₄',
    imgAlt:
      'Cover von Posaune Flexibilität Band 1 Elementarstufe mit TromBot KI',
  },
  it: {
    eyebrow: 'Nuova Pubblicazione Pedagogica · COLLEZIONE METODOLOGIA DI FLESSIBILITÀ',
    heading: 'Trombone · Flessibilità — Volume 1 (Elementare)',
    subheading:
      'Un metodo progressivo per i corsi elementari (fino a Fa₄) con videopartiture interattive e l\'assistente didattico TromBot.',
    badge: 'Lancio Ufficiale su Amazon KDP e Amazon Kindle',
    highlights: [
      '3 Livelli & 12 Blocchi: 120 esercizi doppi a specchio (1ª–7ª posizione) + 12 studi melodici.',
      'Incisione musicale da 7,0 mm (SMuFL Leland e Baskerville) con margine interno da 20 mm.',
      '15 codici QR interattivi verso videopartiture HD senza annunci (sottotitoli ES/EN/DE/IT).',
    ],
    editionsLabel: 'Edizioni disponibili al lancio:',
    editionKdp: 'Amazon KDP · Copertina Flessibile',
    editionKindle: 'Amazon Kindle · Digital Print Replica',
    ctaPrimary: 'Vedi Scheda e Acquista su Amazon',
    ctaSecondary: 'Prova il Libro 3D e Audio',
    ctaRegister: 'Attiva Copia (/registro)',
    coverAuthor: 'Javier Sáez Mozos',
    coverTitle: 'FLEXIBILIDAD',
    coverSubtitle: 'METODO PER TROMBONE',
    coverVol: 'VOLUME 1 · ELEMENTARE',
    coverDesc: 'Sviluppo progressivo della flessibilità labiale fino a Fa₄',
    imgAlt:
      'Copertina di Trombone Flessibilità Volume 1 Elementare con TromBot IA',
  },
};

const catalogLinkLabelMap: Record<SupportedLocale, string> = {
  es: 'Catálogo de Métodos (Vol. 1–2)',
  en: 'Methods Catalog (Vol. 1–2)',
  de: 'Methodenkatalog (Bd. 1–2)',
  it: 'Catalogo Metodi (Vol. 1–2)',
};

const copy = copyMap[currentLocale] || copyMap.es;
---

<section
  id="publicaciones"
  aria-labelledby="featured-method-heading"
  class="py-16 lg:py-24 bg-dark-950/90 border-t border-dark-800/80 relative overflow-hidden"
>
  <div class="pointer-events-none absolute -top-40 right-10 w-96 h-96 bg-copper/10 rounded-full blur-3xl -z-10"></div>
  <div class="pointer-events-none absolute -bottom-40 left-10 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <article class="relative rounded-3xl border border-dark-700/80 bg-gradient-to-br from-dark-900/90 via-dark-900/70 to-dark-950/90 p-6 sm:p-10 lg:p-12 shadow-2xl backdrop-blur-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Preview Cubierta 3D Estilo Portada Física -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="featured-book-wrap relative group w-full max-w-xs sm:max-w-sm">
            <div class="absolute -inset-2 rounded-2xl bg-gradient-to-tr from-copper-base via-copper to-gold-regal opacity-20 blur-xl group-hover:opacity-40 transition-opacity duration-700"></div>

            <div class="featured-book-card relative rounded-xl border border-copper/40 bg-graphite-base p-5 shadow-book-3d text-white flex flex-col justify-between aspect-[1/1.33]">
              <div class="text-center pt-2">
                <p class="font-serif text-[11px] font-medium tracking-[0.14em] text-white/90">
                  {copy.coverAuthor}
                </p>
                <h3 class="mt-2 font-serif text-2xl sm:text-3xl font-bold tracking-[0.18em] uppercase text-gradient-copper">
                  {copy.coverTitle}
                </h3>
                <p class="mt-0.5 font-serif text-[10px] font-semibold tracking-[0.24em] text-slate-200 uppercase">
                  {copy.coverSubtitle}
                </p>
                <div class="mt-2 inline-block rounded-full border border-copper/50 bg-copper/15 px-3 py-0.5 text-[10px] font-mono uppercase tracking-wider text-copper-light">
                  {copy.coverVol}
                </div>
                <p class="mt-2 font-serif italic text-[11px] text-slate-300">
                  {copy.coverDesc}
                </p>
              </div>

              <div class="relative my-2 rounded-lg overflow-hidden border border-white/10 bg-black/40 aspect-[4/3]">
                <img
                  src={`${base}/images/metodos/portada-duo-trombot.jpg`}
                  alt={copy.imgAlt}
                  class="h-full w-full object-cover object-center"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="pt-2 border-t border-white/10 flex items-center justify-between text-[10px] font-mono text-slate-300">
                <span>AMAZON KDP &amp; KINDLE</span>
                <span class="text-copper-light font-bold">15 QR CODES</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Columna de Información Editorial y CTAs -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-copper/40 bg-copper/10 px-3 py-1 text-xs font-mono uppercase tracking-wider text-copper-light">
                <span class="h-2 w-2 rounded-full bg-copper"></span>
                {copy.eyebrow}
              </span>
              <span class="inline-flex items-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-mono text-emerald-300">
                {copy.badge}
              </span>
            </div>

            <h2
              id="featured-method-heading"
              class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white"
            >
              {copy.heading}
            </h2>

            <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl">
              {copy.subheading}
            </p>
          </div>

          <!-- Puntos destacados de edición -->
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-200">
            {copy.highlights.map((point) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-copper/20 text-copper-light text-[10px]">
                  ✓
                </span>
                <span>{point}</span>
              </li>
            ))}
          </ul>

          <!-- Canales oficiales de lanzamiento -->
          <div class="rounded-2xl border border-dark-700 bg-dark-950/60 p-4 space-y-2">
            <p class="text-xs font-mono uppercase tracking-wider text-slate-400">
              {copy.editionsLabel}
            </p>
            <div class="flex flex-wrap gap-2 text-xs">
              <span class="rounded-lg border border-copper/30 bg-copper/10 px-3 py-1.5 font-mono text-copper-light">
                📦 {copy.editionKdp}
              </span>
              <span class="rounded-lg border border-copper/30 bg-copper/10 px-3 py-1.5 font-mono text-copper-light">
                📱 {copy.editionKindle}
              </span>
            </div>
          </div>

          <!-- CTAs Primario, Secundario y Registro -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href={vol1Url}
              class="inline-flex items-center gap-2 rounded-xl bg-copper px-5 py-3 text-xs sm:text-sm font-bold text-graphite-deep shadow-lg hover:bg-copper-light transition-colors focus:outline-none focus:ring-2 focus:ring-gold-regal"
            >
              <span>{copy.ctaPrimary}</span>
              <span aria-hidden="true">→</span>
            </a>

            <a
              href={trilogyUrl}
              class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-xs sm:text-sm font-medium text-white hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-regal"
            >
              <span>{copy.ctaSecondary}</span>
            </a>

            <a
              href={registerUrl}
              class="inline-flex items-center gap-1.5 rounded-xl border border-copper/40 bg-copper/10 px-4 py-3 text-xs font-mono text-copper-light hover:bg-copper/20 transition-colors"
            >
              <span>{copy.ctaRegister}</span>
              <span aria-hidden="true">↗</span>
            </a>

            <a
              href={catalogUrl}
              class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-mono text-slate-400 hover:text-white transition-colors"
            >
              <span>{catalogLinkLabelMap[currentLocale] || catalogLinkLabelMap.es}</span>
            </a>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .featured-book-wrap {
    perspective: 1100px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-book-card {
      transform: rotateY(-8deg) rotateX(2deg);
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .featured-book-wrap:hover .featured-book-card {
      transform: rotateY(-2deg) rotateX(0deg) scale(1.02);
    }
  }

  .text-gradient-copper {
    background: linear-gradient(135deg, #FFF3E6 0%, #E89758 45%, #B85D32 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
