---
import SocialIcons from './SocialIcons.astro';
import { getMethodsPaths, type SupportedLocale } from '../utils/i18n-routes';

interface Props {
  currentLocale: SupportedLocale;
}

const { currentLocale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paths = getMethodsPaths(currentLocale, base);

const vol1Url = paths.vol1;
const trilogyUrl = paths.trilogy;

const copyMap: Record<SupportedLocale, {
  eyebrow: string;
  heading: string;
  subheading: string;
  badge: string;
  highlights: string[];
  editionsLabel: string;
  editionKdp: string;
  editionKindle: string;
  ctaPrimary: string;
  ctaSecondary: string;
  toggleFront: string;
  toggleBack: string;
  imgAlt: string;
  backImgAlt: string;
}> = {
  es: {
    eyebrow: 'Nueva Publicación Pedagógica · COLECCIÓN METODOLOGÍA DE FLEXIBILIDAD',
    heading: 'Trombón · Flexibilidad — Volumen 1 (Elemental)',
    subheading:
      'Método diseñado para el desarrollo progresivo, con rigor técnico-interpretativo, de la flexibilidad labial hasta Fa₄ en tres niveles, pensado cada uno para un curso escolar.',
    badge: 'Lanzamiento Oficial: Mayo–Junio de 2027',
    highlights: [
      'Estructura por nivel: 30 ejercicios dobles en cada nivel, estudios de consolidación y bloque de ampliación.',
      'Asistente visual: TromBot irá recordando las ideas principales durante todo el recorrido por los tres niveles.',
      'Contenido multimedia: audios de ejemplo, videopartituras con metrónomo para estudio individual y videopartituras de pregunta-respuesta conmigo.',
    ],
    editionsLabel: 'Ediciones oficiales · Lanzamiento previsto para mayo–junio de 2027:',
    editionKdp: 'Amazon KDP · Tapa Blanda',
    editionKindle: 'Amazon Kindle · Digital Print Replica',
    ctaPrimary: 'Ver ficha del Volumen 1',
    ctaSecondary: 'Ver colección (Vol. 1–2)',
    toggleFront: 'Portada',
    toggleBack: 'Contraportada',
    imgAlt:
      'Portada oficial de Flexibilidad, Método de Trombón Volumen 1 Elemental por Javier Sáez Mozos',
    backImgAlt:
      'Contraportada oficial de Flexibilidad, Método de Trombón Volumen 1 Elemental con TromBot',
  },
  en: {
    eyebrow: 'New Pedagogical Publication · FLEXIBILITY METHODOLOGY COLLECTION',
    heading: 'Trombone · Flexibility — Volume 1 (Elementary)',
    subheading:
      'A method designed for the progressive development of lip flexibility up to F₄ with technical and interpretive rigor across three levels, each structured for one academic year.',
    badge: 'Official Launch: May–June 2027',
    highlights: [
      'Structure per level: 30 double exercises per level, consolidation etudes, and an extension block.',
      'Visual assistant: TromBot highlights the key technical ideas throughout all three levels.',
      'Multimedia content: reference audio recordings, video-scores with metronome for solo practice, and call-and-response video-scores with me.',
    ],
    editionsLabel: 'Official editions · Scheduled launch for May–June 2027:',
    editionKdp: 'Amazon KDP · Paperback',
    editionKindle: 'Amazon Kindle · Print Replica Digital',
    ctaPrimary: 'View Volume 1 details',
    ctaSecondary: 'View collection (Vol. 1–2)',
    toggleFront: 'Front cover',
    toggleBack: 'Back cover',
    imgAlt:
      'Official front cover of Flexibility Trombone Method Volume 1 Elementary by Javier Sáez Mozos',
    backImgAlt:
      'Official back cover of Flexibility Trombone Method Volume 1 Elementary featuring TromBot',
  },
  de: {
    eyebrow: 'Neue Pädagogische Publikation · KOLLEKTION FLEXIBILITÄTSMETHODIK',
    heading: 'Posaune · Flexibilität — Band 1 (Elementarstufe)',
    subheading:
      'Eine Methode zur progressiven Entwicklung der Lippenflexibilität bis F₄ mit technischer und interpretatorischer Präzision in drei Stufen, jeweils ausgelegt für ein Schuljahr.',
    badge: 'Offizieller Verkaufsstart: Mai–Juni 2027',
    highlights: [
      'Aufbau pro Stufe: 30 Doppelübungen pro Stufe, Konsolidierungsetüden und ein Erweiterungsblock.',
      'Visueller Assistent: TromBot erinnert auf dem gesamten Weg durch alle drei Stufen an die wichtigsten Grundideen.',
      'Multimedia-Inhalte: Referenz-Audios, Videopartituren mit Metronom für das Einzelstudium sowie Frage-Antwort-Videopartituren mit mir.',
    ],
    editionsLabel: 'Offizielle Ausgaben · Geplanter Verkaufsstart für Mai–Juni 2027:',
    editionKdp: 'Amazon KDP · Taschenbuch',
    editionKindle: 'Amazon Kindle · Digital Print Replica',
    ctaPrimary: 'Band 1 im Detail ansehen',
    ctaSecondary: 'Reihe ansehen (Bd. 1–2)',
    toggleFront: 'Titelseite',
    toggleBack: 'Rückseite',
    imgAlt:
      'Offizielles Cover von Flexibilität Posaunenmethode Band 1 Elementarstufe von Javier Sáez Mozos',
    backImgAlt:
      'Offizielle Rückseite von Flexibilität Posaunenmethode Band 1 Elementarstufe mit TromBot',
  },
  it: {
    eyebrow: 'Nuova Pubblicazione Pedagogica · COLLEZIONE METODOLOGIA DI FLESSIBILITÀ',
    heading: 'Trombone · Flessibilità — Volume 1 (Elementare)',
    subheading:
      'Un metodo progettato per lo sviluppo progressivo della flessibilità labiale fino a Fa₄ con rigore tecnico-interpretativo in tre livelli, ciascuno pensato per un anno scolastico.',
    badge: 'Lancio Ufficiale: Maggio–Giugno 2027',
    highlights: [
      'Struttura per livello: 30 esercizi doppi per livello, studi di consolidamento e blocco di ampliamento.',
      'Assistente visivo: TromBot ricorda le idee principali lungo tutto il percorso attraverso i tre livelli.',
      'Contenuti multimediali: audio di riferimento, videopartiture con metronomo per lo studio individuale e videopartiture domanda-risposta con me.',
    ],
    editionsLabel: 'Edizioni ufficiali · Lancio previsto per maggio–giugno 2027:',
    editionKdp: 'Amazon KDP · Copertina Flessibile',
    editionKindle: 'Amazon Kindle · Digital Print Replica',
    ctaPrimary: 'Vedi scheda del Volume 1',
    ctaSecondary: 'Vedi collezione (Vol. 1–2)',
    toggleFront: 'Copertina',
    toggleBack: 'Retro',
    imgAlt:
      'Copertina ufficiale di Flessibilità Metodo per Trombone Volume 1 Elementare di Javier Sáez Mozos',
    backImgAlt:
      'Retro di copertina ufficiale di Flessibilità Metodo per Trombone Volume 1 Elementare con TromBot',
  },
};

const copy = copyMap[currentLocale] || copyMap.es;
---

<section
  id="novedades"
  aria-labelledby="featured-method-heading"
  class="py-16 lg:py-24 bg-dark-950/90 border-t border-dark-800/80 relative overflow-hidden scroll-mt-20"
>
  <div class="pointer-events-none absolute -top-40 right-10 w-96 h-96 bg-copper/10 rounded-full blur-3xl -z-10"></div>
  <div class="pointer-events-none absolute -bottom-40 left-10 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <article class="relative rounded-3xl border border-dark-700/80 bg-gradient-to-br from-dark-900/90 via-dark-900/70 to-dark-950/90 p-6 sm:p-10 lg:p-12 shadow-2xl backdrop-blur-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Portada y Contraportada Definitivas del Volumen 1 -->
        <div class="lg:col-span-5 flex flex-col items-center gap-4">
          <div class="featured-book-wrap relative group w-full max-w-xs sm:max-w-sm" data-cover-viewer>
            <div class="absolute -inset-2 rounded-2xl bg-gradient-to-tr from-copper-base via-copper to-gold-regal opacity-20 blur-xl group-hover:opacity-40 transition-opacity duration-700"></div>

            <div class="featured-book-card relative rounded-xl overflow-hidden border border-copper/40 bg-[#0B0C0E] shadow-book-3d aspect-[3/4]">
              <picture data-cover-front transition:name="book-cover-vol1" class="block h-full w-full transition-opacity duration-300">
                <source srcset={`${base}/images/metodos/vol1-portada.webp`} type="image/webp" />
                <img
                  src={`${base}/images/metodos/vol1-portada.jpg`}
                  alt={copy.imgAlt}
                  width="800"
                  height="1035"
                  class="h-full w-full object-cover object-center"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <picture data-cover-back class="absolute inset-0 block h-full w-full opacity-0 pointer-events-none transition-opacity duration-300">
                <source srcset={`${base}/images/metodos/vol1-contraportada.webp`} type="image/webp" />
                <img
                  src={`${base}/images/metodos/vol1-contraportada.jpg`}
                  alt={copy.backImgAlt}
                  width="800"
                  height="1035"
                  class="h-full w-full object-cover object-center"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
          </div>

          <div class="inline-flex items-center rounded-full border border-dark-700 bg-dark-950/80 p-1 text-xs font-mono" role="group" aria-label="Vista de cubierta">
            <button
              type="button"
              data-cover-btn="front"
              aria-pressed="true"
              class="rounded-full px-3.5 py-1 transition-colors bg-copper text-graphite-deep font-semibold"
            >
              {copy.toggleFront}
            </button>
            <button
              type="button"
              data-cover-btn="back"
              aria-pressed="false"
              class="rounded-full px-3.5 py-1 transition-colors text-slate-300 hover:text-white"
            >
              {copy.toggleBack}
            </button>
          </div>
        </div>

        <!-- Columna de Información Editorial y CTAs -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-copper/40 bg-copper/10 px-3 py-1 text-xs font-mono uppercase tracking-wider text-copper-light">
                <span class="h-2 w-2 rounded-full bg-copper"></span>
                {copy.eyebrow}
              </span>
              <span class="inline-flex items-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-mono text-emerald-300">
                {copy.badge}
              </span>
            </div>

            <h2
              id="featured-method-heading"
              class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white"
            >
              {copy.heading}
            </h2>

            <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl">
              {copy.subheading}
            </p>
          </div>

          <!-- Puntos destacados de edición -->
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-200">
            {copy.highlights.map((point) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-copper/20 text-copper-light text-[10px]">
                  ✓
                </span>
                <span>{point}</span>
              </li>
            ))}
          </ul>

          <!-- Canales oficiales de lanzamiento -->
          <div class="rounded-2xl border border-dark-700 bg-dark-950/60 p-4 space-y-2">
            <p class="text-xs font-mono uppercase tracking-wider text-slate-400">
              {copy.editionsLabel}
            </p>
            <div class="flex flex-wrap gap-2 text-xs">
              <span class="rounded-lg border border-copper/30 bg-copper/10 px-3 py-1.5 font-mono text-copper-light">
                📦 {copy.editionKdp}
              </span>
              <span class="rounded-lg border border-copper/30 bg-copper/10 px-3 py-1.5 font-mono text-copper-light">
                📱 {copy.editionKindle}
              </span>
            </div>
          </div>

          <!-- CTAs Primario y Secundario -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href={vol1Url}
              class="inline-flex items-center gap-2 rounded-xl bg-copper px-5 py-3 text-xs sm:text-sm font-bold text-graphite-deep shadow-lg hover:bg-copper-light transition-colors focus:outline-none focus:ring-2 focus:ring-gold-regal"
            >
              <span>{copy.ctaPrimary}</span>
              <span aria-hidden="true">→</span>
            </a>

            <a
              href={trilogyUrl}
              class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-xs sm:text-sm font-medium text-white hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-regal"
            >
              <span>{copy.ctaSecondary}</span>
            </a>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .featured-book-wrap {
    perspective: 1100px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-book-card {
      transform: rotateY(-8deg) rotateX(2deg);
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .featured-book-wrap:hover .featured-book-card {
      transform: rotateY(-2deg) rotateX(0deg) scale(1.02);
    }
  }

  .text-gradient-copper {
    background: linear-gradient(135deg, #FFF3E6 0%, #E89758 45%, #B85D32 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>

<script>
  function initFeaturedMethodCover() {
    try {
      document.querySelectorAll<HTMLElement>('#novedades').forEach((section) => {
        if (section.dataset.initialized === 'true') return;
        section.dataset.initialized = 'true';

        const frontImg = section.querySelector<HTMLImageElement>('[data-cover-front]');
        const backImg = section.querySelector<HTMLImageElement>('[data-cover-back]');
        const frontBtn = section.querySelector<HTMLButtonElement>('[data-cover-btn="front"]');
        const backBtn = section.querySelector<HTMLButtonElement>('[data-cover-btn="back"]');
        if (!frontImg || !backImg || !frontBtn || !backBtn) return;

        const setSide = (side: 'front' | 'back') => {
          const showFront = side === 'front';
          frontImg.classList.toggle('opacity-0', !showFront);
          frontImg.classList.toggle('pointer-events-none', !showFront);
          backImg.classList.toggle('opacity-0', showFront);
          backImg.classList.toggle('pointer-events-none', showFront);

          frontBtn.setAttribute('aria-pressed', String(showFront));
          backBtn.setAttribute('aria-pressed', String(!showFront));

          frontBtn.classList.toggle('bg-copper', showFront);
          frontBtn.classList.toggle('text-graphite-deep', showFront);
          frontBtn.classList.toggle('font-semibold', showFront);
          frontBtn.classList.toggle('text-slate-300', !showFront);

          backBtn.classList.toggle('bg-copper', !showFront);
          backBtn.classList.toggle('text-graphite-deep', !showFront);
          backBtn.classList.toggle('font-semibold', !showFront);
          backBtn.classList.toggle('text-slate-300', showFront);
        };

        frontBtn.addEventListener('click', () => setSide('front'));
        backBtn.addEventListener('click', () => setSide('back'));
      });
    } catch (err) {
      console.error('[FeaturedMethodSection] Error initializing cover toggle:', err);
    }
  }

  initFeaturedMethodCover();
  document.addEventListener('astro:page-load', initFeaturedMethodCover);
</script>
