---
import SocialIcons from './SocialIcons.astro';
import type { SupportedLocale } from '../utils/i18n-routes';

interface Props {
  masterclasses: {
    title: string;
    subtitle: string;
    description: string;
    teachers: Array<{
      name: string;
      role: string;
      institution: string;
    }>;
  };
  currentLocale: SupportedLocale;
}

const { masterclasses, currentLocale } = Astro.props;
---

<section id="masterclasses" class="py-20 lg:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-300 text-xs font-semibold mb-3">
        <SocialIcons name="music" class="w-4 h-4 text-gold-400" />
        <span>{masterclasses.subtitle}</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-4">
        {masterclasses.title}
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {masterclasses.description}
      </p>
    </div>

    <!-- Masterclasses Editorial Roster (High-Density Two-Column Index) -->
    <div class="rounded-3xl bg-dark-900/70 border border-dark-800/90 p-4 sm:p-8 shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 lg:gap-x-10 divide-y lg:divide-y-0 divide-dark-800/80">
        {masterclasses.teachers.map((t, idx) => (
          <div class="py-3.5 px-3 rounded-xl hover:bg-dark-850/80 border-b border-dark-800/70 last:border-b-0 flex flex-col sm:flex-row sm:items-center justify-between gap-2 group transition-colors duration-200">
            <div class="flex items-baseline gap-3 min-w-0">
              <span class="font-mono text-xs text-gold-400/80 shrink-0">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <h3 class="font-serif font-bold text-slate-100 group-hover:text-gold-300 group-hover:translate-x-0.5 transition-[color,transform] duration-200 text-base truncate">
                  {t.name}
                </h3>
                <p class="text-xs font-medium text-gold-400/90 truncate">
                  {t.role}
                </p>
              </div>
            </div>
            <span class="text-xs font-mono text-slate-300/90 bg-dark-950/70 border border-dark-800 px-2.5 py-1 rounded-md shrink-0 w-fit">
              {t.institution}
            </span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
