---
import SocialIcons from './SocialIcons.astro';

interface Props {
  masterclasses: {
    title: string;
    subtitle: string;
    description: string;
    teachers: Array<{
      name: string;
      role: string;
      institution: string;
    }>;
  };
  currentLocale: 'es' | 'en';
}

const { masterclasses, currentLocale } = Astro.props;
---

<section id="masterclasses" class="py-20 lg:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-300 text-xs font-semibold mb-3">
        <SocialIcons name="music" class="w-4 h-4 text-gold-400" />
        <span>{masterclasses.subtitle}</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-4">
        {masterclasses.title}
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {masterclasses.description}
      </p>
    </div>

    <!-- Masterclasses Teachers Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {masterclasses.teachers.map((t) => (
        <div class="p-5 rounded-2xl bg-dark-900/80 border border-dark-800 hover:border-gold-500/40 hover:bg-dark-850/90 transition-all group flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-8 h-8 rounded-full bg-dark-800 border border-dark-700 flex items-center justify-center text-gold-400 group-hover:bg-gold-500/10 group-hover:border-gold-500/30 transition-colors">
                <SocialIcons name="music" class="w-4 h-4" />
              </div>
              <h3 class="font-serif font-bold text-slate-100 group-hover:text-gold-300 transition-colors text-base">
                {t.name}
              </h3>
            </div>
            <p class="text-xs font-semibold text-gold-400/90 mb-1">
              {t.role}
            </p>
          </div>
          <p class="text-[11px] text-slate-400 mt-2 pt-2 border-t border-dark-800">
            {t.institution}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
