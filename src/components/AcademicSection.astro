---
import SocialIcons from './SocialIcons.astro';

interface Props {
  academic: {
    title: string;
    subtitle: string;
    tripleMaster: {
      title: string;
      description: string;
      items: Array<{
        degree: string;
        institution: string;
        year: string;
        focus: string;
      }>;
    };
    higherDegrees: Array<{
      degree: string;
      institution: string;
      year: string;
      honors?: string;
      professor?: string;
      type: string;
    }>;
  };
  currentLocale: 'es' | 'en';
}

const { academic, currentLocale } = Astro.props;
---

<section id="formacion-academica" class="py-20 lg:py-28 bg-dark-900/40 border-t border-dark-800/80 relative">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-300 text-xs font-semibold mb-3">
        <SocialIcons name="academic" class="w-4 h-4 text-gold-400" />
        <span>{academic.subtitle}</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        {academic.title}
      </h2>
    </div>

    <!-- 1. Triple Master Showcase Card -->
    <div class="mb-16">
      <div class="rounded-3xl bg-gradient-to-b from-dark-850 to-dark-900 border border-gold-500/30 p-6 sm:p-10 shadow-2xl relative overflow-hidden">
        
        <!-- Glow accent -->
        <div class="absolute -right-20 -top-20 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-dark-700/80">
          <div>
            <div class="flex items-center gap-2 text-gold-400 text-xs font-bold uppercase tracking-widest mb-1">
              <SocialIcons name="sparkles" class="w-4 h-4" />
              <span>{currentLocale === 'es' ? 'Especialización Universitaria' : 'University Specialization'}</span>
            </div>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white">
              {academic.tripleMaster.title}
            </h3>
          </div>
          <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-gold-500/20 text-gold-300 border border-gold-400/40 text-xs font-bold w-fit">
            UAX • UNIR • UCM
          </span>
        </div>

        <p class="text-slate-300 text-sm sm:text-base mb-8 max-w-3xl">
          {academic.tripleMaster.description}
        </p>

        <!-- Triple Master 3-Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {academic.tripleMaster.items.map((item, idx) => (
            <div class="flex flex-col justify-between p-6 rounded-2xl bg-dark-950/80 border border-dark-800 hover:border-gold-500/40 transition-all group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-dark-800 text-gold-400 border border-dark-700">
                    {item.year}
                  </span>
                  <span class="text-xs text-slate-500 font-mono">0{idx + 1}</span>
                </div>
                <h4 class="font-serif font-bold text-base sm:text-lg text-slate-100 group-hover:text-gold-300 transition-colors mb-2 leading-snug">
                  {item.degree}
                </h4>
                <p class="text-xs sm:text-sm font-semibold text-gold-400/90 mb-3">
                  {item.institution}
                </p>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed border-t border-dark-850 pt-3 mt-2">
                {item.focus}
              </p>
            </div>
          ))}
        </div>

      </div>
    </div>

    <!-- 2. Conservatorio Superior y Grados Profesionales -->
    <div class="space-y-6">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-6 h-[2px] bg-gold-400"></div>
        <h3 class="font-serif text-xl sm:text-2xl font-bold text-white">
          {currentLocale === 'es' ? 'Titulaciones Superiores y Conservatorio' : 'Higher Degrees & Conservatory Qualifications'}
        </h3>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {academic.higherDegrees.map((deg) => (
          <div class="p-6 sm:p-8 rounded-2xl bg-dark-900/90 border border-dark-800 hover:border-gold-500/40 shadow-lg flex flex-col justify-between transition-all group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-dark-800 text-gold-400 border border-dark-700">
                  {deg.type}
                </span>
                <span class="text-xs font-bold text-slate-400 font-mono">
                  {deg.year}
                </span>
              </div>

              <h4 class="font-serif text-lg sm:text-xl font-bold text-white group-hover:text-gold-200 transition-colors mb-2 leading-snug">
                {deg.degree}
              </h4>

              <p class="text-sm font-semibold text-slate-300 mb-4">
                {deg.institution}
              </p>

              {deg.professor && (
                <p class="text-xs text-slate-400 italic mb-4">
                  {deg.professor}
                </p>
              )}
            </div>

            {deg.honors && (
              <div class="mt-4 pt-4 border-t border-dark-800/80 flex items-center gap-2">
                <SocialIcons name="award" class="w-4 h-4 text-amber-400 shrink-0" />
                <span class="text-xs font-bold text-amber-300">
                  {deg.honors}
                </span>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
