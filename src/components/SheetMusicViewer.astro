---
import type { SupportedLocale } from '../utils/i18n-routes';

interface Props {
  locale?: SupportedLocale;
}

const { locale = 'es' } = Astro.props;

const copyMap: Record<SupportedLocale, {
  eyebrow: string;
  heading: string;
  desc: string;
  modeAria: string;
  printMode: string;
  ipadMode: string;
  playBtn: string;
  playingBtn: string;
  tabsAria: string;
  tab1: string;
  tab2: string;
  svgTitle1: string;
  svgTitle2: string;
  svgSub: string;
  trombotTitle: string;
  trombotDefault: string;
  folioLabel: string;
  playingNotePrefix: string;
  playingNoteSuffix: string;
}> = {
  es: {
    eyebrow: 'Muestra interactiva · Partitura y Audio',
    heading: 'Lectura clara en papel o pantalla y prueba de audio',
    desc: 'Alterna entre la edición impresa y la edición digital, reproduce el ejercicio completo o pulsa cualquier nota para escuchar su afinación.',
    modeAria: 'Modo de edición',
    printMode: 'Edición Impresa',
    ipadMode: 'Edición Digital',
    playBtn: '▶ Escuchar ejercicio',
    playingBtn: '■ Detener',
    tabsAria: 'Muestras de partitura del Volumen 1',
    tab1: 'Muestra 1 · Nivel 1, Lección 1 (Sib₂–Fa₃–Sib₃)',
    tab2: 'Muestra 2 · Nivel 3, Ampliación: Retos finales (Hasta Fa₄)',
    svgTitle1: 'NIVEL 1 · LECCIÓN 1: TOMA DE CONTACTO',
    svgTitle2: 'NIVEL 3 · AMPLIACIÓN: RETOS FINALES (HASTA Fa₄)',
    svgSub: 'CONEXIÓN EN ESPEJO Sib₂ — Fa₃ — Sib₃ · PULSA CUALQUIER NOTA PARA ESCUCHARLA',
    trombotTitle: 'TromBot recuerda:',
    trombotDefault: '«Conecta cada nota como una sirena de aire continuo: al subir de Sib₂ a Sib₃ tu lengua pronuncia suavemente Ah → Eh → Ee sin que los labios se tensen.»',
    folioLabel: 'Muestra · Pág. 9',
    playingNotePrefix: 'Sonando:',
    playingNoteSuffix: 'Mantén el aire continuo y la embocadura estable.',
  },
  en: {
    eyebrow: 'Interactive Sample · Score & Audio',
    heading: 'Clear reading in print or screen & audio preview',
    desc: 'Switch between the print edition and digital edition, play the full exercise, or click any note to hear its pitch.',
    modeAria: 'Edition mode',
    printMode: 'Print Edition',
    ipadMode: 'Digital Edition',
    playBtn: '▶ Play exercise',
    playingBtn: '■ Stop',
    tabsAria: 'Volume 1 score samples',
    tab1: 'Sample 1 · Level 1, Lesson 1 (Bb₂–F₃–Bb₃)',
    tab2: 'Sample 2 · Level 3, Extension: Final Challenges (Up to F₄)',
    svgTitle1: 'LEVEL 1 · LESSON 1: FIRST STEPS',
    svgTitle2: 'LEVEL 3 · EXTENSION: FINAL CHALLENGES (UP TO F₄)',
    svgSub: 'MIRROR CONNECTION Bb₂ — F₃ — Bb₃ · CLICK ANY NOTE TO HEAR IT',
    trombotTitle: 'TromBot reminder:',
    trombotDefault: '"Connect each note on a continuous airstream: as you ascend from Bb₂ to Bb₃, shape your tongue gently Ah → Eh → Ee without lip tension."',
    folioLabel: 'Sample · Page 9',
    playingNotePrefix: 'Playing:',
    playingNoteSuffix: 'Keep steady airflow and a relaxed embouchure.',
  },
  de: {
    eyebrow: 'Interaktive Vorschau · Partitur & Audio',
    heading: 'Klare Lesbarkeit auf Papier oder Bildschirm & Audiovorschau',
    desc: 'Wechseln Sie zwischen Druckausgabe und Digitalausgabe, spielen Sie die Übung ab oder klicken Sie auf einzelne Noten.',
    modeAria: 'Ausgabenmodus',
    printMode: 'Druckausgabe',
    ipadMode: 'Digitalausgabe',
    playBtn: '▶ Übung anhören',
    playingBtn: '■ Stopp',
    tabsAria: 'Partiturbeispiele Band 1',
    tab1: 'Beispiel 1 · Stufe 1, Lektion 1 (B₂–F₃–B₃)',
    tab2: 'Beispiel 2 · Stufe 3, Erweiterung: Abschlussübungen (Bis F₄)',
    svgTitle1: 'STUFE 1 · LEKTION 1: EINSTIEG',
    svgTitle2: 'STUFE 3 · ERWEITERUNG: ABSCHLUSSÜBUNGEN (BIS F₄)',
    svgSub: 'SPIEGELÜBUNG B₂ — F₃ — B₃ · NOTE ANKLICKEN ZUM ANHÖREN',
    trombotTitle: 'TromBot-Tipp:',
    trombotDefault: '„Verbinde jeden Ton auf einem ruhigen Luftstrom: Beim Aufstieg von B₂ nach B₃ formt die Zunge sanft Ah → Eh → Ih ohne Druck auf die Lippen.“',
    folioLabel: 'Vorschau · S. 9',
    playingNotePrefix: 'Es erklingt:',
    playingNoteSuffix: 'Halte den Luftstrom gleichmäßig und den Ansatz stabil.',
  },
  it: {
    eyebrow: 'Anteprima interattiva · Spartito e Audio',
    heading: 'Lettura chiara su carta o schermo e anteprima audio',
    desc: 'Alterna tra l\'edizione cartacea e l\'edizione digitale, ascolta l\'intero esercizio o clicca su qualsiasi nota per udirne l\'altezza.',
    modeAria: 'Modalità edizione',
    printMode: 'Edizione Cartacea',
    ipadMode: 'Edizione Digitale',
    playBtn: '▶ Ascolta esercizio',
    playingBtn: '■ Ferma',
    tabsAria: 'Estratti dello spartito Volume 1',
    tab1: 'Estratto 1 · Livello 1, Lezione 1 (Sib₂–Fa₃–Sib₃)',
    tab2: 'Estratto 2 · Livello 3, Ampliamento: Sfide finali (Fino a Fa₄)',
    svgTitle1: 'LIVELLO 1 · LEZIONE 1: PRIMO CONTATTO',
    svgTitle2: 'LIVELLO 3 · AMPLIAMENTO: SFIDE FINALI (FINO A Fa₄)',
    svgSub: 'CONNESSIONE A SPECCHIO Sib₂ — Fa₃ — Sib₃ · CLICCA SU UNA NOTA PER ASCOLTARLA',
    trombotTitle: 'Promemoria TromBot:',
    trombotDefault: '«Collega ogni nota con un flusso d\'aria continuo: salendo dal Sib₂ al Sib₃ la lingua passa dolcemente da Ah → Eh → Ee senza tendere le labbra.»',
    folioLabel: 'Estratto · Pag. 9',
    playingNotePrefix: 'In ascolto:',
    playingNoteSuffix: 'Mantieni il flusso d\'aria continuo e l\'imboccatura stabile.',
  },
};

const copy = copyMap[locale] || copyMap.es;
---

<section
  class="sheet-music-inspector relative w-full py-12"
  data-sheet-viewer-root
  data-locale={locale}
  data-title-1={copy.svgTitle1}
  data-title-2={copy.svgTitle2}
  data-play-label={copy.playBtn}
  data-stop-label={copy.playingBtn}
  data-note-prefix={copy.playingNotePrefix}
  data-note-suffix={copy.playingNoteSuffix}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    
    <!-- CABECERA DEL VISOR DE GRABADO MUSICAL -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-6">
      <div>
        <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-copper">
          {copy.eyebrow}
        </span>
        <h2 class="mt-2 font-serif text-2xl sm:text-3xl font-bold text-white">
          {copy.heading}
        </h2>
        <p class="mt-1.5 max-w-2xl text-sm text-slate-300">
          {copy.desc}
        </p>
      </div>

      <!-- Barra de Herramientas: Edición Impresa KDP vs Edición Digital iPad + Audio + Zoom -->
      <div class="flex flex-wrap items-center gap-2 bg-graphite-surface border border-graphite-border rounded-xl p-1.5">
        <div role="group" aria-label={copy.modeAria} class="flex items-center gap-1 border-r border-white/10 pr-2">
          <button
            type="button"
            data-paper-theme="print"
            aria-pressed="true"
            class="paper-theme-btn rounded-lg px-3 py-1.5 text-xs font-medium bg-copper/20 text-copper-light border border-copper/40 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
          >
            {copy.printMode}
          </button>
          <button
            type="button"
            data-paper-theme="ipad"
            aria-pressed="false"
            class="paper-theme-btn rounded-lg px-3 py-1.5 text-xs font-medium text-slate-300 hover:text-white border border-transparent transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
          >
            {copy.ipadMode}
          </button>
        </div>

        <button
          type="button"
          data-play-sequence
          aria-pressed="false"
          class="rounded-lg px-3 py-1.5 text-xs font-semibold bg-gold-500/20 text-gold-300 border border-gold-400/40 hover:bg-gold-500/30 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
        >
          {copy.playBtn}
        </button>

        <!-- Control de Zoom Vectorial -->
        <button
          type="button"
          data-toggle-zoom
          aria-pressed="false"
          class="rounded-lg px-2.5 py-1.5 text-xs font-mono text-slate-300 hover:text-white border border-transparent transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400"
        >
          Zoom <span data-zoom-label>100%</span>
        </button>
      </div>
    </div>

    <!-- PESTAÑAS DE MUESTRA DE LECCIÓN -->
    <div
      role="tablist"
      aria-label={copy.tabsAria}
      class="flex overflow-x-auto gap-2 border-b border-graphite-border mb-6"
    >
      <button
        type="button"
        role="tab"
        id="score-tab-n1"
        aria-selected="true"
        data-score-tab="panel-score-n1"
        class="score-tab-btn relative flex-none px-4 py-3 text-xs sm:text-sm font-serif text-white transition-colors hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-gold-400"
        style="--tab-accent: #E89758;"
      >
        {copy.tab1}
      </button>

      <button
        type="button"
        role="tab"
        id="score-tab-n3"
        aria-selected="false"
        data-score-tab="panel-score-n3"
        class="score-tab-btn relative flex-none px-4 py-3 text-xs sm:text-sm font-serif text-slate-300 transition-colors hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-gold-400"
        style="--tab-accent: #E89758;"
      >
        {copy.tab2}
      </button>
    </div>

    <!-- CONTENEDOR DEL PLIEGO EDITORIAL / MARCO IPAD -->
    <div class="overflow-x-auto rounded-2xl border border-graphite-border shadow-2xl bg-[#0e1014] p-3 sm:p-6">
      <div
        data-sheet-paper
        data-theme-mode="print"
        class="sheet-paper-surface relative mx-auto max-w-4xl rounded-md transition-all duration-300 p-6 sm:p-10 shadow-xl"
      >
        <!-- Barra superior sutil de cámara/estado visible solo en modo digital -->
        <div data-ipad-bar class="hidden items-center justify-between pb-4 mb-4 border-b border-slate-200 text-[10px] font-mono text-slate-500">
          <span>Lectura digital en atril</span>
          <span class="inline-block h-2 w-2 rounded-full bg-slate-400" aria-hidden="true"></span>
          <span>100% · Kindle / PDF</span>
        </div>

        <!-- CABECERA OFICIAL DE VARA ENMARCADORA + CÓDIGO QR DE LECCIÓN -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-current/15 pb-5">
          <div class="w-full sm:w-4/5">
            <svg viewBox="0 0 650 90" class="w-full h-auto" role="img" aria-label="Cabecera de sección enmarcada por vara de trombón">
              <g transform="translate(10, 8)">
                <path d="M 0 10 Q 30 18 45 34 L 45 40 Q 30 56 0 64 L 0 62 Q 25 50 38 37 Q 25 24 0 12 Z" fill="currentColor"/>
                <ellipse cx="2" cy="37" rx="3" ry="27" fill="currentColor"/>
                <path d="M 45 35 L 75 35 Q 90 35 90 20 Q 90 5 75 5 L 40 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M 45 39 L 75 39 Q 95 39 95 50 Q 95 62 80 62 L 55 62" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="60" y1="5" x2="60" y2="35" stroke="currentColor" stroke-width="3"/>
                <circle cx="60" cy="20" r="5" fill="currentColor"/>
                <line x1="75" y1="39" x2="75" y2="62" stroke="currentColor" stroke-width="2"/>
              </g>
              <g>
                <line x1="105" y1="28" x2="620" y2="28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M 620 25 L 635 23 L 642 18 L 645 18 L 645 38 L 642 38 L 635 33 L 620 31 Z" fill="currentColor"/>
                <text data-svg-header-title x="360" y="48" font-family="Baskerville, Georgia, serif" font-size="18" font-weight="bold" letter-spacing="3.5" fill="currentColor" text-anchor="middle">
                  {copy.svgTitle1}
                </text>
                <text data-svg-header-sub x="360" y="62" font-family="Baskerville, Georgia, serif" font-size="9.5" font-style="italic" letter-spacing="1.2" fill="currentColor" opacity="0.75" text-anchor="middle">
                  {copy.svgSub}
                </text>
                <line x1="105" y1="68" x2="600" y2="68" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M 600 68 Q 618 68 618 78 Q 618 86 600 86 L 105 86" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="6,4"/>
              </g>
            </svg>
          </div>

          <!-- Bloque QR Vectorial Neutro de Lección (javisaez.com/e/v1-n1-l1) -->
          <div class="flex flex-col items-center border border-current/25 rounded p-2 text-center flex-shrink-0">
            <svg viewBox="0 0 36 36" class="w-12 h-12" aria-hidden="true">
              <rect x="2" y="2" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2"/>
              <rect x="5" y="5" width="4" height="4" fill="currentColor"/>
              <rect x="24" y="2" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2"/>
              <rect x="27" y="5" width="4" height="4" fill="currentColor"/>
              <rect x="2" y="24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2"/>
              <rect x="5" y="27" width="4" height="4" fill="currentColor"/>
              <rect x="15" y="5" width="3" height="3" fill="currentColor"/>
              <rect x="15" y="14" width="6" height="6" fill="currentColor"/>
              <rect x="24" y="16" width="4" height="4" fill="currentColor"/>
              <rect x="15" y="26" width="4" height="6" fill="currentColor"/>
              <rect x="25" y="25" width="7" height="7" fill="currentColor"/>
            </svg>
            <span data-qr-code-label class="mt-1 font-sans text-[8.5px] font-medium tracking-wider uppercase">
              /e/v1-n1-l1
            </span>
          </div>
        </div>

        <!-- PANEL 1: NIVEL 1 · LECCIÓN 1 (EJERCICIO EN ESPEJO 1A / 1B) -->
        <!-- Nota: estilos de padding/borde en div hijo según modern-web-guidance `tabs` -->
        <div role="tabpanel" id="panel-score-n1" aria-labelledby="score-tab-n1">
          <div class="py-5 space-y-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-serif text-base sm:text-lg font-bold">
                Ejercicio 1A (1.ª Posición) y 1B (Espejo en 2.ª Posición)
              </h3>
              <span class="font-sans text-xs font-semibold tracking-wide opacity-80">
                ♩ = 60 BPM · Legato continuo sin corte de lengua
              </span>
            </div>

            <!-- PENTAGRAMA INTERACTIVO SVG (Muestra 1) -->
            <div class="w-full overflow-x-auto">
              <svg viewBox="0 0 760 155" class="w-full min-w-[600px] h-auto select-none" role="group" aria-label="Pentagrama interactivo del Ejercicio 1A y 1B">
                <!-- Indicación de Tempo en Helvetica Neue -->
                <text x="18" y="24" font-family="Inter, Helvetica Neue, sans-serif" font-size="11" font-weight="600" fill="currentColor">
                  ♩ = 60
                </text>
                <text x="85" y="24" font-family="Baskerville, Georgia, serif" font-size="11" font-style="italic" fill="currentColor">
                  1A · Serie en 1.ª posición (Sib)
                </text>
                <text x="415" y="24" font-family="Baskerville, Georgia, serif" font-size="11" font-style="italic" fill="currentColor">
                  1B · Espejo en 2.ª posición (La)
                </text>

                <!-- 5 líneas del pentagrama (Espaciado rastral proporcional a 7.0 mm) -->
                {[50, 62, 74, 86, 98].map((y) => (
                  <line x1="15" y1={y} x2="745" y2={y} stroke="currentColor" stroke-width="1.15" opacity="0.85"/>
                ))}

                <!-- Barras de compás -->
                <line x1="15" y1="50" x2="15" y2="98" stroke="currentColor" stroke-width="2"/>
                <line x1="395" y1="50" x2="395" y2="98" stroke="currentColor" stroke-width="1.4"/>
                <line x1="740" y1="50" x2="740" y2="98" stroke="currentColor" stroke-width="1.2"/>
                <line x1="745" y1="50" x2="745" y2="98" stroke="currentColor" stroke-width="3"/>

                <!-- Clave de Fa en 4.ª línea estilizada -->
                <g transform="translate(24, 48)">
                  <circle cx="8" cy="14" r="4.5" fill="currentColor"/>
                  <path d="M 8 10 C 20 6, 24 28, 6 42" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/>
                  <circle cx="26" cy="8" r="2.2" fill="currentColor"/>
                  <circle cx="26" cy="20" r="2.2" fill="currentColor"/>
                </g>

                <!-- Compás 4/4 -->
                <text x="64" y="69" font-family="Baskerville, serif" font-size="22" font-weight="bold" fill="currentColor">4</text>
                <text x="64" y="93" font-family="Baskerville, serif" font-size="22" font-weight="bold" fill="currentColor">4</text>

                <!-- Arco de ligadura Compás 1 (1A) -->
                <path d="M 115 95 Q 235 125 345 95" fill="none" stroke="currentColor" stroke-width="1.8"/>

                <!-- NOTAS INTERACTIVAS COMPÁS 1 (1.ª posición: Sib2 -> Fa3 -> Sib3 -> Fa3) -->
                <!-- Nota 1: Sib2 (2.ª línea, y=86) -->
                <g class="score-note cursor-pointer" data-note-freq="116.54" data-note-label="Sib₂ (1.ª pos · Vocal Oh/Ah)" tabindex="0" role="button" aria-label="Tocar nota Sib 2 en primera posición">
                  <rect x="96" y="30" width="38" height="95" fill="transparent"/>
                  <text x="115" y="42" font-family="Baskerville, serif" font-size="11" font-weight="bold" fill="currentColor" text-anchor="middle">1.ª</text>
                  <ellipse cx="115" cy="86" rx="7.5" ry="5.2" transform="rotate(-18 115 86)" fill="currentColor"/>
                  <line x1="122" y1="86" x2="122" y2="52" stroke="currentColor" stroke-width="1.6"/>
                  <text x="115" y="136" font-family="Baskerville, serif" font-size="10.5" font-style="italic" fill="currentColor" text-anchor="middle">Ah</text>
                </g>

                <!-- Nota 2: Fa3 (4.ª línea, y=62) -->
                <g class="score-note cursor-pointer" data-note-freq="174.61" data-note-label="Fa₃ (1.ª pos · Vocal Ah)" tabindex="0" role="button" aria-label="Tocar nota Fa 3 en primera posición">
                  <rect x="172" y="30" width="38" height="95" fill="transparent"/>
                  <ellipse cx="190" cy="62" rx="7.5" ry="5.2" transform="rotate(-18 190 62)" fill="currentColor"/>
                  <line x1="183" y1="62" x2="183" y2="96" stroke="currentColor" stroke-width="1.6"/>
                  <text x="190" y="136" font-family="Baskerville, serif" font-size="10.5" font-style="italic" fill="currentColor" text-anchor="middle">→ Eh</text>
                </g>

                <!-- Nota 3: Sib3 (Espacio adicional superior, y=44) -->
                <g class="score-note cursor-pointer" data-note-freq="233.08" data-note-label="Sib₃ (1.ª pos · 4.º Parcial)" tabindex="0" role="button" aria-label="Tocar nota Sib 3 en primera posición">
                  <rect x="248" y="25" width="38" height="100" fill="transparent"/>
                  <ellipse cx="265" cy="44" rx="7.5" ry="5.2" transform="rotate(-18 265 44)" fill="currentColor"/>
                  <line x1="258" y1="44" x2="258" y2="80" stroke="currentColor" stroke-width="1.6"/>
                  <text x="265" y="136" font-family="Baskerville, serif" font-size="10.5" font-style="italic" fill="currentColor" text-anchor="middle">→ Ee</text>
                </g>

                <!-- Nota 4: Fa3 (4.ª línea, y=62) -->
                <g class="score-note cursor-pointer" data-note-freq="174.61" data-note-label="Fa₃ (1.ª pos · Retorno controlado)" tabindex="0" role="button" aria-label="Tocar nota Fa 3 en primera posición">
                  <rect x="322" y="30" width="38" height="95" fill="transparent"/>
                  <ellipse cx="340" cy="62" rx="7.5" ry="5.2" transform="rotate(-18 340 62)" fill="currentColor"/>
                  <line x1="333" y1="62" x2="333" y2="96" stroke="currentColor" stroke-width="1.6"/>
                  <text x="340" y="136" font-family="Baskerville, serif" font-size="10.5" font-style="italic" fill="currentColor" text-anchor="middle">→ Ah</text>
                </g>

                <!-- Coma de respiración -->
                <text x="380" y="44" font-family="Baskerville, serif" font-size="22" font-weight="bold" fill="currentColor">,</text>

                <!-- Arco de ligadura Compás 2 (1B en 2.ª posición) -->
                <path d="M 445 102 Q 565 128 675 102" fill="none" stroke="currentColor" stroke-width="1.8"/>

                <!-- NOTAS INTERACTIVAS COMPÁS 2 (2.ª posición: La2 -> Mi3 -> La3 -> Mi3) -->
                <!-- Nota 5: La2 (1.er espacio, y=92) -->
                <g class="score-note cursor-pointer" data-note-freq="110.00" data-note-label="La₂ (2.ª pos · Espejo)" tabindex="0" role="button" aria-label="Tocar nota La 2 en segunda posición">
                  <rect x="426" y="30" width="38" height="95" fill="transparent"/>
                  <text x="445" y="42" font-family="Baskerville, serif" font-size="11" font-weight="bold" fill="currentColor" text-anchor="middle">2.ª</text>
                  <ellipse cx="445" cy="92" rx="7.5" ry="5.2" transform="rotate(-18 445 92)" fill="currentColor"/>
                  <line x1="452" y1="92" x2="452" y2="56" stroke="currentColor" stroke-width="1.6"/>
                  <text x="445" y="136" font-family="Baskerville, serif" font-size="10.5" font-style="italic" fill="currentColor" text-anchor="middle">Ah</text>
                </g>

                <!-- Nota 6: Mi3 (3.er espacio, y=68) -->
                <g class="score-note cursor-pointer" data-note-freq="164.81" data-note-label="Mi₃ (2.ª pos · 3.er Parcial)" tabindex="0" role="button" aria-label="Tocar nota Mi 3 en segunda posición">
                  <rect x="502" y="30" width="38" height="95" fill="transparent"/>
                  <ellipse cx="520" cy="68" rx="7.5" ry="5.2" transform="rotate(-18 520 68)" fill="currentColor"/>
                  <line x1="513" y1="68" x2="513" y2="100" stroke="currentColor" stroke-width="1.6"/>
                  <text x="520" y="136" font-family="Baskerville, serif" font-size="10.5" font-style="italic" fill="currentColor" text-anchor="middle">→ Eh</text>
                </g>

                <!-- Nota 7: La3 (5.ª línea, y=50) -->
                <g class="score-note cursor-pointer" data-note-freq="220.00" data-note-label="La₃ (2.ª pos · 4.º Parcial)" tabindex="0" role="button" aria-label="Tocar nota La 3 en segunda posición">
                  <rect x="576" y="25" width="38" height="100" fill="transparent"/>
