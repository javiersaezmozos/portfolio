<style>
  .sheet-paper-surface[data-theme-mode="print"] {
    color-scheme: only light;
    background-color: #ffffff;
    color: #111111;
    border: 1px solid #e2e8f0;
  }

  .sheet-paper-surface[data-theme-mode="ipad"] {
    color-scheme: only light;
    background-color: #ffffff;
    color: #111111;
    border: 12px solid #272b33;
    border-radius: 1.5rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.75), inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  /* Indicador de pestaña activa con borde en pseudo-elemento (modern-web-guidance: tabs) */
  .score-tab-btn[aria-selected="true"] {
    color: #ffffff;
  }

  .score-tab-btn[aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    border-block-end: 3px solid var(--tab-accent, #E89758);
  }

  .score-note {
    transition: opacity 0.15s ease;
  }

  .score-note:hover,
  .score-note:focus-visible {
    opacity: 0.68;
    outline: none;
  }
</style>

<script>
  function initSheetMusicViewer() {
    try {
      const roots = document.querySelectorAll<HTMLElement>('[data-sheet-viewer-root]');

      roots.forEach((root) => {
        if (root.dataset.initialized === 'true') return;
        root.dataset.initialized = 'true';

        const paper = root.querySelector<HTMLElement>('[data-sheet-paper]');
        const ipadBar = root.querySelector<HTMLElement>('[data-ipad-bar]');
        const themeBtns = root.querySelectorAll<HTMLButtonElement>('[data-paper-theme]');
        const playBtn = root.querySelector<HTMLButtonElement>('[data-play-sequence]');
        const zoomBtn = root.querySelector<HTMLButtonElement>('[data-toggle-zoom]');
        const zoomLabel = root.querySelector<HTMLElement>('[data-zoom-label]');

        const tabBtns = root.querySelectorAll<HTMLButtonElement>('[data-score-tab]');
        const headerTitle = root.querySelector<SVGTextElement>('[data-svg-header-title]');
        const qrCodeLabel = root.querySelector<HTMLElement>('[data-qr-code-label]');
        const scoreFeedback = root.querySelector<HTMLElement>('[data-score-feedback]');
        const notes = root.querySelectorAll<SVGGElement>('.score-note');

        const title1 = root.dataset.title1 || 'NIVEL 1 · LECCIÓN 1: TOMA DE CONTACTO';
        const title2 = root.dataset.title2 || 'NIVEL 3 · AMPLIACIÓN: RETOS FINALES (HASTA Fa₄)';
        const playLabel = root.dataset.playLabel || '▶ Escuchar ejercicio';
        const stopLabel = root.dataset.stopLabel || '■ Detener';
        const notePrefix = root.dataset.notePrefix || 'Sonando:';
        const noteSuffix = root.dataset.noteSuffix || '';

        let isZoomed = false;
        let sequenceTimers: number[] = [];
        let isPlayingSequence = false;

        const stopSequence = () => {
          sequenceTimers.forEach((t) => window.clearTimeout(t));
          sequenceTimers = [];
          isPlayingSequence = false;
          if (playBtn) {
            playBtn.textContent = playLabel;
            playBtn.setAttribute('aria-pressed', 'false');
          }
          notes.forEach((n) => {
            n.style.opacity = '';
          });
        };

        // Cambio de modo: Edición Impresa KDP vs Edición Digital iPad
        themeBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            try {
              const mode = btn.dataset.paperTheme || 'print';
              if (paper) paper.dataset.themeMode = mode;
              if (ipadBar) {
                ipadBar.classList.toggle('hidden', mode !== 'ipad');
                ipadBar.classList.toggle('flex', mode === 'ipad');
              }

              themeBtns.forEach((b) => {
                const active = b === btn;
                b.setAttribute('aria-pressed', String(active));
                b.classList.toggle('bg-copper/20', active);
                b.classList.toggle('text-copper-light', active);
                b.classList.toggle('border-copper/40', active);
                b.classList.toggle('text-slate-300', !active);
                b.classList.toggle('border-transparent', !active);
              });
            } catch (err) {
              console.error('[SheetMusicViewer] Error cambiando modo de edición:', err);
            }
          });
        });

        // Reproducir ejercicio completo en secuencia
        playBtn?.addEventListener('click', () => {
          try {
            if (isPlayingSequence) {
              stopSequence();
              return;
            }
            const activePanel = root.querySelector<HTMLElement>('[role="tabpanel"]:not([hidden])');
            const activeNotes = activePanel
              ? Array.from(activePanel.querySelectorAll<SVGGElement>('.score-note'))
              : [];
            if (!activeNotes.length) return;

            isPlayingSequence = true;
            playBtn.textContent = stopLabel;
            playBtn.setAttribute('aria-pressed', 'true');

            const globalWin = window as unknown as {
              __tromboneEngine?: { playBrassTone: (f: number, d: number) => void };
            };

            activeNotes.forEach((noteEl, idx) => {
              const t = window.setTimeout(() => {
                activeNotes.forEach((n) => (n.style.opacity = ''));
                noteEl.style.opacity = '0.55';
                const freq = parseFloat(noteEl.dataset.noteFreq || '233.08');
                const label = noteEl.dataset.noteLabel || '';
                if (globalWin.__tromboneEngine) {
                  globalWin.__tromboneEngine.playBrassTone(freq, 0.55);
                }
                if (scoreFeedback && label) {
                  scoreFeedback.textContent = `${notePrefix} ${label} (${freq.toFixed(1)} Hz). ${noteSuffix}`;
                }
              }, idx * 540);
              sequenceTimers.push(t);
            });

            const endTimer = window.setTimeout(stopSequence, activeNotes.length * 540 + 400);
            sequenceTimers.push(endTimer);
          } catch (err) {
            console.error('[SheetMusicViewer] Error reproduciendo secuencia:', err);
            stopSequence();
          }
        });

        // Zoom de inspección de grabado
        zoomBtn?.addEventListener('click', () => {
          try {
            isZoomed = !isZoomed;
            zoomBtn.setAttribute('aria-pressed', String(isZoomed));
            if (zoomLabel) zoomLabel.textContent = isZoomed ? '125%' : '100%';
            if (paper) {
              paper.classList.toggle('max-w-4xl', !isZoomed);
              paper.classList.toggle('max-w-6xl', isZoomed);
            }
          } catch (err) {
            console.error('[SheetMusicViewer] Error cambiando zoom:', err);
          }
        });

        // Pestañas de selección de muestra (Muestra 1 vs Muestra 2)
        const selectScoreTab = (selectedBtn: HTMLButtonElement) => {
          try {
            const targetPanelId = selectedBtn.dataset.scoreTab;
            tabBtns.forEach((btn) => {
              const isSelected = btn === selectedBtn;
              btn.setAttribute('aria-selected', String(isSelected));
              const panelId = btn.dataset.scoreTab;
              if (panelId) {
                const panel = root.querySelector<HTMLElement>(`#${panelId}`);
                if (panel) {
                  if (isSelected) {
                    panel.removeAttribute('hidden');
                  } else {
                    panel.setAttribute('hidden', '');
                  }
                }
              }
            });

            stopSequence();
            if (targetPanelId === 'panel-score-n3') {
              if (headerTitle) headerTitle.textContent = title2;
              if (qrCodeLabel) qrCodeLabel.textContent = '/e/v1-n3-amp';
            } else {
              if (headerTitle) headerTitle.textContent = title1;
              if (qrCodeLabel) qrCodeLabel.textContent = '/e/v1-n1-l1';
            }
          } catch (err) {
            console.error('[SheetMusicViewer] Error cambiando pestaña de partitura:', err);
          }
        };

        tabBtns.forEach((btn, idx) => {
          btn.addEventListener('click', () => selectScoreTab(btn));
          btn.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
              e.preventDefault();
              const dir = e.key === 'ArrowRight' ? 1 : -1;
              const nextIdx = (idx + dir + tabBtns.length) % tabBtns.length;
              const nextBtn = tabBtns[nextIdx];
              if (nextBtn) {
                nextBtn.focus();
                selectScoreTab(nextBtn);
              }
            }
          });
        });

        // Interacción sonora al pulsar cualquier cabeza de nota del pentagrama
        notes.forEach((noteEl) => {
          const triggerNote = () => {
            try {
              const freq = parseFloat(noteEl.dataset.noteFreq || '233.08');
              const label = noteEl.dataset.noteLabel || '';
              const globalWin = window as unknown as {
                __tromboneEngine?: { playBrassTone: (f: number, d: number) => void };
              };
              if (globalWin.__tromboneEngine) {
                globalWin.__tromboneEngine.playBrassTone(freq, 0.75);
              }
              if (scoreFeedback && label) {
                scoreFeedback.textContent = `${notePrefix} ${label} (${freq.toFixed(1)} Hz). ${noteSuffix}`;
              }
            } catch (err) {
              console.warn('[SheetMusicViewer] Error reproduciendo nota del pentagrama:', err);
            }
          };

          noteEl.addEventListener('click', triggerNote);
          noteEl.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              triggerNote();
            }
          });
        });
      });
    } catch (err) {
      console.error('[SheetMusicViewer] Fallo crítico al inicializar el visor:', err);
    }
  }

  initSheetMusicViewer();
  document.addEventListener('astro:page-load', initSheetMusicViewer);
</script>
