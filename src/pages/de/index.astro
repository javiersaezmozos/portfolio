import Hero from '../../components/Hero.astro';
import FeaturedMethodSection from '../../components/FeaturedMethodSection.astro';
import deData from '../../data/de.json';
---

<Layout
  meta={deData.meta}
  nav={deData.nav}
  footer={deData.footer}
  currentLocale="de"
