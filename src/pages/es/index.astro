---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import AcademicSection from '../../components/AcademicSection.astro';
import MasterclassesSection from '../../components/MasterclassesSection.astro';
import PerformanceSection from '../../components/PerformanceSection.astro';
import TeachingSection from '../../components/TeachingSection.astro';
import AwardsSection from '../../components/AwardsSection.astro';
import SocialBroadcastSection from '../../components/SocialBroadcastSection.astro';
import esData from '../../data/es.json';
---

<Layout
  meta={esData.meta}
  nav={esData.nav}
  footer={esData.footer}
  currentLocale="es"
>
  <Hero
    hero={esData.hero}
    presentation={esData.presentation}
    currentLocale="es"
  />

  <AcademicSection
    academic={esData.academic}
    currentLocale="es"
  />

  <MasterclassesSection
    masterclasses={esData.masterclasses}
    currentLocale="es"
  />

  <PerformanceSection
    performance={esData.performance}
    currentLocale="es"
  />

  <TeachingSection
    teaching={esData.teaching}
    currentLocale="es"
  />

  <AwardsSection
    awards={esData.awards}
    currentLocale="es"
  />

  <SocialBroadcastSection
    social={esData.social}
    currentLocale="es"
  />
</Layout>
