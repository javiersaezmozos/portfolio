---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import FeaturedMethodSection from '../../components/FeaturedMethodSection.astro';
import esData from '../../data/es.json';
---

<Layout
  meta={esData.meta}
  nav={esData.nav}
  footer={esData.footer}
  currentLocale="es"
>
  <Hero
    hero={esData.hero}
    presentation={esData.presentation}
    currentLocale="es"
  />

  <FeaturedMethodSection currentLocale="es" />
</Layout>
