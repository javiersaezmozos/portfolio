---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import FeaturedMethodSection from '../../components/FeaturedMethodSection.astro';
import itData from '../../data/it.json';
---

<Layout
  meta={itData.meta}
  nav={itData.nav}
  footer={itData.footer}
  currentLocale="it"
>
  <Hero
    hero={itData.hero}
    presentation={itData.presentation}
    currentLocale="it"
  />

  <FeaturedMethodSection currentLocale="it" />
</Layout>
