---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import FeaturedMethodSection from '../../components/FeaturedMethodSection.astro';
import AcademicSection from '../../components/AcademicSection.astro';
import MasterclassesSection from '../../components/MasterclassesSection.astro';
import PerformanceSection from '../../components/PerformanceSection.astro';
import TeachingSection from '../../components/TeachingSection.astro';
import AwardsSection from '../../components/AwardsSection.astro';
import SocialBroadcastSection from '../../components/SocialBroadcastSection.astro';
import itData from '../../data/it.json';
---

<Layout
  meta={itData.meta}
  nav={itData.nav}
  footer={itData.footer}
  currentLocale="it"
>
  <Hero
    hero={itData.hero}
    presentation={itData.presentation}
    currentLocale="it"
  />

  <FeaturedMethodSection currentLocale="it" />

  <AcademicSection
    academic={itData.academic}
    currentLocale="it"
  />

  <MasterclassesSection
    masterclasses={itData.masterclasses}
    currentLocale="it"
  />

  <PerformanceSection
    performance={itData.performance}
    currentLocale="it"
  />

  <TeachingSection
    teaching={itData.teaching}
    currentLocale="it"
  />

  <AwardsSection
    awards={itData.awards}
    currentLocale="it"
  />

  <SocialBroadcastSection
    social={itData.social}
    currentLocale="it"
  />
</Layout>
