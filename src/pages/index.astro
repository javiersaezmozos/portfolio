---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
return Astro.redirect(`${base}/es`);
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content={`0;url=${import.meta.env.BASE_URL.replace(/\/$/, '')}/es`}>
  <title>Javier Sáez | Redirigiendo...</title>
</head>
<body style="background-color: #0a0d12; color: #f2e5c8; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
  <p>Redirigiendo a <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/es`} style="color: #d4af37;">Javier Sáez Portfolio</a>...</p>
</body>
</html>
