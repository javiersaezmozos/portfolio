---
import registroI18n from '../data/registro-i18n.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const registerApiUrl = `${base}/api/register`;
const defaultCopy = registroI18n.es;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro de Ejemplar · Trombón Flexibilidad | Javier Sáez</title>
    <meta
      name="description"
      content="Portal oficial de validación y activación de ejemplares para el método Trombón Flexibilidad de Javier Sáez Mozos."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-graphite-base text-slate-100 font-sans antialiased min-h-screen flex flex-col">
    <!-- Barra superior minimalista con selector de los 4 idiomas del libro -->
    <header class="border-b border-graphite-border bg-graphite-deep/90 backdrop-blur-md">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a
          href={`${base}/es/metodos/flexibilidad`}
          data-back-link
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-copper-light hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400 rounded px-2 py-1"
        >
          <span aria-hidden="true">←</span>
          <span data-i18n="backLink">{defaultCopy.backLink}</span>
        </a>

        <nav aria-label="Idioma de registro" class="flex items-center gap-1 rounded-full bg-graphite-surface p-1 border border-graphite-border text-xs font-semibold">
          {(['es', 'en', 'de', 'it'] as const).map((code) => (
            <button
              type="button"
              data-lang-btn={code}
              aria-pressed={code === 'es' ? 'true' : 'false'}
              class={`px-2.5 py-1 rounded-full uppercase transition-colors focus:outline-none focus:ring-2 focus:ring-gold-400 ${
                code === 'es'
                  ? 'bg-copper text-dark-950 font-bold'
                  : 'text-slate-300 hover:text-white'
              }`}
            >
              {code}
            </button>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-grow py-10 sm:py-14 px-4 sm:px-6 bg-gradient-auditorium">
      <div class="mx-auto max-w-2xl">
        <div class="rounded-2xl bg-graphite-surface/95 border border-copper/30 p-6 sm:p-10 shadow-2xl">
          <!-- Cabecera Editorial -->
          <div class="border-b border-white/10 pb-6">
            <span
              data-i18n="badge"
              class="inline-block rounded-full border border-copper/40 bg-copper/10 px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-copper-light"
            >
              {defaultCopy.badge}
            </span>
            <h1
              data-i18n="title"
              class="mt-3 font-serif text-2xl sm:text-3xl font-bold text-white"
            >
              {defaultCopy.title}
            </h1>
            <p
              data-i18n="subtitle"
              class="mt-1 font-serif italic text-sm sm:text-base text-copper"
            >
              {defaultCopy.subtitle}
            </p>
            <p
              data-i18n="intro"
              class="mt-3 text-sm text-slate-300 leading-relaxed"
            >
              {defaultCopy.intro}
            </p>
          </div>

          <!-- Formulario Accesible de Activación -->
          <form id="registro-form" class="mt-6 space-y-5" data-api-url={registerApiUrl}>
            <!-- Nombre completo -->
            <div class="field">
              <label for="reg-name" data-i18n="nameLabel" class="block text-sm font-medium text-slate-100">
                {defaultCopy.nameLabel}
              </label>
              <span id="reg-name-hint" data-i18n="nameHint" class="block text-xs text-slate-400 mt-0.5 mb-1.5">
                {defaultCopy.nameHint}
              </span>
              <input
                id="reg-name"
                name="name"
                type="text"
                required
                minlength="2"
                autocomplete="name"
                aria-invalid="false"
                aria-describedby="reg-name-hint"
                data-error="reg-name-error"
                class="w-full rounded-xl bg-graphite-deep border border-graphite-border px-4 py-2.5 text-sm text-white focus:border-copper focus:outline-none focus:ring-2 focus:ring-copper/40"
              />
              <div id="reg-name-error" class="error-msg mt-1.5 text-xs text-red-400">
                <span role="img" aria-label="Error">❌</span>{' '}
                <span data-i18n="nameError">{defaultCopy.nameError}</span>
              </div>
            </div>

            <!-- Correo electrónico -->
            <div class="field">
              <label for="reg-email" data-i18n="emailLabel" class="block text-sm font-medium text-slate-100">
                {defaultCopy.emailLabel}
              </label>
              <span id="reg-email-hint" data-i18n="emailHint" class="block text-xs text-slate-400 mt-0.5 mb-1.5">
                {defaultCopy.emailHint}
              </span>
              <input
                id="reg-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                aria-invalid="false"
                aria-describedby="reg-email-hint"
                data-error="reg-email-error"
                class="w-full rounded-xl bg-graphite-deep border border-graphite-border px-4 py-2.5 text-sm text-white focus:border-copper focus:outline-none focus:ring-2 focus:ring-copper/40"
              />
              <div id="reg-email-error" class="error-msg mt-1.5 text-xs text-red-400">
                <span role="img" aria-label="Error">❌</span>{' '}
                <span data-i18n="emailError">{defaultCopy.emailError}</span>
              </div>
            </div>

            <!-- Edición de lanzamiento: Amazon KDP o Kindle -->
            <div class="field">
              <label for="reg-channel" data-i18n="channelLabel" class="block text-sm font-medium text-slate-100 mb-1.5">
                {defaultCopy.channelLabel}
              </label>
              <select
                id="reg-channel"
                name="channel"
                required
                aria-invalid="false"
                class="w-full rounded-xl bg-graphite-deep border border-graphite-border px-4 py-2.5 text-sm text-white focus:border-copper focus:outline-none focus:ring-2 focus:ring-copper/40"
              >
                {defaultCopy.channelOptions.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
            </div>

            <!-- Número de pedido de Amazon -->
            <div class="field">
              <label for="reg-order" data-i18n="orderLabel" class="block text-sm font-medium text-slate-100">
                {defaultCopy.orderLabel}
              </label>
              <span id="reg-order-hint" data-i18n="orderHint" class="block text-xs text-slate-400 mt-0.5 mb-1.5">
                {defaultCopy.orderHint}
              </span>
              <input
                id="reg-order"
                name="orderId"
                type="text"
                required
                minlength="6"
                aria-invalid="false"
                aria-describedby="reg-order-hint"
                data-error="reg-order-error"
                class="w-full rounded-xl bg-graphite-deep border border-graphite-border px-4 py-2.5 text-sm font-mono text-white focus:border-copper focus:outline-none focus:ring-2 focus:ring-copper/40"
              />
              <div id="reg-order-error" class="error-msg mt-1.5 text-xs text-red-400">
                <span role="img" aria-label="Error">❌</span>{' '}
                <span data-i18n="orderError">{defaultCopy.orderError}</span>
              </div>
            </div>

            <!-- Captura / foto del recibo de compra (optimizada en cliente para Gemini + Drive) -->
            <div class="field">
              <label for="reg-receipt" data-i18n="receiptLabel" class="block text-sm font-medium text-slate-100">
                {defaultCopy.receiptLabel}
              </label>
              <span id="reg-receipt-hint" data-i18n="receiptHint" class="block text-xs text-slate-400 mt-0.5 mb-1.5">
                {defaultCopy.receiptHint}
              </span>
              <input
                id="reg-receipt"
                name="receipt"
                type="file"
                accept="image/*"
                required
                aria-invalid="false"
                aria-describedby="reg-receipt-hint"
                data-error="reg-receipt-error"
                class="w-full rounded-xl bg-graphite-deep border border-graphite-border px-3 py-2 text-xs sm:text-sm text-slate-200 file:mr-3 file:rounded-lg file:border-0 file:bg-copper/20 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-copper-light hover:file:bg-copper/30 focus:border-copper focus:outline-none focus:ring-2 focus:ring-copper/40"
              />
              <p id="reg-receipt-status" hidden class="mt-1.5 text-xs font-mono text-emerald-300"></p>
              <div id="reg-receipt-error" class="error-msg mt-1.5 text-xs text-red-400">
                <span role="img" aria-label="Error">❌</span>{' '}
                <span data-i18n="receiptError">{defaultCopy.receiptError}</span>
              </div>
            </div>

            <!-- Campo trampa Honeypot invisible para humanos (bloqueo de bots sin CAPTCHA) -->
            <div class="sr-only" aria-hidden="true">
              <label for="reg-website">Website</label>
              <input
                id="reg-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <!-- Notas opcionales -->
            <div class="field">
              <label for="reg-notes" data-i18n="notesLabel" class="block text-sm font-medium text-slate-100">
                {defaultCopy.notesLabel}
              </label>
              <span id="reg-notes-hint" data-i18n="notesHint" class="block text-xs text-slate-400 mt-0.5 mb-1.5">
                {defaultCopy.notesHint}
              </span>
              <textarea
                id="reg-notes"
                name="notes"
                rows="2"
                aria-describedby="reg-notes-hint"
                class="w-full rounded-xl bg-graphite-deep border border-graphite-border px-4 py-2 text-sm text-white focus:border-copper focus:outline-none focus:ring-2 focus:ring-copper/40"
              ></textarea>
            </div>

            <!-- Consentimiento RGPD -->
            <div class="field pt-1">
              <div class="flex items-start gap-3">
                <input
                  id="reg-gdpr"
                  name="gdpr"
                  type="checkbox"
                  required
                  aria-invalid="false"
                  data-error="reg-gdpr-error"
                  class="mt-1 h-4 w-4 rounded border-graphite-border bg-graphite-deep text-copper focus:ring-2 focus:ring-copper"
                />
                <label for="reg-gdpr" data-i18n="gdprLabel" class="text-xs text-slate-300 leading-relaxed cursor-pointer">
                  {defaultCopy.gdprLabel}
                </label>
              </div>
              <div id="reg-gdpr-error" class="error-msg mt-1.5 text-xs text-red-400">
                <span role="img" aria-label="Error">❌</span>{' '}
                <span data-i18n="gdprError">{defaultCopy.gdprError}</span>
              </div>
            </div>

            <button
              type="submit"
              id="reg-submit-btn"
              data-i18n="submitBtn"
              class="w-full rounded-xl bg-gradient-copper px-5 py-3 text-sm font-bold text-dark-950 shadow-metal-copper transition-transform hover:scale-[1.01] active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-gold-400"
            >
              {defaultCopy.submitBtn}
            </button>
          </form>

          <!-- Panel de verificación automática aprobada por Gemini -->
          <div
            id="reg-approved-box"
            hidden
            class="mt-6 rounded-xl border border-emerald-500/50 bg-emerald-950/35 p-5 text-sm space-y-2"
          >
            <h2 data-i18n="approvedTitle" class="font-serif text-lg font-bold text-emerald-300">
              {defaultCopy.approvedTitle}
            </h2>
            <p data-i18n="approvedText" class="text-slate-200 leading-relaxed">
              {defaultCopy.approvedText}
            </p>
          </div>

          <!-- Panel de confirmación en revisión manual (ticket dudoso o sin API Key) -->
          <div
            id="reg-success-box"
            hidden
            class="mt-6 rounded-xl border border-emerald-500/40 bg-emerald-950/30 p-5 text-sm space-y-2"
          >
            <h2 data-i18n="successTitle" class="font-serif text-lg font-bold text-emerald-300">
              {defaultCopy.successTitle}
            </h2>
            <p data-i18n="successText" class="text-slate-200 leading-relaxed">
              {defaultCopy.successText}
            </p>
          </div>

          <!-- Panel de aviso ante pedido o imagen ya registrados previamente -->
          <div
            id="reg-duplicate-box"
            hidden
            class="mt-6 rounded-xl border border-amber-500/50 bg-amber-950/30 p-5 text-sm space-y-2"
          >
            <h2 data-i18n="duplicateTitle" class="font-serif text-lg font-bold text-amber-300">
              {defaultCopy.duplicateTitle}
            </h2>
            <p data-i18n="duplicateText" class="text-slate-200 leading-relaxed">
              {defaultCopy.duplicateText}
            </p>
          </div>

          <!-- Panel fallback por correo si el webhook falla o no está configurado -->
          <div
            id="reg-fallback-box"
            hidden
            class="mt-6 rounded-xl border border-copper/40 bg-copper/10 p-5 text-sm space-y-3"
          >
            <h2 data-i18n="fallbackTitle" class="font-serif text-lg font-bold text-copper-light">
              {defaultCopy.fallbackTitle}
            </h2>
            <p data-i18n="fallbackText" class="text-slate-200 leading-relaxed">
              {defaultCopy.fallbackText}
            </p>
            <a
              id="reg-mailto-link"
              href="mailto:orders@javisaez.com"
              data-i18n="fallbackBtn"
              class="inline-flex items-center justify-center rounded-xl bg-gradient-copper px-4 py-2.5 text-xs font-bold text-dark-950"
            >
              {defaultCopy.fallbackBtn}
            </a>
          </div>
        </div>
      </div>
    </main>

    <script id="registro-i18n-data" type="application/json" set:html={JSON.stringify(registroI18n)} />

    <style>
      .error-msg {
        display: none;
      }

      input:user-invalid,
      select:user-invalid {
        border-color: #ef4444;
      }

      input:user-invalid + .error-msg,
      .field:has(input:user-invalid) .error-msg {
        display: block;
      }

      input:user-valid {
        border-color: rgba(16, 185, 129, 0.55);
      }
    </style>

    <script>
      interface CompressedReceipt {
        blob: Blob;
        fileName: string;
        mimeType: string;
        sizeKb: number;
      }

      /**
       * Comprime la captura/foto del recibo en navegador (máx 1400 px JPEG) para asegurar
       * envíos binarios rápidos desde móvil y mínimo consumo de CPU en servidor.
       */
      async function compressReceiptImage(file: File): Promise<CompressedReceipt> {
        if (!file.type.startsWith('image/')) {
          throw new Error('Unsupported file type: image required');
        }

        const safeName = (file.name || 'recibo.jpg').replace(/\.[^.]+$/, '') + '.jpg';

        const readAsDataUrl = (f: File): Promise<string> =>
          new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result || ''));
            reader.onerror = () => reject(new Error('File read error'));
            reader.readAsDataURL(f);
          });

        try {
          let bitmap: ImageBitmap | null = null;
          let imgEl: HTMLImageElement | null = null;
          let width = 0;
          let height = 0;

          if (typeof createImageBitmap === 'function') {
            bitmap = await createImageBitmap(file);
            width = bitmap.width;
            height = bitmap.height;
          } else {
            const rawUrl = await readAsDataUrl(file);
            imgEl = await new Promise<HTMLImageElement>((resolve, reject) => {
              const img = new Image();
              img.onload = () => resolve(img);
              img.onerror = () => reject(new Error('Image decode failed'));
              img.src = rawUrl;
            });
            width = imgEl.naturalWidth || imgEl.width;
            height = imgEl.naturalHeight || imgEl.height;
          }

          const maxEdge = 1400;
          const scale = Math.min(1, maxEdge / Math.max(width, height, 1));
          const targetW = Math.max(1, Math.round(width * scale));
          const targetH = Math.max(1, Math.round(height * scale));

          const canvas = document.createElement('canvas');
          canvas.width = targetW;
          canvas.height = targetH;
          const ctx = canvas.getContext('2d');
          if (!ctx) throw new Error('Canvas 2D context unavailable');

          if (bitmap) {
            ctx.drawImage(bitmap, 0, 0, targetW, targetH);
            bitmap.close();
          } else if (imgEl) {
            ctx.drawImage(imgEl, 0, 0, targetW, targetH);
          }

          const blob = await new Promise<Blob>((resolve, reject) => {
            canvas.toBlob(
              (result) => (result ? resolve(result) : reject(new Error('Canvas toBlob failed'))),
              'image/jpeg',
              0.78
            );
          });

          const sizeKb = Math.max(1, Math.round(blob.size / 1024));
          if (sizeKb > 4096) {
            throw new Error('Compressed image exceeds 4 MB limit');
          }

          return {
            blob,
            fileName: safeName,
            mimeType: 'image/jpeg',
            sizeKb,
          };
        } catch (compressionErr) {
          console.warn('[Registro] Compresión en canvas no disponible, usando archivo directo:', compressionErr);
          if (file.size > 4 * 1024 * 1024) {
            throw compressionErr;
          }
          return {
            blob: file,
            fileName: file.name || 'recibo.jpg',
            mimeType: file.type || 'image/jpeg',
            sizeKb: Math.max(1, Math.round(file.size / 1024)),
          };
        }
      }

      function initRegistroPage() {
        try {
          const dataEl = document.getElementById('registro-i18n-data');
          if (!dataEl?.textContent) return;
          const dict = JSON.parse(dataEl.textContent) as Record<string, any>;

          const langBtns = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');
          const channelSelect = document.getElementById('reg-channel') as HTMLSelectElement | null;
          const receiptInput = document.getElementById('reg-receipt') as HTMLInputElement | null;
          const receiptStatus = document.getElementById('reg-receipt-status');
          const form = document.getElementById('registro-form') as HTMLFormElement | null;
          const submitBtn = document.getElementById('reg-submit-btn') as HTMLButtonElement | null;
          const approvedBox = document.getElementById('reg-approved-box');
          const successBox = document.getElementById('reg-success-box');
          const duplicateBox = document.getElementById('reg-duplicate-box');
          const fallbackBox = document.getElementById('reg-fallback-box');
          const mailtoLink = document.getElementById('reg-mailto-link') as HTMLAnchorElement | null;
          const backLink = document.querySelector<HTMLAnchorElement>('[data-back-link]');

          // Live region accesible para anunciar errores de campo al perder foco
          const announcer = document.createElement('div');
          announcer.setAttribute('aria-live', 'polite');
          announcer.className = 'sr-only';
          document.body.appendChild(announcer);

          let currentLang = 'es';
          let cachedReceipt: CompressedReceipt | null = null;

          const applyLang = (lang: string) => {
            const safeLang = dict[lang] ? lang : 'es';
            currentLang = safeLang;
            const copy = dict[safeLang];
            document.documentElement.lang = safeLang;

            if (backLink) {
              const methodRoutes: Record<string, string> = {
                es: '/es/metodos/flexibilidad',
                en: '/en/methods/flexibility',
                de: '/de/methoden/flexibilitaet',
                it: '/it/metodi/flessibilita',
              };
              backLink.href = methodRoutes[safeLang] || methodRoutes.es;
            }

            document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
              const key = el.dataset.i18n;
              if (key && typeof copy[key] === 'string') {
                el.textContent = copy[key];
              }
            });

            if (channelSelect && Array.isArray(copy.channelOptions)) {
              const prevVal = channelSelect.value;
              channelSelect.innerHTML = '';
              copy.channelOptions.forEach((opt: { value: string; label: string }) => {
                const optionEl = document.createElement('option');
                optionEl.value = opt.value;
                optionEl.textContent = opt.label;
                channelSelect.appendChild(optionEl);
              });
              if (prevVal) channelSelect.value = prevVal;
            }

            langBtns.forEach((btn) => {
              const active = btn.dataset.langBtn === safeLang;
              btn.setAttribute('aria-pressed', String(active));
              btn.classList.toggle('bg-copper', active);
              btn.classList.toggle('text-dark-950', active);
              btn.classList.toggle('font-bold', active);
              btn.classList.toggle('text-slate-300', !active);
            });
          };

          const params = new URLSearchParams(window.location.search);
          const urlLang = params.get('lang') || '';
          const browserLang = (navigator.language || 'es').slice(0, 2).toLowerCase();
          applyLang(dict[urlLang] ? urlLang : dict[browserLang] ? browserLang : 'es');

          langBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
              const nextLang = btn.dataset.langBtn || 'es';
              applyLang(nextLang);
              const nextUrl = new URL(window.location.href);
              nextUrl.searchParams.set('lang', nextLang);
              window.history.replaceState({}, '', nextUrl.toString());
            });
          });

          // Pre-compresión inmediata al elegir captura de recibo
          receiptInput?.addEventListener('change', async () => {
            cachedReceipt = null;
            const file = receiptInput.files?.[0];
            if (!file) {
              receiptStatus?.setAttribute('hidden', '');
              return;
            }
            try {
              const compressed = await compressReceiptImage(file);
              cachedReceipt = compressed;
              if (receiptStatus) {
                const readyLabel = dict[currentLang]?.receiptReady || 'Captura lista';
                receiptStatus.textContent = `✓ ${readyLabel} (${compressed.sizeKb} KB)`;
                receiptStatus.removeAttribute('hidden');
              }
            } catch (err) {
              console.error('[Registro] Imagen inválida:', err);
              receiptInput.value = '';
              receiptStatus?.setAttribute('hidden', '');
              syncFieldAria(receiptInput);
            }
          });

          // Sincronización ARIA con :user-invalid
          const syncFieldAria = (field: HTMLInputElement | HTMLSelectElement) => {
            const invalid = field.matches(':user-invalid');
            field.setAttribute('aria-invalid', String(invalid));
            const errorId = field.dataset.error;
            if (!errorId) return;

            const described = (field.getAttribute('aria-describedby') || '')
              .split(/\s+/)
              .filter((id) => id && id !== errorId);
            if (invalid) {
              described.push(errorId);
              const errorText = document.getElementById(errorId)?.textContent?.trim();
              if (errorText) announcer.textContent = errorText;
            }
            if (described.length) {
              field.setAttribute('aria-describedby', described.join(' '));
            } else {
              field.removeAttribute('aria-describedby');
            }
          };

          form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => {
            field.addEventListener('blur', () => syncFieldAria(field));
            field.addEventListener('input', () => {
              if (field.getAttribute('aria-invalid') === 'true') {
                syncFieldAria(field);
              }
            });
          });

          form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            try {
              const formData = new FormData(form);
              const file = receiptInput?.files?.[0];
              if (!file) {
                if (receiptInput) syncFieldAria(receiptInput);
                return;
              }

              if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = dict[currentLang]?.sendingBtn || 'Analizando...';
              }

              const receiptData = cachedReceipt || (await compressReceiptImage(file));
              const buyerName = String(formData.get('name') || '');
              const buyerEmail = String(formData.get('email') || '');
              const buyerChannel = String(formData.get('channel') || 'amazon-kdp');
              const buyerOrderId = String(formData.get('orderId') || '');
              const buyerNotes = String(formData.get('notes') || '');

              const submitData = new FormData();
              submitData.set('name', buyerName);
              submitData.set('email', buyerEmail);
              submitData.set('channel', buyerChannel);
              submitData.set('orderId', buyerOrderId);
              submitData.set('notes', buyerNotes);
              submitData.set('website', String(formData.get('website') || ''));
              submitData.set('lang', currentLang);
              submitData.set('receipt', receiptData.blob, receiptData.fileName);

              // Preparar siempre el enlace mailto de respaldo
              const subject = encodeURIComponent(
                `[Registro Vol. 1] ${buyerOrderId} - ${buyerName}`
              );
              const body = encodeURIComponent(
                `Nombre: ${buyerName}\nEmail: ${buyerEmail}\nEdición: ${buyerChannel}\nPedido Amazon: ${buyerOrderId}\nIdioma: ${currentLang}\nNotas: ${buyerNotes}\n\n(Adjunta aquí la captura del recibo)`
              );
              if (mailtoLink) {
                mailtoLink.href = `mailto:orders@javisaez.com?subject=${subject}&body=${body}`;
              }

              const apiUrl = form.dataset.apiUrl || '/api/register';
              const res = await fetch(apiUrl, {
                method: 'POST',
                body: submitData,
              });

              if (!res.ok) {
                throw new Error(`HTTP ${res.status}`);
              }

              const result = (await res.json().catch(() => null)) as { ok?: boolean; verdict?: string; error?: string } | null;
              if (result && result.ok === false) {
                throw new Error(result.error || 'Registration error');
              }

              form.setAttribute('hidden', '');
              const verdict = result?.verdict || 'DUDOSO';
              if (verdict === 'APROBADO') {
                approvedBox?.removeAttribute('hidden');
              } else if (verdict === 'DUPLICADO') {
                duplicateBox?.removeAttribute('hidden');
              } else {
                successBox?.removeAttribute('hidden');
              }
            } catch (err) {
              console.error('[Registro] Error enviando solicitud:', err);
              fallbackBox?.removeAttribute('hidden');
            } finally {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = dict[currentLang]?.submitBtn || 'Validar ejemplar';
              }
            }
          });
        } catch (err) {
          console.error('[Registro] Fallo al inicializar página de registro:', err);
        }
      }

      initRegistroPage();
    </script>
  </body>
</html>
