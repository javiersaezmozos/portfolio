---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import FeaturedMethodSection from '../../components/FeaturedMethodSection.astro';
import enData from '../../data/en.json';
---

<Layout
  meta={enData.meta}
  nav={enData.nav}
  footer={enData.footer}
  currentLocale="en"
>
  <Hero
    hero={enData.hero}
    presentation={enData.presentation}
    currentLocale="en"
  />

  <FeaturedMethodSection currentLocale="en" />
</Layout>
