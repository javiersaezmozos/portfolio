---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  meta: {
    title: string;
    description: string;
    ogImage?: string;
    locale: string;
  };
  nav: any;
  footer: any;
  currentLocale: 'es' | 'en';
}

const { meta, nav, footer, currentLocale } = Astro.props;
const otherLocale = currentLocale === 'es' ? 'en' : 'es';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://javi-trombone.github.io').href;
const altUrl = new URL(`/${otherLocale}`, Astro.site || 'https://javi-trombone.github.io').href;

// Schema.org Person metadata
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Javier Sáez",
  "jobTitle": currentLocale === 'es' ? "Trombonista y Pedagogo Musical" : "Trombonist and Music Pedagogue",
  "url": "https://javi-trombone.github.io",
  "sameAs": [
    "https://instagram.com/javi_trombone",
    "https://youtube.com/@javi_trombone"
  ],
  "knowsAbout": [
    "Trombone Performance",
    "Euphonium",
    "Tuba",
    "Music Pedagogy",
    "Instrumental Teaching",
    "Symphonic Music"
  ],
  "alumniOf": [
    {
      "@type": "EducationalOrganization",
      "name": "Real Conservatorio Superior de Música de Madrid (RCSMM)"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Universidad Complutense de Madrid (UCM)"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Universidad Internacional de La Rioja (UNIR)"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Universidad Alfonso X el Sabio (UAX)"
    }
  ]
};
---

<!doctype html>
<html lang={currentLocale} class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={otherLocale} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href="https://javi-trombone.github.io/es" />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={meta.ogImage || "/images/javier-saez.jpg"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={currentLocale === 'es' ? 'es_ES' : 'en_US'} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage || "/images/javier-saez.jpg"} />

    <!-- Google Fonts: Inter & Cinzel for classical elegance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23d4af37'><circle cx='6' cy='18' r='3'/><circle cx='18' cy='16' r='3'/><path d='M9 18V5l12-2v13'/></svg>" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body class="bg-dark-950 text-slate-100 font-sans antialiased selection:bg-gold-500/30 selection:text-gold-200 min-h-screen flex flex-col relative overflow-x-hidden">
    <!-- Atmospheric background lighting effects -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-radial from-amber-500/10 via-gold-500/5 to-transparent blur-3xl rounded-full"></div>
      <div class="absolute top-[30%] -left-60 w-[600px] h-[600px] bg-gradient-radial from-brass/5 to-transparent blur-3xl rounded-full"></div>
      <div class="absolute top-[60%] -right-60 w-[600px] h-[600px] bg-gradient-radial from-amber-600/5 to-transparent blur-3xl rounded-full"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f293710_1px,transparent_1px),linear-gradient(to_bottom,#1f293710_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
    </div>

    <!-- Header Navigation -->
    <Header nav={nav} currentLocale={currentLocale} />

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <Footer footer={footer} nav={nav} currentLocale={currentLocale} />
  </body>
</html>

<style is:global>
  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .text-gradient-gold {
    background: linear-gradient(135deg, #fff2cc 0%, #d4af37 40%, #aa820a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .border-gradient-gold {
    border-image: linear-gradient(to bottom right, #d4af37, #aa820a, #34455c) 1;
  }

  .font-serif {
    font-family: 'Cinzel', 'Playfair Display', Georgia, serif;
  }
</style>
